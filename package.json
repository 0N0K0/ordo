{
  "name": "ordo",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "dev": "concurrently -n api,web -c blue,green \"npm run dev -w apps/api\" \"npm run dev -w apps/web\"",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "codegen": "npm run schema:print -w apps/api && npm run codegen -w apps/web",
    "user:create": "npm run user:create -w apps/api"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/0N0K0/ordo.git"
  },
  "keywords": [],
  "author": "Noémie Koelblen @Onoko",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/0N0K0/ordo/issues"
  },
  "homepage": "https://github.com/0N0K0/ordo#readme",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "devDependencies": {
    "concurrently": "^10.0.6",
    "eslint": "^10.14.0",
    "prettier": "^3.9.10",
    "typescript": "~6.0.0"
  }
}
