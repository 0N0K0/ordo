generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

generator pothos {
  provider     = "prisma-pothos-types"
  clientOutput = "./prisma"
  output       = "../src/generated/pothos-types.ts"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String       @id @default(cuid())
  /// Lowercase, unique login name.
  username      String       @unique
  /// Lowercase, unique email address.
  email         String       @unique
  /// New email address awaiting confirmation.
  pendingEmail  String?
  passwordHash  String
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  sessions      Session[]
  authTokens    AuthToken[]
  /// Contributor profile of the user: tasks can be assigned to them like to anyone else.
  contributorId String?      @unique
  contributor   Contributor? @relation(fields: [contributorId], references: [id], onDelete: SetNull)
}

model Session {
  id         String   @id @default(cuid())
  /// SHA-256 of the token stored in the session cookie.
  tokenHash  String   @unique
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userAgent  String?
  createdAt  DateTime @default(now())
  lastSeenAt DateTime @default(now())
  expiresAt  DateTime

  @@index([userId])
}

enum AuthTokenType {
  PASSWORD_RESET
  EMAIL_CHANGE
}

/// Single-use token sent by email.
model AuthToken {
  id        String        @id @default(cuid())
  /// SHA-256 of the token sent in the link.
  tokenHash String        @unique
  type      AuthTokenType
  userId    String
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Target address for an EMAIL_CHANGE token.
  email     String?
  expiresAt DateTime
  createdAt DateTime      @default(now())

  @@index([userId, type])
}

/// Uploaded image, stored apart so lists never load the bytes.
model Icon {
  id           String        @id @default(cuid())
  mimeType     String
  data         Bytes
  createdAt    DateTime      @default(now())
  clients      Client[]
  projects     Project[]
  contributors Contributor[]
}

model Client {
  id         String    @id @default(cuid())
  name       String
  iconId     String?
  icon       Icon?     @relation(fields: [iconId], references: [id], onDelete: SetNull)
  /// Hex color, e.g. #228be6.
  color      String?
  /// Manual order among clients.
  position   Int       @default(0)
  favorite   Boolean   @default(false)
  archivedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  projects   Project[]

  /// Professional (company, association…) or individual.
  kind         ClientKind           @default(COMPANY)
  /// Individual: first and last name (the client name stays the displayed one).
  firstName    String?
  lastName     String?
  /// Postal address: { lines, postalCode, city, region, country (ISO 3166-1 alpha-2) }.
  address      Json?
  email        String?
  /// [{ label, number }]
  phones       Json                 @default("[]")
  website      String?
  vatNumber    String?
  siren        String?
  siret        String?
  /// Activity code (NAF in France, NACE in the EU, NOGA in Switzerland…).
  activityCode String?
  services     ClientService[]
  contacts     ClientContact[]
  documents    AccountingDocument[]
  imported     ImportedDocument[]
}

enum ClientKind {
  COMPANY
  INDIVIDUAL
}

/// Department or branch of a client, with its own address and contacts.
model ClientService {
  id        String               @id @default(cuid())
  clientId  String
  client    Client               @relation(fields: [clientId], references: [id], onDelete: Cascade)
  name      String
  address   Json?
  email     String?
  phones    Json                 @default("[]")
  position  Int                  @default(0)
  createdAt DateTime             @default(now())
  contacts  ClientContact[]
  documents AccountingDocument[]

  @@index([clientId])
}

/// Person at a client, possibly in one of its services.
model ClientContact {
  id        String               @id @default(cuid())
  clientId  String
  client    Client               @relation(fields: [clientId], references: [id], onDelete: Cascade)
  serviceId String?
  service   ClientService?       @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  firstName String
  lastName  String
  email     String?
  jobTitle  String?
  phones    Json                 @default("[]")
  createdAt DateTime             @default(now())
  documents AccountingDocument[]

  @@index([clientId])
}

model Project {
  id                String            @id @default(cuid())
  title             String
  /// Client of the project tree, inherited by sub-projects.
  clientId          String?
  client            Client?           @relation(fields: [clientId], references: [id], onDelete: SetNull)
  /// Parent project (null for a root project). Deleting a project deletes its sub-projects.
  parentId          String?
  parent            Project?          @relation("ProjectTree", fields: [parentId], references: [id], onDelete: Cascade)
  children          Project[]         @relation("ProjectTree")
  iconId            String?
  icon              Icon?             @relation(fields: [iconId], references: [id], onDelete: SetNull)
  description       String?
  statusId          String?
  status            ProjectStatus?    @relation(fields: [statusId], references: [id], onDelete: SetNull)
  startDate         DateTime?         @db.Date
  endDate           DateTime?         @db.Date
  /// Hex color, e.g. #228be6.
  color             String?
  /// Manual order among siblings (same parent, or same client for root projects).
  position          Int               @default(0)
  favorite          Boolean           @default(false)
  archivedAt        DateTime?
  /// Archived along with its client or a parent project: restoring that ancestor restores it.
  archivedByCascade Boolean           @default(false)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  categories        ProjectCategory[]
  tasks             Task[]

  milestones   Milestone[]
  sprints      Sprint[]
  githubLink   GithubProjectLink?
  dashboards   Dashboard[]
  taskViews    TaskView[]
  /// Contributors attached to the project (and, through it, to its sub-projects).
  contributors Contributor[]        @relation("ProjectContributors")
  timeEntries  TimeEntry[]
  alarms       Alarm[]
  mails        MailMessage[]
  events       CalendarEvent[]
  documents    AccountingDocument[]
  resources    ProjectResource[]
  imported     ImportedDocument[]
  treasury     TreasuryEntry[]

  @@index([clientId])
  @@index([parentId])
}

/// Category of projects (other kinds of categories get their own table).
model ProjectCategory {
  id        String    @id @default(cuid())
  name      String    @unique
  /// Hex color, e.g. #228be6.
  color     String
  createdAt DateTime  @default(now())
  projects  Project[]
}

/// Configurable project status (e.g. Prospect, In progress, Done).
model ProjectStatus {
  id        String    @id @default(cuid())
  name      String    @unique
  /// Hex color, e.g. #228be6.
  color     String
  /// Display order in lists and selects.
  position  Int       @default(0)
  createdAt DateTime  @default(now())
  projects  Project[]
}

/// Person who can be assigned to tasks.
model Contributor {
  id          String          @id @default(cuid())
  name        String
  /// Unique identifier used in @mentions.
  handle      String          @unique
  iconId      String?
  icon        Icon?           @relation(fields: [iconId], references: [id], onDelete: SetNull)
  createdAt   DateTime        @default(now())
  tasks       Task[]
  /// Projects the contributor is attached to; sub-projects inherit them.
  projects    Project[]       @relation("ProjectContributors")
  events      CalendarEvent[]
  /// Set when this contributor is the app user ("Moi").
  user        User?
  /// GitHub login: assignees are synchronized with the GitHub boards through it.
  githubLogin String?         @unique
}

/// Fixed meaning of a task status, whatever its name: drives "open", "overdue" and progress.
enum TaskStatusCategory {
  TODO
  IN_PROGRESS
  DONE
  CANCELLED
}

model TaskStatus {
  id        String             @id @default(cuid())
  name      String             @unique
  /// Hex color, e.g. #228be6.
  color     String
  category  TaskStatusCategory @default(TODO)
  position  Int                @default(0)
  createdAt DateTime           @default(now())
  tasks     Task[]
}

model TaskPriority {
  id        String   @id @default(cuid())
  name      String   @unique
  /// Hex color, e.g. #228be6.
  color     String
  position  Int      @default(0)
  createdAt DateTime @default(now())
  tasks     Task[]
}

model TaskType {
  id        String   @id @default(cuid())
  name      String   @unique
  /// Hex color, e.g. #228be6.
  color     String
  position  Int      @default(0)
  createdAt DateTime @default(now())
  tasks     Task[]
}

/// Tag of tasks (several per task), synchronized with the GitHub labels.
model TaskTag {
  id        String   @id @default(cuid())
  name      String   @unique
  /// Hex color, e.g. #228be6.
  color     String
  position  Int      @default(0)
  createdAt DateTime @default(now())
  tasks     Task[]   @relation("TaskTags")
}

model Task {
  id                String         @id @default(cuid())
  /// Human-readable number (#12), global and stable across transfers.
  number            Int            @unique @default(autoincrement())
  title             String
  /// Markdown.
  description       String?
  projectId         String
  project           Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  statusId          String?
  status            TaskStatus?    @relation(fields: [statusId], references: [id], onDelete: SetNull)
  priorityId        String?
  priority          TaskPriority?  @relation(fields: [priorityId], references: [id], onDelete: SetNull)
  typeId            String?
  type              TaskType?      @relation(fields: [typeId], references: [id], onDelete: SetNull)
  milestoneId       String?
  milestone         Milestone?     @relation(fields: [milestoneId], references: [id], onDelete: SetNull)
  /// Sprint of the project tree the task is planned in.
  sprintId          String?
  sprint            Sprint?        @relation(fields: [sprintId], references: [id], onDelete: SetNull)
  /// Item of the GitHub board the task is synchronized with (ProjectV2Item node id).
  githubItemId      String?        @unique
  /// Content of the item: issue or draft issue node id.
  githubContentId   String?
  /// ISSUE or DRAFT_ISSUE.
  githubContentType String?
  githubUrl         String?
  githubNumber      Int?
  /// Synchronized values at the last sync, for the three-way merge.
  githubSnapshot    Json?
  effort            Float?
  startDate         DateTime?      @db.Date
  endDate           DateTime?      @db.Date
  /// Parent task, possibly in another project of the same tree.
  parentId          String?
  parent            Task?          @relation("TaskTree", fields: [parentId], references: [id], onDelete: SetNull)
  children          Task[]         @relation("TaskTree")
  /// Global manual order.
  position          Int            @default(0)
  /// Closed (done) task: it no longer blocks, is never overdue and counts as done. Independent of the status.
  closedAt          DateTime?
  archivedAt        DateTime?
  /// Archived along with its parent task: restoring the parent restores it.
  archivedByCascade Boolean        @default(false)
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  assignees         Contributor[]
  tags              TaskTag[]      @relation("TaskTags")
  /// Tasks this task blocks.
  blocking          TaskBlock[]    @relation("Blocker")
  /// Tasks blocking this task.
  blockedBy         TaskBlock[]    @relation("Blocked")
  /// Symmetric relations, stored once with taskAId < taskBId.
  relationsA        TaskRelation[] @relation("RelationA")
  relationsB        TaskRelation[] @relation("RelationB")
  comments          TaskComment[]
  timeEntries       TimeEntry[]
  alarms            Alarm[]
  /// Repetition of a recurring task (set on the first task of the series).
  recurrence        Json?
  /// First task of the series this task is an occurrence of.
  seriesId          String?
  series            Task?          @relation("TaskSeries", fields: [seriesId], references: [id], onDelete: SetNull)
  occurrences       Task[]         @relation("TaskSeries")
  /// Date of the occurrence in its series (the first task: its own date).
  occurrenceDate    DateTime?      @db.Date

  @@index([projectId])
  @@index([parentId])
  @@index([milestoneId])
  @@index([sprintId])
  @@index([closedAt])
  @@index([seriesId])
}

/// "blocker blocks blocked".
model TaskBlock {
  blockerId String
  blocker   Task   @relation("Blocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blockedId String
  blocked   Task   @relation("Blocked", fields: [blockedId], references: [id], onDelete: Cascade)

  @@id([blockerId, blockedId])
  @@index([blockedId])
}

/// "related to", symmetric.
model TaskRelation {
  taskAId String
  taskA   Task   @relation("RelationA", fields: [taskAId], references: [id], onDelete: Cascade)
  taskBId String
  taskB   Task   @relation("RelationB", fields: [taskBId], references: [id], onDelete: Cascade)

  @@id([taskAId, taskBId])
  @@index([taskBId])
}

model TaskComment {
  id              String   @id @default(cuid())
  taskId          String
  task            Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  /// Markdown.
  body            String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  /// Comment of the GitHub issue it is synchronized with.
  githubCommentId String?  @unique
  /// Body at the last sync, for the three-way merge.
  githubBody      String?
  /// Author on GitHub, when someone else than the connected account wrote it there.
  githubAuthor    String?

  @@index([taskId])
}

/// Saved task table view: filters, sorting, columns and grouping (JSON validated by @ordo/shared).
model TaskView {
  id        String   @id @default(cuid())
  name      String
  config    Json
  /// Project whose task tab shows the view; null for the home page.
  projectId String?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)
  /// Opened first in its project (or on the home page); at most one per scope.
  isDefault Boolean  @default(false)
  position  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Project milestone, usable by the tasks of the project and its sub-projects.
model Milestone {
  id          String    @id @default(cuid())
  projectId   String
  project     Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title       String
  /// Markdown.
  description String?
  dueDate     DateTime? @db.Date
  position    Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  tasks       Task[]

  @@index([projectId])
}

/// Sprint of a project: a period the tasks of its project tree are planned in.
model Sprint {
  id                String   @id @default(cuid())
  projectId         String
  project           Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name              String
  /// Markdown.
  goal              String?
  startDate         DateTime @db.Date
  endDate           DateTime @db.Date
  /// Iteration of a GitHub board the sprint mirrors.
  githubIterationId String?  @unique
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  tasks             Task[]

  @@index([projectId])
}

/// GitHub access of the app: a personal access token (encrypted), single row.
model GithubConnection {
  id        String   @id @default("github")
  token     String
  login     String
  updatedAt DateTime @updatedAt
}

/// Project synchronized with a GitHub Projects (v2) board, both ways.
model GithubProjectLink {
  id               String    @id @default(cuid())
  projectId        String    @unique
  project          Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  /// Node id, URL and title of the board.
  githubProjectId  String
  url              String
  title            String
  /// Fields of the board synchronized (null: not synchronized).
  statusFieldId    String?
  priorityFieldId  String?
  iterationFieldId String?
  startFieldId     String?
  endFieldId       String?
  effortFieldId    String?
  /// Option of the board for each Ordo status / priority: { [ordoId]: optionId }.
  statusOptions    Json      @default("{}")
  priorityOptions  Json      @default("{}")
  /// New Ordo tasks become issues of this repository, or draft issues without one.
  repositoryId     String?
  repositoryName   String?
  /// Ordo tasks created before the link are sent too.
  pushExisting     Boolean   @default(false)
  enabled          Boolean   @default(true)
  lastSyncAt       DateTime?
  lastSyncError    String?
  /// Counts of the last sync (created, updated… on each side).
  lastSyncSummary  Json?
  createdAt        DateTime  @default(now())
}

/// Dashboard of charts on the tasks: global (no project) or of a project tree.
model Dashboard {
  id        String           @id @default(cuid())
  projectId String?
  project   Project?         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name      String
  position  Int              @default(0)
  createdAt DateTime         @default(now())
  charts    DashboardChart[]

  @@index([projectId])
}

/// Chart of a dashboard: type, axes, measure, series and filters (JSON, validated by the shared schema).
model DashboardChart {
  id          String    @id @default(cuid())
  dashboardId String
  dashboard   Dashboard @relation(fields: [dashboardId], references: [id], onDelete: Cascade)
  title       String
  config      Json
  /// Width in the dashboard grid: half or full.
  wide        Boolean   @default(false)
  position    Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([dashboardId])
}

/// File attached to a markdown text (description, comment…) and linked from it.
model Attachment {
  id                   String              @id @default(cuid())
  /// Original file name, used for the download.
  name                 String
  mimeType             String
  size                 Int
  data                 Bytes
  createdAt            DateTime            @default(now())
  /// Set for a file of a mail copied into a project.
  mailMessageId        String?
  mailMessage          MailMessage?        @relation(fields: [mailMessageId], references: [id], onDelete: Cascade)
  /// Content-ID of an inline image of that mail.
  contentId            String?
  /// Set for a file of a project.
  projectResource      ProjectResource?
  /// Set for the file of an imported document.
  importedDocument     ImportedDocument?
  /// Set for a file attached to an accounting document.
  accountingDocumentId String?
  accountingDocument   AccountingDocument? @relation("DocumentAttachments", fields: [accountingDocumentId], references: [id], onDelete: Cascade)
  /// Set for the signed copy of a quote.
  signedQuote          AccountingDocument? @relation("SignedQuote")

  @@index([mailMessageId])
}

/// Tracked time on a project, optionally spent on tasks (shared equally between them).
model TimeEntry {
  id            String              @id @default(cuid())
  projectId     String
  project       Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  /// What was done (plain text, several lines).
  description   String?
  startedAt     DateTime
  /// Null while the timer runs (a single entry runs at a time).
  endedAt       DateTime?
  /// Start of the current pause, while paused.
  pausedAt      DateTime?
  /// Paused time before the current pause, in seconds.
  pausedSeconds Int                 @default(0)
  /// Effective duration in seconds (pauses excluded), set once stopped.
  duration      Int?
  /// Invoice (draft or final) the time is billed on.
  documentId    String?
  document      AccountingDocument? @relation(fields: [documentId], references: [id], onDelete: SetNull)
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  tasks         Task[]

  @@index([projectId])
  @@index([startedAt])
  @@index([endedAt])
  @@index([documentId])
}

/// What triggers an alarm.
enum AlarmType {
  /// At the scheduled times.
  REMINDER
  /// At the scheduled times, only when no timer runs.
  NOT_TRACKING
  /// After every `minutes` of tracking on the running timer.
  TRACKING_DURATION
}

enum AlarmFrequency {
  ONCE
  DAILY
  WEEKLY
  MONTHLY
}

/// Alarm rung by the app while it is open. Schedules are in the user's local time.
model Alarm {
  id          String         @id @default(cuid())
  title       String
  note        String?
  type        AlarmType      @default(REMINDER)
  /// First day of the schedule (REMINDER, NOT_TRACKING).
  startDate   DateTime?      @db.Date
  /// Local time of day, HH:MM (REMINDER, NOT_TRACKING).
  time        String?
  frequency   AlarmFrequency @default(ONCE)
  /// Every n days / weeks / months.
  interval    Int            @default(1)
  /// Weekdays of a weekly schedule, 1 (Monday) to 7 (Sunday); empty: the start date's weekday.
  weekdays    Int[]
  /// Last day of the schedule, included.
  endDate     DateTime?      @db.Date
  /// Tracking time between two rings (TRACKING_DURATION).
  minutes     Int?
  projectId   String?
  project     Project?       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  taskId      String?
  task        Task?          @relation(fields: [taskId], references: [id], onDelete: Cascade)
  enabled     Boolean        @default(true)
  /// Last time it rang: occurrences up to then are done.
  lastFiredAt DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
}

/// Mailbox read over IMAP and sent from over SMTP. Passwords are encrypted (MAIL_ENCRYPTION_KEY).
model MailAccount {
  id           String             @id @default(cuid())
  /// Name shown in the app ("Pro", "Perso"…).
  name         String
  email        String
  /// Sender name.
  displayName  String?
  imapHost     String
  imapPort     Int
  imapSecure   Boolean            @default(true)
  imapUser     String
  imapPassword String
  smtpHost     String
  smtpPort     Int
  smtpSecure   Boolean            @default(true)
  smtpUser     String
  smtpPassword String
  /// Saves sent mails in the Sent folder (off for servers doing it themselves, like Gmail).
  saveSent     Boolean            @default(true)
  /// HTML signature added to new mails.
  signature    String?
  position     Int                @default(0)
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  messages     MailMessage[]
  cursors      MailFolderCursor[]
}

/// Copy of a mail linked to a project (mails are otherwise read live from the server).
model MailMessage {
  id          String       @id @default(cuid())
  projectId   String
  project     Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  accountId   String?
  account     MailAccount? @relation(fields: [accountId], references: [id], onDelete: SetNull)
  /// Message-ID header, without angle brackets.
  messageId   String
  inReplyTo   String?
  references  String[]
  subject     String
  fromName    String?
  fromAddress String
  /// [{ name, address }]
  to          Json
  cc          Json
  date        DateTime
  /// Sanitized HTML body.
  html        String?
  text        String?
  /// Sent from Ordo (rather than received).
  sent        Boolean      @default(false)
  createdAt   DateTime     @default(now())
  attachments Attachment[]

  @@unique([projectId, messageId])
  @@index([messageId])
}

/// Last mail checked in a folder, to link the new messages of conversations already linked to a project.
model MailFolderCursor {
  accountId   String
  account     MailAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  folder      String
  uidValidity BigInt
  lastUid     Int

  @@id([accountId, folder])
}

/// Category of calendar events, in a tree.
model CalendarCategory {
  id        String             @id @default(cuid())
  name      String
  color     String
  parentId  String?
  parent    CalendarCategory?  @relation("CalendarCategoryTree", fields: [parentId], references: [id], onDelete: Cascade)
  children  CalendarCategory[] @relation("CalendarCategoryTree")
  position  Int                @default(0)
  createdAt DateTime           @default(now())
  events    CalendarEvent[]

  @@index([parentId])
}

/// Calendar event, possibly recurring. Times are local to `timeZone`; all-day events have no times.
model CalendarEvent {
  id           String                   @id @default(cuid())
  title        String
  /// Markdown.
  description  String?
  location     String?
  /// [{ url, label }]
  links        Json                     @default("[]")
  allDay       Boolean                  @default(false)
  /// First day (of the first occurrence for a recurring event).
  startDate    DateTime                 @db.Date
  /// HH:MM, null for an all-day event.
  startTime    String?
  /// Last day, included.
  endDate      DateTime                 @db.Date
  endTime      String?
  /// IANA time zone of the times.
  timeZone     String
  /// Repetition (see the shared recurrence rule), null for a one-off event.
  recurrence   Json?
  /// Reminders, in minutes before the start.
  reminders    Int[]
  projectId    String?
  project      Project?                 @relation(fields: [projectId], references: [id], onDelete: SetNull)
  contributors Contributor[]
  categories   CalendarCategory[]
  exceptions   CalendarEventException[]
  createdAt    DateTime                 @default(now())
  updatedAt    DateTime                 @updatedAt

  @@index([startDate])
  @@index([projectId])
}

/// One occurrence of a recurring event changed or cancelled on its own.
model CalendarEventException {
  id          String        @id @default(cuid())
  eventId     String
  event       CalendarEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  /// Date of the occurrence in the series.
  date        DateTime      @db.Date
  cancelled   Boolean       @default(false)
  title       String?
  description String?
  location    String?
  links       Json?
  allDay      Boolean?
  startDate   DateTime?     @db.Date
  startTime   String?
  endDate     DateTime?     @db.Date
  endTime     String?

  @@unique([eventId, date])
}

/// The user's business, shown on the accounting documents (a single row).
model CompanyProfile {
  id                String   @id @default("company")
  name              String   @default("")
  /// Legal form (SASU, EURL, EI, micro-entreprise…).
  legalForm         String?
  /// Share capital, as written ("1 000 €").
  capital           String?
  /// Registration (RCS Paris 123 456 789, RM…).
  registration      String?
  siren             String?
  siret             String?
  activityCode      String?
  vatNumber         String?
  /// Off: "TVA non applicable" (franchise), no VAT on the documents.
  vatApplicable     Boolean  @default(true)
  /// Mention printed when VAT does not apply.
  vatExemptionText  String   @default("TVA non applicable, art. 293 B du CGI")
  address           Json?
  email             String?
  phone             String?
  website           String?
  logoId            String?
  bankName          String?
  accountHolder     String?
  iban              String?
  bic               String?
  /// Defaults of new documents.
  paymentTerms      String   @default("À 30 jours")
  paymentDays       Int      @default(30)
  paymentMethods    String   @default("Virement bancaire")
  lateInterest      String   @default("Trois fois le taux d’intérêt légal")
  /// Other mentions printed on every document.
  otherMentions     String   @default("Pas d’escompte pour paiement anticipé.")
  /// Label of the client's internal reference ("Référence dossier", "Bon de commande"…).
  referenceLabel    String   @default("Référence dossier")
  quoteValidityDays Int      @default(30)
  updatedAt         DateTime @updatedAt
}

enum AccountingDocumentType {
  QUOTE
  INVOICE
  DEPOSIT_INVOICE
  CREDIT_NOTE
}

/// Next number of a document type for a year (D/F/FA/A + YY + 5 digits).
model DocumentSequence {
  type       AccountingDocumentType
  year       Int
  nextNumber Int                    @default(1)

  @@id([type, year])
}

enum AccountingDocumentStatus {
  /// Editable, without number.
  DRAFT
  /// Numbered and final: it cannot be changed any more (corrected by a credit note).
  FINAL
  /// Model of a recurring invoice, never numbered.
  TEMPLATE
}

enum DiscountType {
  PERCENT
  AMOUNT
}

/// Quote, invoice, deposit invoice or credit note.
model AccountingDocument {
  id                  String                   @id @default(cuid())
  type                AccountingDocumentType
  status              AccountingDocumentStatus @default(DRAFT)
  /// Given when the document becomes final.
  year                Int?
  counter             Int?
  number              String?                  @unique
  /// Date printed on the document (it may be set in the past or the future).
  issueDate           DateTime                 @db.Date
  /// Payment due date (invoices) or end of validity (quotes).
  dueDate             DateTime?                @db.Date
  /// Date or period of the service or delivery.
  serviceStart        DateTime?                @db.Date
  serviceEnd          DateTime?                @db.Date
  clientId            String
  client              Client                   @relation(fields: [clientId], references: [id], onDelete: Restrict)
  serviceId           String?
  service             ClientService?           @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  contactId           String?
  contact             ClientContact?           @relation(fields: [contactId], references: [id], onDelete: SetNull)
  projectId           String?
  project             Project?                 @relation(fields: [projectId], references: [id], onDelete: SetNull)
  /// Quote an invoice comes from, or invoice a credit note cancels.
  sourceId            String?
  source              AccountingDocument?      @relation("DocumentSource", fields: [sourceId], references: [id], onDelete: Restrict)
  derived             AccountingDocument[]     @relation("DocumentSource")
  /// Seller and buyer as printed, frozen when the document becomes final.
  seller              Json?
  buyer               Json?
  title               String?
  introduction        String?
  referenceLabel      String?
  referenceValue      String?
  conclusion          String?
  paymentTerms        String?
  paymentMethods      String?
  /// Quotes: deposit asked at order, percent of the total or amount.
  depositType         DiscountType?
  depositValue        Decimal?                 @db.Decimal(14, 2)
  lateInterest        String?
  /// Quotes: how the work will be invoiced ("Au mois, en fin de mois", "Tous les 5 du mois"…).
  billingSchedule     String?
  otherMentions       String?
  showBankDetails     Boolean                  @default(true)
  vatApplicable       Boolean                  @default(true)
  vatExemptionText    String?
  globalDiscountType  DiscountType?
  globalDiscountValue Decimal?                 @db.Decimal(14, 2)
  currency            String                   @default("EUR")
  /// Totals, computed on each save.
  totalNet            Decimal                  @default(0) @db.Decimal(14, 2)
  totalVat            Decimal                  @default(0) @db.Decimal(14, 2)
  totalGross          Decimal                  @default(0) @db.Decimal(14, 2)
  finalizedAt         DateTime?
  createdAt           DateTime                 @default(now())
  updatedAt           DateTime                 @updatedAt
  lines               AccountingLine[]
  attachments         Attachment[]             @relation("DocumentAttachments")
  /// Tracking (configurable status, sending, acceptance, payments, reminders); final documents only.
  trackingStatusId    String?
  trackingStatus      DocumentStatus?          @relation(fields: [trackingStatusId], references: [id], onDelete: SetNull)
  /// Last time it was sent to the client (by mail from Ordo, or marked by hand).
  sentAt              DateTime?
  /// Quotes: date of acceptance, and signed copy.
  acceptedAt          DateTime?                @db.Date
  signedAttachmentId  String?                  @unique
  signedAttachment    Attachment?              @relation("SignedQuote", fields: [signedAttachmentId], references: [id], onDelete: SetNull)
  allocations         TreasuryAllocation[]
  reminders           DocumentReminder[]
  /// Tracked time billed on it.
  timeEntries         TimeEntry[]
  /// Recurring invoice this document is the model of, or was created by.
  recurring           RecurringInvoice?        @relation("RecurringTemplate")
  recurringId         String?
  generatedBy         RecurringInvoice?        @relation("RecurringGenerated", fields: [recurringId], references: [id], onDelete: SetNull)

  @@index([clientId])
  @@index([projectId])
  @@index([sourceId])
  @@index([type, year])
}

enum AccountingLineKind {
  /// Product or service.
  ITEM
  /// Expense paid on behalf of the client, re-invoiced without VAT or margin.
  DISBURSEMENT
  /// Free text (section title, note).
  TEXT
  /// Amount already invoiced on the same quote, deducted.
  DEDUCTION
}

enum AccountingUnit {
  UNIT
  HOUR
  DAY
  MONTH
  FLAT
  DEPOSIT
}

model AccountingLine {
  id            String             @id @default(cuid())
  documentId    String
  document      AccountingDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  position      Int
  kind          AccountingLineKind @default(ITEM)
  title         String
  /// Markdown.
  description   String?
  quantity      Decimal            @default(1) @db.Decimal(14, 3)
  unit          AccountingUnit     @default(UNIT)
  unitPrice     Decimal            @default(0) @db.Decimal(14, 2)
  /// Percent (20, 10, 5.5…).
  vatRate       Decimal            @default(0) @db.Decimal(5, 2)
  discountType  DiscountType?
  discountValue Decimal?           @db.Decimal(14, 2)

  @@index([documentId])
}

/// Invoice issued on a schedule from a model document.
model RecurringInvoice {
  id           String               @id @default(cuid())
  name         String
  templateId   String               @unique
  template     AccountingDocument   @relation("RecurringTemplate", fields: [templateId], references: [id], onDelete: Cascade)
  /// Repetition (shared recurrence rule), from `startDate`.
  recurrence   Json
  startDate    DateTime             @db.Date
  /// Next issue date, null when the schedule is over.
  nextDate     DateTime?            @db.Date
  /// Final invoices (numbered at once) rather than drafts to check.
  autoFinalize Boolean              @default(false)
  active       Boolean              @default(true)
  createdAt    DateTime             @default(now())
  generated    AccountingDocument[] @relation("RecurringGenerated")
}

/// Product or service of the catalogue: default title, description, unit, price and VAT of a line.
model CatalogItem {
  id          String             @id @default(cuid())
  /// Item or disbursement.
  kind        AccountingLineKind @default(ITEM)
  title       String
  /// Markdown.
  description String?
  unit        AccountingUnit     @default(UNIT)
  unitPrice   Decimal            @default(0) @db.Decimal(14, 2)
  /// Percent (20, 10, 5.5…).
  vatRate     Decimal            @default(20) @db.Decimal(5, 2)
  /// Archived: kept on past documents, not offered any more.
  archived    Boolean            @default(false)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
}

enum ProjectResourceKind {
  FILE
  LINK
}

/// File or link of a project (mock-ups, repository, specifications…).
model ProjectResource {
  id           String              @id @default(cuid())
  projectId    String
  project      Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  kind         ProjectResourceKind
  title        String
  url          String?
  attachmentId String?             @unique
  attachment   Attachment?         @relation(fields: [attachmentId], references: [id], onDelete: Cascade)
  note         String?
  position     Int                 @default(0)
  createdAt    DateTime            @default(now())

  @@index([projectId])
}

/// Quote or invoice issued before Ordo (or elsewhere): its main information and its PDF, not its lines.
model ImportedDocument {
  id           String                 @id @default(cuid())
  type         AccountingDocumentType
  /// Number as issued.
  number       String
  issueDate    DateTime               @db.Date
  dueDate      DateTime?              @db.Date
  clientId     String?
  client       Client?                @relation(fields: [clientId], references: [id], onDelete: SetNull)
  /// Client name when it is not (or no longer) a client in Ordo.
  clientName   String?
  projectId    String?
  project      Project?               @relation(fields: [projectId], references: [id], onDelete: SetNull)
  title        String?
  totalNet     Decimal                @db.Decimal(14, 2)
  totalVat     Decimal                @default(0) @db.Decimal(14, 2)
  totalGross   Decimal                @db.Decimal(14, 2)
  currency     String                 @default("EUR")
  attachmentId String?                @unique
  attachment   Attachment?            @relation(fields: [attachmentId], references: [id], onDelete: SetNull)
  note         String?
  /// Paid (or refunded) outside the treasury of Ordo: not expected any more.
  settled      Boolean                @default(true)
  createdAt    DateTime               @default(now())
  allocations  TreasuryAllocation[]

  @@unique([type, number])
  @@index([clientId])
  @@index([projectId])
}

/// Which documents a tracking status applies to.
enum DocumentStatusScope {
  QUOTE
  /// Invoices, deposit invoices and credit notes.
  INVOICE
}

/// Meaning of a tracking status, whatever its name: it drives the automatic changes.
enum DocumentStatusCategory {
  /// Final, not sent yet.
  TO_SEND
  /// Sent, waiting for an answer or a payment.
  SENT
  ACCEPTED
  REFUSED
  /// Paid (invoices), refunded or deducted (credit notes).
  PAID
}

/// Configurable tracking status of the final documents ("Envoyé", "En négociation", "Payée"…).
model DocumentStatus {
  id        String                 @id @default(cuid())
  scope     DocumentStatusScope
  name      String
  /// Hex color, e.g. #228be6.
  color     String
  category  DocumentStatusCategory
  position  Int                    @default(0)
  createdAt DateTime               @default(now())
  documents AccountingDocument[]

  @@unique([scope, name])
}

/// Reminder of an unpaid invoice (mail sent from Ordo, call…).
model DocumentReminder {
  id         String             @id @default(cuid())
  documentId String
  document   AccountingDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  date       DateTime           @default(now())
  /// "Mail", "Téléphone"… with an optional note.
  note       String?
  createdAt  DateTime           @default(now())

  @@index([documentId])
}

/// Bank account (or cash box) of the treasury.
model TreasuryAccount {
  id             String          @id @default(cuid())
  name           String
  /// Balance at the opening date (entries before it are not counted).
  openingBalance Decimal         @default(0) @db.Decimal(14, 2)
  openingDate    DateTime        @db.Date
  position       Int             @default(0)
  archived       Boolean         @default(false)
  createdAt      DateTime        @default(now())
  entries        TreasuryEntry[]
}

enum TreasuryEntryStatus {
  /// On the bank statement.
  ACTUAL
  /// Expected (possibly repeated).
  FORECAST
}

/// Money in (positive) or out (negative) of an account, actual or expected.
model TreasuryEntry {
  id          String               @id @default(cuid())
  accountId   String
  account     TreasuryAccount      @relation(fields: [accountId], references: [id], onDelete: Restrict)
  status      TreasuryEntryStatus  @default(ACTUAL)
  date        DateTime             @db.Date
  label       String
  /// Signed amount: positive for money in.
  amount      Decimal              @db.Decimal(14, 2)
  category    String?
  /// Transfer, card, cheque…
  method      String?
  projectId   String?
  project     Project?             @relation(fields: [projectId], references: [id], onDelete: SetNull)
  note        String?
  /// Forecast only: repetition from `date` (shared recurrence rule); realized dates become exceptions.
  recurrence  Json?
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
  allocations TreasuryAllocation[]

  @@index([accountId, date])
  @@index([status, date])
}

/// Part of an actual entry settling a document: payment of an invoice, refund of a credit note.
model TreasuryAllocation {
  id                 String              @id @default(cuid())
  entryId            String
  entry              TreasuryEntry       @relation(fields: [entryId], references: [id], onDelete: Cascade)
  documentId         String?
  document           AccountingDocument? @relation(fields: [documentId], references: [id], onDelete: Restrict)
  importedDocumentId String?
  importedDocument   ImportedDocument?   @relation(fields: [importedDocumentId], references: [id], onDelete: Cascade)
  /// Positive amount settled on the document.
  amount             Decimal             @db.Decimal(14, 2)

  @@index([entryId])
  @@index([documentId])
  @@index([importedDocumentId])
}
