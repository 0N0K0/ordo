generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

generator pothos {
  provider     = "prisma-pothos-types"
  clientOutput = "./prisma"
  output       = "../src/generated/pothos-types.ts"
}

datasource db {
  provider = "postgresql"
}

/// Separate space of the app (professional or personal): every row but the accounts belongs to one.
model Workspace {
  id                        String                     @id @default(cuid())
  label                     String
  kind                      WorkspaceKind              @default(PRO)
  /// Order in the switcher.
  position                  Int                        @default(0)
  /// Notifications this workspace still gives while another one is open.
  notifyElsewhere           NotificationSource[]       @default([])
  /// Unused: the columns new task views start with are under « tasks » in tableColumns.
  taskColumns               Json?
  /// Columns new views of each data table start with, by table key: { [tableKey]: { columnOrder, hiddenColumns } };
  /// a table left out (or none at all): the app's.
  tableColumns              Json?
  /// First and last days of its weeks (1 = Monday … 7 = Sunday), both included: the same day twice makes weeks of
  /// 8 days that overlap (Wednesday to Wednesday). Calendar week view, « cette semaine »…
  weekStart                 Int                        @default(1)
  weekEnd                   Int                        @default(7)
  places                    Place[]
  /// Schedules without kind: their name (none: "Travail"), color (none: the green of working hours) and display.
  scheduleLabel             String?
  scheduleColor             String?
  scheduleDayDisplay        String                     @default("SLOT_BACKGROUND")
  scheduleDayBar            Boolean                    @default(true)
  scheduleMonthDisplay      String                     @default("BACKGROUND")
  /// Birthdays of its people in its calendar, shown as all-day events: shown or not (hidden, their reminders
  /// still ring) and color (none: the gray of the éphémérides).
  birthdayShown             Boolean                    @default(true)
  birthdayColor             String?
  /// Unused: birthdays no longer have a display of their own (they are all-day events).
  birthdayDayDisplay        String                     @default("SLOT_BACKGROUND")
  birthdayDayBar            Boolean                    @default(true)
  birthdayMonthDisplay      String                     @default("BACKGROUND")
  createdAt                 DateTime                   @default(now())
  updatedAt                 DateTime                   @updatedAt
  icons                     Icon[]
  clients                   Client[]
  clientServices            ClientService[]
  clientContacts            ClientContact[]
  projects                  Project[]
  projectCategories         ProjectCategory[]
  projectStatuses           ProjectStatus[]
  contributors              Contributor[]
  taskStatuses              TaskStatus[]
  taskPriorities            TaskPriority[]
  taskTypes                 TaskType[]
  taskTags                  TaskTag[]
  tasks                     Task[]
  taskStatusChanges         TaskStatusChange[]
  taskBlocks                TaskBlock[]
  taskRelations             TaskRelation[]
  taskComments              TaskComment[]
  taskViews                 TaskView[]
  milestones                Milestone[]
  sprints                   Sprint[]
  githubConnections         GithubConnection[]
  githubProjectLinks        GithubProjectLink[]
  dashboards                Dashboard[]
  dashboardCharts           DashboardChart[]
  documentFolders           DocumentFolder[]
  libraryDocuments          LibraryDocument[]
  attachments               Attachment[]
  timeEntries               TimeEntry[]
  timeEntryEvents           TimeEntryEvent[]
  alarms                    Alarm[]
  userSettings              UserWorkspaceSettings[]
  mailAccounts              MailAccount[]
  mailMessages              MailMessage[]
  mailLabels                MailLabel[]
  mailSearchs               MailSearch[]
  mailMarks                 MailMark[]
  scheduledMails            ScheduledMail[]
  mailFolderCursors         MailFolderCursor[]
  calendars                 Calendar[]
  calendarSubscriptions     CalendarSubscription[]
  calendarCategories        CalendarCategory[]
  treasuryEntryLines        TreasuryEntryLine[]
  treasuryContexts          TreasuryContext[]
  treasuryBudgets           TreasuryBudget[]
  treasuryRelations         TreasuryRelation[]
  scheduleTypes             ScheduleType[]
  workScheduleSubscriptions WorkScheduleSubscription[] @relation("ScheduleSubscriptions")
  /// Subscriptions of other workspaces to its schedules.
  scheduleSubscribers       WorkScheduleSubscription[] @relation("ScheduleSubscriptionSources")
  calendarEvents            CalendarEvent[]
  calendarEventExceptions   CalendarEventException[]
  workSchedules             WorkSchedule[]
  companyProfiles           CompanyProfile[]
  documentSequences         DocumentSequence[]
  accountingDocuments       AccountingDocument[]
  accountingLines           AccountingLine[]
  recurringInvoices         RecurringInvoice[]
  catalogItems              CatalogItem[]
  projectResources          ProjectResource[]
  importedDocuments         ImportedDocument[]
  documentStatuses          DocumentStatus[]
  documentReminders         DocumentReminder[]
  treasuryAccounts          TreasuryAccount[]
  treasuryCategories        TreasuryCategory[]
  treasuryPaymentMethods    TreasuryPaymentMethod[]
  treasuryCounterparties    TreasuryCounterparty[]
  treasuryEntries           TreasuryEntry[]
  treasuryAllocations       TreasuryAllocation[]
  shoppingCategories        ShoppingCategory[]
  shoppingStores            ShoppingStore[]
  shoppingStorages          ShoppingStorage[]
  shoppingUnits             ShoppingUnit[]
  calendarEventRoutines     CalendarEventRoutine[]
  comments                  Comment[]
  shoppingBaseLists         ShoppingBaseList[]
  shoppingProducts          ShoppingProduct[]
  shoppingLists             ShoppingList[]
  shoppingItems             ShoppingItem[]
  routineCategories         RoutineCategory[]
  routines                  Routine[]
  routineDependencies       RoutineDependency[]
  routineRelations          RoutineRelation[]
  routineChecks             RoutineCheck[]
  sheets                    Sheet[]
  sheetItems                SheetItem[]
  sheetLinks                SheetLink[]
  checklists                Checklist[]
  checklistItems            ChecklistItem[]
  stockLocations            StockLocation[]
  sheetCategories           SheetCategory[]
  savedCountdowns           SavedCountdown[]
  taskAutomations           TaskAutomation[]
  stockItems                StockItem[]
  stockLots                 StockLot[]
  stockMovements            StockMovement[]
  stockCounts               StockCount[]
  shoppingDeliveries        ShoppingDelivery[]
}

/// Kind of notification a workspace can give while another one is open (its alarms and reminders always ring).
enum NotificationSource {
  MAILS
}

/// A personal workspace has no invoicing, no clients and no company.
enum WorkspaceKind {
  PRO
  PERSO
}

model User {
  id                String                  @id @default(cuid())
  /// Lowercase, unique login name.
  username          String                  @unique
  /// Lowercase, unique email address.
  email             String                  @unique
  /// New email address awaiting confirmation.
  pendingEmail      String?
  passwordHash      String
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt
  sessions          Session[]
  authTokens        AuthToken[]
  /// Contributor profile of the user in each workspace ("Moi"): tasks can be assigned to them like to anyone else.
  contributors      Contributor[]
  /// How alarms and reminders ring, in every workspace: { ringMinutes, loop, repeatMinutes, ringtone, outside }; none:
  /// the defaults.
  ringSettings      Json?
  alarmRings        AlarmRing[]
  countdowns        Countdown[]
  /// Devices receiving the push notifications of the user.
  pushSubscriptions PushSubscription[]
  /// Settings of the user in each workspace (« Ma journée »…).
  workspaceSettings UserWorkspaceSettings[]
}

/// Settings of a user in a workspace, one row per user and workspace: read and written by that user only.
model UserWorkspaceSettings {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Settings of the page « Ma journée »: { tasks, routines, schedules, hiddenCalendarIds, hiddenScheduleIds, filters },
  /// as a view of the agenda, read by the shared `readMyDaySettings` (older keys dropped); none: the defaults.
  myDay       Json?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  /// Workspace the row belongs to (always given by the app; the default fails outside one).
  workspaceId String    @default(dbgenerated("current_setting('ordo.workspace'::text)"))
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@index([userId])
}

/// A ring of an alarm or a reminder of the user, one per ring key: what its toast shows, when it rings
/// again (repetition, « Répéter dans N min ») and whether it was stopped, followed by every tab and device (and by the
/// push notifications). Kept 6 hours after its last change.
model AlarmRing {
  id           String    @id @default(cuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Key of the occurrence rung (`event:…:before:15`, `<alarm>:<instant>`…), without the `ordo.alarm.` prefix.
  key          String
  /// Workspace of the alarm or reminder (its link opens it); not a relation: a ring outlives nothing.
  workspaceId  String?
  title        String
  /// Lines under the title (strings).
  lines        Json      @default("[]")
  /// Page of the app its toast links to, and the label of the link.
  path         String?
  linkLabel    String?
  /// Ringtone of the reminder; none: the one of the settings.
  ringtone     String?
  /// Instant the alarm or reminder was due.
  dueAt        DateTime
  /// Start of the ring under way; null: silent (snoozed, or its ring over).
  ringingSince DateTime?
  /// When it rings again; null: not again (no repetition).
  nextAt       DateTime?
  /// Stopped for good (« Arrêter »).
  stoppedAt    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@unique([userId, key])
  @@index([userId, updatedAt])
}

/// A device (browser) of the user subscribed to the push notifications (Web Push), shared by the
/// workspaces as the rings: the server pushes the rings of the alarms and reminders to it while « Sonner hors de l'app »
/// is on. Deleted when the push service says it expired (404, 410), when it is removed, or when its user is deleted.
model PushSubscription {
  id            String    @id @default(cuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Address of the push service for this device (unique: one device, one row; taken by the user who subscribes it).
  endpoint      String    @unique
  /// Keys of the device encrypting the messages (`p256dh`, `auth`).
  p256dh        String
  auth          String
  /// Device as the user reads it (« Chrome · Android »), from its user agent.
  label         String
  createdAt     DateTime  @default(now())
  /// Last message the push service accepted.
  lastSuccessAt DateTime?

  @@index([userId])
}

/// A timer (« minuteur », countdown) of the user, shared by the workspaces as its rings: it counts down
/// and rings at its end. Running: `endsAt` (the moment the server can push its end); paused: `remainingSeconds`.
/// Rung (`rungAt`): its ring goes on as an `AlarmRing` (key `countdown:<id>`), the timer no longer shows; removed 6 hours
/// after. A timer launched for an item (a dead time or a saved timer of a task, a routine and its occurrence, an event and
/// its occurrence, a sheet) keeps it (ids only: no relation).
model Countdown {
  id               String    @id @default(cuid())
  userId           String
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Name (« Pâtes », the dead time « Lave-linge »); none: « Minuteur ».
  label            String?
  /// Duration programmed, in seconds, minutes added included.
  durationSeconds  Int
  /// End while it runs; null: paused.
  endsAt           DateTime?
  /// Seconds left while paused; null: running.
  remainingSeconds Int?
  /// Ringtone at its end; none: the one of the settings.
  ringtone         String?
  /// Workspace of its item (its link opens it there).
  workspaceId      String?
  /// Item it was launched for: a task, a routine and its occurrence, an event (and its occurrence), a sheet (ids only).
  taskId           String?
  routineId        String?
  eventId          String?
  sheetId          String?
  occurrenceDate   DateTime? @db.Date
  /// Name of the item, shown with the timer and its ring.
  subject          String?
  /// Page of the app its ring links to, and the label of the link.
  path             String?
  linkLabel        String?
  /// Its end rang (the ring goes on as an `AlarmRing`).
  rungAt           DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([userId, rungAt])
  @@index([endsAt])
}

/// Saved timer (« minuteur enregistré ») of the workspace, a settings list: « Œufs durs », 9 min, its ringtone; started
/// again in one click, alone or from the tasks, routines, events and sheets it is linked to.
model SavedCountdown {
  id          String          @id @default(cuid())
  label       String
  /// Image shown as its avatar (none: its initials on its color).
  iconId      String?
  icon        Icon?           @relation(fields: [iconId], references: [id], onDelete: SetNull)
  color       String
  position    Int             @default(0)
  /// Duration, in minutes (1 to 1 440).
  minutes     Int
  /// Ringtone at its end; none: the one of the settings.
  ringtone    String?
  /// Archived: hidden by default and read only until restored.
  archivedAt  DateTime?
  createdAt   DateTime        @default(now())
  tasks       Task[]          @relation("TaskSavedCountdowns")
  routines    Routine[]       @relation("RoutineSavedCountdowns")
  events      CalendarEvent[] @relation("EventSavedCountdowns")
  sheets      Sheet[]         @relation("SheetSavedCountdowns")
  /// Workspace the row belongs to (always given by the app; the default fails outside one).
  workspaceId String          @default(dbgenerated("current_setting('ordo.workspace'::text)"))
  workspace   Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, label])
  @@index([workspaceId])
}

/// Automation of the tasks (« quand … alors … ») of the workspace, a settings list: for every task of every project,
/// when its trigger happens and the task meets its condition, its actions change the task (in the order of the list).
model TaskAutomation {
  id          String    @id @default(cuid())
  /// Name, unique in the workspace.
  label       String
  /// Image shown as its avatar (none: its initials on its color).
  iconId      String?
  icon        Icon?     @relation(fields: [iconId], references: [id], onDelete: SetNull)
  color       String
  position    Int       @default(0)
  /// Off: kept, never applied.
  enabled     Boolean   @default(true)
  /// What triggers it: { event, field, change, value } (`taskAutomationTriggerSchema`).
  trigger     Json
  /// Filter of the task table the task must meet (`taskAutomationConditionSchema`); none: every task.
  condition   Json?
  /// What it does, in order: [{ kind, field, value }] (`taskAutomationActionSchema`).
  actions     Json
  /// Archived: hidden by default, read only and never applied until restored.
  archivedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  /// Workspace the row belongs to (always given by the app; the default fails outside one).
  workspaceId String    @default(dbgenerated("current_setting('ordo.workspace'::text)"))
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, label])
  @@index([workspaceId])
}

model Session {
  id         String   @id @default(cuid())
  /// SHA-256 of the token stored in the session cookie.
  tokenHash  String   @unique
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userAgent  String?
  createdAt  DateTime @default(now())
  lastSeenAt DateTime @default(now())
  expiresAt  DateTime

  @@index([userId])
}

enum AuthTokenType {
  PASSWORD_RESET
  EMAIL_CHANGE
}

/// Single-use token sent by email.
model AuthToken {
  id        String        @id @default(cuid())
  /// SHA-256 of the token sent in the link.
  tokenHash String        @unique
  type      AuthTokenType
  userId    String
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Target address for an EMAIL_CHANGE token.
  email     String?
  expiresAt DateTime
  createdAt DateTime      @default(now())

  @@index([userId, type])
}

/// Counter of a rate limit (failed logins, reset requests, password checks), shared by every process and kept across restarts.
model RateLimit {
  /// Limit and what it counts for: « login:… », « login-id:… », « reset:… », « pwcheck:… ».
  key    String    @id
  points Int
  /// End of the counting window; the row is deleted an hour later.
  expire DateTime?
}

/// Uploaded image, stored apart so lists never load the bytes.
model Icon {
  id                     String                  @id @default(cuid())
  mimeType               String
  data                   Bytes
  createdAt              DateTime                @default(now())
  clients                Client[]
  projects               Project[]
  contributors           Contributor[]
  projectStatuses        ProjectStatus[]
  projectCategories      ProjectCategory[]
  taskStatuses           TaskStatus[]
  taskPriorities         TaskPriority[]
  taskTypes              TaskType[]
  taskTags               TaskTag[]
  documentStatuses       DocumentStatus[]
  sheetCategories        SheetCategory[]
  savedCountdowns        SavedCountdown[]
  taskAutomations        TaskAutomation[]
  shoppingStores         ShoppingStore[]
  shoppingUnits          ShoppingUnit[]
  shoppingStorages       ShoppingStorage[]
  mailLabels             MailLabel[]
  calendars              Calendar[]
  scheduleTypes          ScheduleType[]
  treasuryAccounts       TreasuryAccount[]
  treasuryPaymentMethods TreasuryPaymentMethod[]
  treasuryCounterparties TreasuryCounterparty[]
  shoppingBaseLists      ShoppingBaseList[]
  treasuryCategories     TreasuryCategory[]
  shoppingCategories     ShoppingCategory[]
  routineCategories      RoutineCategory[]
  stockLocations         StockLocation[]
  calendarCategories     CalendarCategory[]
  places                 Place[]
  /// Workspace the row belongs to (always given by the app; the default fails outside one).
  workspaceId            String                  @default(dbgenerated("current_setting('ordo.workspace'::text)"))
  workspace              Workspace               @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
}

model Client {
  id         String    @id @default(cuid())
  name       String
  iconId     String?
  icon       Icon?     @relation(fields: [iconId], references: [id], onDelete: SetNull)
  /// Hex color, e.g. #228be6.
  color      String?
  /// Manual order among clients.
  position   Int       @default(0)
  favorite   Boolean   @default(false)
  archivedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  projects   Project[]

  /// Professional (company, association…) or individual.
  kind         ClientKind           @default(COMPANY)
  /// Individual: first and last name (the client name stays the displayed one).
  firstName    String?
  lastName     String?
  /// Postal address: { lines, postalCode, city, region, country (ISO 3166-1 alpha-2) }.
  address      Json?
  email        String?
  /// [{ label, number }]
  phones       Json                 @default("[]")
  website      String?
  vatNumber    String?
  siren        String?
  siret        String?
  /// Activity code (NAF in France, NACE in the EU, NOGA in Switzerland…).
  activityCode String?
  services     ClientService[]
  contacts     ClientContact[]
  documents    AccountingDocument[]
  imported     ImportedDocument[]
  treasury     TreasuryEntry[]
  /// Workspace the row belongs to (always given by the app; the default fails outside one).
  workspaceId  String               @default(dbgenerated("current_setting('ordo.workspace'::text)"))
  workspace    Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
}

enum ClientKind {
  COMPANY
  INDIVIDUAL
}

/// Department or branch of a client, with its own address and contacts.
model ClientService {
  id          String               @id @default(cuid())
  clientId    String
  client      Client               @relation(fields: [clientId], references: [id], onDelete: Cascade)
  label       String
  address     Json?
  email       String?
  phones      Json                 @default("[]")
  position    Int                  @default(0)
  createdAt   DateTime             @default(now())
  contacts    ClientContact[]
  documents   AccountingDocument[]
  /// Workspace the row belongs to (always given by the app; the default fails outside one).
  workspaceId String               @default(dbgenerated("current_setting('ordo.workspace'::text)"))
  workspace   Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([clientId])
  @@index([workspaceId])
}

/// Person at a client, possibly in one of its services.
model ClientContact {
  id                String               @id @default(cuid())
  clientId          String
  client            Client               @relation(fields: [clientId], references: [id], onDelete: Cascade)
  serviceId         String?
  service           ClientService?       @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  firstName         String
  lastName          String
  email             String?
  jobTitle          String?
  phones            Json                 @default("[]")
  /// Archived: hidden by default and read only until restored; archived and restored with its contributor.
  archivedAt        DateTime?
  /// Archived along with its client: restoring the client restores it.
  archivedByCascade Boolean              @default(false)
  createdAt         DateTime             @default(now())
  documents         AccountingDocument[]
  /// Contributor this contact is, if any.
  contributor       Contributor?
  /// Workspace the row belongs to (always given by the app; the default fails outside one).
  workspaceId       String               @default(dbgenerated("current_setting('ordo.workspace'::text)"))
  workspace         Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([clientId])
  @@index([workspaceId])
}

model Project {
  id                String            @id @default(cuid())
  label             String
  /// Client of the project tree, inherited by sub-projects.
  clientId          String?
  client            Client?           @relation(fields: [clientId], references: [id], onDelete: SetNull)
  /// Parent project (null for a root project). Deleting a project deletes its sub-projects.
  parentId          String?
  parent            Project?          @relation("ProjectTree", fields: [parentId], references: [id], onDelete: Cascade)
  children          Project[]         @relation("ProjectTree")
  iconId            String?
  icon              Icon?             @relation(fields: [iconId], references: [id], onDelete: SetNull)
  description       String?
  statusId          String?
  status            ProjectStatus?    @relation(fields: [statusId], references: [id], onDelete: SetNull)
  startDate         DateTime?         @db.Date
  endDate           DateTime?         @db.Date
  /// Hex color, e.g. #228be6.
  color             String?
  /// Manual order among siblings (same parent, or same client for root projects).
  position          Int               @default(0)
  favorite          Boolean           @default(false)
  archivedAt        DateTime?
  /// Archived along with its client or a parent project: restoring that ancestor restores it.
  archivedByCascade Boolean           @default(false)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  categories        ProjectCategory[]
  tasks             Task[]

  milestones    Milestone[]
  sprints       Sprint[]
  githubLink    GithubProjectLink?
  dashboards    Dashboard[]
  taskViews     TaskView[]
  /// Contributors attached to the project (and, through it, to its sub-projects).
  contributors  Contributor[]        @relation("ProjectContributors")
  timeEntries   TimeEntry[]
  alarms        Alarm[]
  mails         MailMessage[]
  events        CalendarEvent[]
  sheets        Sheet[]
  documents     AccountingDocument[]
  resources     ProjectResource[]
  imported      ImportedDocument[]
  treasury      TreasuryEntry[]
  /// Lines of split treasury entries attached to the project.
  treasuryLines TreasuryEntryLine[]
  /// Routines whose tracked time goes to the project.
  routines      Routine[]
  /// Workspace the row belongs to (always given by the app; the default fails outside one).
  workspaceId   String               @default(dbgenerated("current_setting('ordo.workspace'::text)"))
  workspace     Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([clientId])
  @@index([parentId])
  @@index([workspaceId])
}

/// Category of projects (other kinds of categories get their own table).
model ProjectCategory {
  id          String    @id @default(cuid())
  label       String
  /// Image shown as its avatar (none: its initials on its color).
  iconId      String?
  icon        Icon?     @relation(fields: [iconId], references: [id], onDelete: SetNull)
  /// Manual order among its siblings (then by label).
  position    Int       @default(0)
  /// Hex color, e.g. #228be6.
  color       String
  /// Archived: hidden by default and read only until restored.
  archivedAt  DateTime?
  createdAt   DateTime  @default(now())
  projects    Project[]
  /// Workspace the row belongs to (always given by the app; the default fails outside one).
  workspaceId String    @default(dbgenerated("current_setting('ordo.workspace'::text)"))
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, label])
}

/// Configurable project status (e.g. Prospect, In progress, Done).
model ProjectStatus {
  id          String    @id @default(cuid())
  label       String
  /// Image shown as its avatar (none: its initials on its color).
  iconId      String?
  icon        Icon?     @relation(fields: [iconId], references: [id], onDelete: SetNull)
  /// Hex color, e.g. #228be6.
  color       String
  /// Display order in lists and selects.
  position    Int       @default(0)
  /// Archived: hidden by default and read only until restored.
  archivedAt  DateTime?
  createdAt   DateTime  @default(now())
  projects    Project[]
  /// Workspace the row belongs to (always given by the app; the default fails outside one).
  workspaceId String    @default(dbgenerated("current_setting('ordo.workspace'::text)"))
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, label])
}

/// Person who can be assigned to tasks.
model Contributor {
  id                    String              @id @default(cuid())
  name                  String
  /// Unique identifier used in @mentions.
  handle                String
  iconId                String?
  icon                  Icon?               @relation(fields: [iconId], references: [id], onDelete: SetNull)
  /// Archived: hidden by default and read only until restored; archived and restored with its relation or its contact.
  archivedAt            DateTime?
  /// Archived along with the client of its contact: restoring the client restores it.
  archivedByCascade     Boolean             @default(false)
  createdAt             DateTime            @default(now())
  tasks                 Task[]
  /// Projects the contributor is attached to; sub-projects inherit them.
  projects              Project[]           @relation("ProjectContributors")
  events                CalendarEvent[]
  /// Set when this contributor is the app user ("Moi").
  userId                String?
  user                  User?               @relation(fields: [userId], references: [id], onDelete: SetNull)
  /// GitHub login: assignees are synchronized with the GitHub boards through it.
  githubLogin           String?
  /// Birth date: YYYY-MM-DD, or --MM-DD when the year is not known. Its own details (birth date, birthday
  /// reminders, email addresses, phones) apply only while it is a member of the team or household; otherwise they stay
  /// stored, unused, and its details are those of what it is linked to (relation, contact).
  birthDate             String?
  /// Reminders of its birthday: [{ before: null, at: "HH:MM", days }] (on the day or some days before).
  birthdayReminders     Json                @default("[]")
  /// [{ label, address }]: several email addresses.
  emails                Json                @default("[]")
  /// [{ label, number }]
  phones                Json                @default("[]")
  /// Client contact this contributor is (professional workspace): its email and phones are the contributor's. A
  /// contact is one contributor at most; a contributor is linked to one of a membership, a relation or a contact at most.
  contactId             String?             @unique
  contact               ClientContact?      @relation(fields: [contactId], references: [id], onDelete: SetNull)
  /// Member of the team (professional workspace) or household (personal one): treasury entries are split
  /// between members. The app user ("Moi") always is one.
  teamMember            Boolean             @default(false)
  /// Lines of treasury entries that are theirs.
  treasuryLines         TreasuryEntryLine[]
  treasuryBudgets       TreasuryBudget[]
  /// Relation (out of the team or household) this contributor also is.
  treasuryRelations     TreasuryRelation[]
  /// Shopping products and items it is for (member of the team or household).
  shoppingProducts      ShoppingProduct[]   @relation("ShoppingProductMembers")
  shoppingItems         ShoppingItem[]      @relation("ShoppingItemMembers")
  sheetItems            SheetItem[]         @relation("SheetItemMembers")
  stockItems            StockItem[]         @relation("StockItemMembers")
  /// Routines it is assigned to.
  routines              Routine[]           @relation("RoutineAssignees")
  /// Tasks, routines and events it is a beneficiary of.
  beneficiaryOfTasks    Task[]              @relation("TaskBeneficiaries")
  beneficiaryOfRoutines Routine[]           @relation("RoutineBeneficiaries")
  beneficiaryOfEvents   CalendarEvent[]     @relation("EventBeneficiaries")
  /// Workspace the row belongs to (always given by the app; the default fails outside one).
  workspaceId           String              @default(dbgenerated("current_setting('ordo.workspace'::text)"))
  workspace             Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, handle])
  @@unique([workspaceId, githubLogin])
  @@unique([workspaceId, userId])
}

/// How a task was closed, as the state reason of a GitHub issue: done or cancelled (« non prévue »).
enum TaskCloseReason {
  COMPLETED
  NOT_PLANNED
}

/// Fixed meaning of a task status, whatever its name: a classification (filters, tasks « en cours »); it neither closes nor reopens tasks.
enum TaskStatusCategory {
  TODO
  IN_PROGRESS
  DONE
  CANCELLED
}

model TaskStatus {
  id          String             @id @default(cuid())
  label       String
  /// Image shown as its avatar (none: its initials on its color).
  iconId      String?
  icon        Icon?              @relation(fields: [iconId], references: [id], onDelete: SetNull)
  /// Hex color, e.g. #228be6.
  color       String
  category    TaskStatusCategory @default(TODO)
  position    Int                @default(0)
  /// Archived: hidden by default and read only until restored.
  archivedAt  DateTime?
  createdAt   DateTime           @default(now())
  tasks       Task[]
  /// Workspace the row belongs to (always given by the app; the default fails outside one).
  workspaceId String             @default(dbgenerated("current_setting('ordo.workspace'::text)"))
  workspace   Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, label])
}

model TaskPriority {
  id          String    @id @default(cuid())
  label       String
  /// Image shown as its avatar (none: its initials on its color).
  iconId      String?
  icon        Icon?     @relation(fields: [iconId], references: [id], onDelete: SetNull)
  /// Hex color, e.g. #228be6.
  color       String
  position    Int       @default(0)
  /// Archived: hidden by default and read only until restored.
  archivedAt  DateTime?
  createdAt   DateTime  @default(now())
  tasks       Task[]
  /// Routines of this priority (the list is shared by the tasks and the routines).
  routines    Routine[]
  /// Workspace the row belongs to (always given by the app; the default fails outside one).
  workspaceId String    @default(dbgenerated("current_setting('ordo.workspace'::text)"))
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, label])
}

model TaskType {
  id          String    @id @default(cuid())
  label       String
  /// Image shown as its avatar (none: its initials on its color).
  iconId      String?
  icon        Icon?     @relation(fields: [iconId], references: [id], onDelete: SetNull)
  /// Hex color, e.g. #228be6.
  color       String
  position    Int       @default(0)
  /// Archived: hidden by default and read only until restored.
  archivedAt  DateTime?
  createdAt   DateTime  @default(now())
  tasks       Task[]
  /// Routines of this type (the list is shared by the tasks and the routines).
  routines    Routine[]
  /// Workspace the row belongs to (always given by the app; the default fails outside one).
  workspaceId String    @default(dbgenerated("current_setting('ordo.workspace'::text)"))
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, label])
}

/// Tag of tasks (several per task), synchronized with the GitHub labels.
model TaskTag {
  id          String    @id @default(cuid())
  label       String
  /// Image shown as its avatar (none: its initials on its color).
  iconId      String?
  icon        Icon?     @relation(fields: [iconId], references: [id], onDelete: SetNull)
  /// Hex color, e.g. #228be6.
  color       String
  position    Int       @default(0)
  /// Archived: hidden by default and read only until restored.
  archivedAt  DateTime?
  createdAt   DateTime  @default(now())
  tasks       Task[]    @relation("TaskTags")
  /// Workspace the row belongs to (always given by the app; the default fails outside one).
  workspaceId String    @default(dbgenerated("current_setting('ordo.workspace'::text)"))
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, label])
}

model Task {
  id                   String             @id @default(cuid())
  /// Human-readable number (#12) within its project, given by the database (trigger "task_project_number"): the
  /// next of the project on creation, and of the target project on a transfer; none without project. Links use the
  /// id, never the number.
  number               Int?
  label                String
  /// On or out of calendar schedules, or on the free time, in groups (and / or), as a routine; null: any time.
  slotCondition        Json?
  /// « Horaires »: days and hours it can be done, cases shaped as those of a créneau (`taskHoursSchema`); empty: any
  /// time. With a slot condition, doable only when both allow it. Not shown in the agenda.
  hours                Json               @default("[]")
  /// Markdown.
  description          String?
  /// Where it is done: free text, and its point when chosen from the map or a search (no travel time: no hours).
  location             String?
  locationLat          Float?
  locationLon          Float?
  /// [{ url, label }], as those of the events.
  links                Json               @default("[]")
  /// None: a task of no project (no number, no sprint, milestone nor GitHub item). A deleted project leaves its tasks
  /// without project (the API takes them out first, as in a transfer).
  projectId            String?
  project              Project?           @relation(fields: [projectId], references: [id], onDelete: SetNull)
  statusId             String?
  status               TaskStatus?        @relation(fields: [statusId], references: [id], onDelete: SetNull)
  priorityId           String?
  priority             TaskPriority?      @relation(fields: [priorityId], references: [id], onDelete: SetNull)
  typeId               String?
  type                 TaskType?          @relation(fields: [typeId], references: [id], onDelete: SetNull)
  milestoneId          String?
  milestone            Milestone?         @relation(fields: [milestoneId], references: [id], onDelete: SetNull)
  /// Item of the GitHub board the task is synchronized with (ProjectV2Item node id).
  githubItemId         String?            @unique
  /// Content of the item: issue or draft issue node id.
  githubContentId      String?
  /// ISSUE or DRAFT_ISSUE; REMOVED: removed from the board (not sent again by the sync).
  githubContentType    String?
  githubUrl            String?
  githubNumber         Int?
  /// Synchronized values at the last sync, for the three-way merge.
  githubSnapshot       Json?
  effort               Float?
  startDate            DateTime?          @db.Date
  endDate              DateTime?          @db.Date
  /// Latest acceptable date (« Échéance »): an open task past it is overdue.
  /// Earliest acceptable date (« Ouverture »): the task is not to be done before it.
  minDate              DateTime?          @db.Date
  deadline             DateTime?          @db.Date
  /// Reminders [{ before: null, at: "HH:MM" }] (Paris time), 10 at most: rung every day from « Ouverture » to
  /// « Échéance » (the « Échéance » day only without « Ouverture »; never without « Échéance »).
  reminders            Json               @default("[]")
  /// « Temps morts » [{ label, minutes, ringtone? }], 20 at most: waits a timer is launched for.
  deadTimes            Json               @default("[]")
  /// Parent task, possibly in another project of the same tree.
  parentId             String?
  parent               Task?              @relation("TaskTree", fields: [parentId], references: [id], onDelete: SetNull)
  children             Task[]             @relation("TaskTree")
  /// Fields it takes from its parent, live: PROJECT, ASSIGNEES, BENEFICIARIES, SLOT_CONDITION, HOURS, MIN_DATE,
  /// DEADLINE, LOCATION, PRIORITY, MILESTONE. A field not listed is its own value (emptied on purpose when it has none);
  /// always empty for a top-level task. Its effective values: `effectiveTask` (@ordo/shared).
  inheritedFields      String[]           @default([])
  /// Global manual order.
  position             Int                @default(0)
  /// Closed task: it no longer blocks, is never overdue and counts as done. Independent of the status.
  closedAt             DateTime?
  /// How it was closed: done (COMPLETED) or cancelled (NOT_PLANNED, struck through); none while open.
  closeReason          TaskCloseReason?
  archivedAt           DateTime?
  /// Archived along with its parent task: restoring the parent restores it.
  archivedByCascade    Boolean            @default(false)
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
  assignees            Contributor[]
  /// « Bénéficiaires »: whom the task is for (contributors, and relations out of the team or household).
  beneficiaries        Contributor[]      @relation("TaskBeneficiaries")
  beneficiaryRelations TreasuryRelation[] @relation("TaskBeneficiaryRelations")
  tags                 TaskTag[]          @relation("TaskTags")
  /// Saved timers launched from it.
  savedCountdowns      SavedCountdown[]   @relation("TaskSavedCountdowns")
  /// Sprints of the project tree the task is planned in (it may run over several).
  sprints              Sprint[]           @relation("TaskSprints")
  /// Status changes (recorded by a database trigger).
  statusChanges        TaskStatusChange[]
  /// Tasks this task blocks.
  blocking             TaskBlock[]        @relation("Blocker")
  /// Tasks blocking this task.
  blockedBy            TaskBlock[]        @relation("Blocked")
  /// Symmetric relations, stored once with taskAId < taskBId.
  relationsA           TaskRelation[]     @relation("RelationA")
  relationsB           TaskRelation[]     @relation("RelationB")
  comments             TaskComment[]
  /// Sheets the task gets a checklist of.
  sheetLinks           SheetLink[]
  checklists           Checklist[]
  timeEntries          TimeEntry[]
  /// Calendar events about the task.
  calendarEvents       CalendarEvent[]    @relation("CalendarEventTasks")
  alarms               Alarm[]
  /// Shopping lists of the task (closed along with it).
  shoppingLists        ShoppingList[]     @relation("ShoppingListTasks")
  /// Documents linked to it: of the library, and of its project tree (not inherited by its sub-tasks).
  libraryDocuments     LibraryDocument[]  @relation("TaskLibraryDocuments")
  projectResources     ProjectResource[]  @relation("TaskProjectResources")
  /// Workspace the row belongs to (always given by the app; the default fails outside one).
  workspaceId          String             @default(dbgenerated("current_setting('ordo.workspace'::text)"))
  workspace            Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([projectId, number])
  @@index([projectId])
  @@index([parentId])
  @@index([milestoneId])
  @@index([deadline])
  @@index([closedAt])
  @@index([workspaceId])
}

/// Status (and open / closed state) of a task from a moment: written by a database trigger on each change of
/// the task (and once with its first status), to know its status at the end of a past sprint.
model TaskStatusChange {
  id          String    @id @default(cuid())
  taskId      String
  task        Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)
  /// Status from then (kept even if the status is deleted later).
  statusId    String?
  closed      Boolean
  at          DateTime
  /// Workspace the row belongs to (always given by the app; the default fails outside one).
  workspaceId String    @default(dbgenerated("current_setting('ordo.workspace'::text)"))
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([taskId, at])
  @@index([workspaceId])
}

/// "blocker blocks blocked".
model TaskBlock {
  blockerId   String
  blocker     Task      @relation("Blocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blockedId   String
  blocked     Task      @relation("Blocked", fields: [blockedId], references: [id], onDelete: Cascade)
  /// Workspace the row belongs to (always given by the app; the default fails outside one).
  workspaceId String    @default(dbgenerated("current_setting('ordo.workspace'::text)"))
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@id([blockerId, blockedId])
  @@index([blockedId])
  @@index([workspaceId])
}

/// "related to", symmetric.
model TaskRelation {
  taskAId     String
  taskA       Task      @relation("RelationA", fields: [taskAId], references: [id], onDelete: Cascade)
  taskBId     String
  taskB       Task      @relation("RelationB", fields: [taskBId], references: [id], onDelete: Cascade)
  /// Workspace the row belongs to (always given by the app; the default fails outside one).
  workspaceId String    @default(dbgenerated("current_setting('ordo.workspace'::text)"))
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@id([taskAId, taskBId])
  @@index([taskBId])
  @@index([workspaceId])
}

model TaskComment {
  id              String    @id @default(cuid())
  taskId          String
  task            Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)
  /// Markdown.
  body            String
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  /// Comment of the GitHub issue it is synchronized with.
  githubCommentId String?   @unique
  /// Body at the last sync, for the three-way merge.
  githubBody      String?
  /// Author on GitHub (the account connected included; a comment published from Ordo: the account it was published with); null: written in Ordo and never sent, or synchronized before authors were recorded.
  githubAuthor    String?
  /// Workspace the row belongs to (always given by the app; the default fails outside one).
  workspaceId     String    @default(dbgenerated("current_setting('ordo.workspace'::text)"))
  workspace       Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([taskId])
  @@index([workspaceId])
}

/// Comment (markdown) of an item other than a task (those have their own): exactly one target set — a row of the app,
/// or a mail by its Message-ID (mails stay on their server).
model Comment {
  id                 String              @id @default(cuid())
  /// Markdown.
  body               String
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  routineId          String?
  routine            Routine?            @relation(fields: [routineId], references: [id], onDelete: Cascade)
  eventId            String?
  event              CalendarEvent?      @relation(fields: [eventId], references: [id], onDelete: Cascade)
  /// Occurrence of the routine or event the comment is on: the day of the occurrence (that of its
  /// ticks for a routine); null for a one-off event and for the other items.
  occurrenceDate     DateTime?           @db.Date
  scheduleId         String?
  schedule           WorkSchedule?       @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  timeEntryId        String?
  timeEntry          TimeEntry?          @relation(fields: [timeEntryId], references: [id], onDelete: Cascade)
  shoppingListId     String?
  shoppingList       ShoppingList?       @relation(fields: [shoppingListId], references: [id], onDelete: Cascade)
  shoppingProductId  String?
  shoppingProduct    ShoppingProduct?    @relation(fields: [shoppingProductId], references: [id], onDelete: Cascade)
  shoppingItemId     String?
  shoppingItem       ShoppingItem?       @relation(fields: [shoppingItemId], references: [id], onDelete: Cascade)
  sheetItemId        String?
  sheetItem          SheetItem?          @relation(fields: [sheetItemId], references: [id], onDelete: Cascade)
  stockItemId        String?
  stockItem          StockItem?          @relation(fields: [stockItemId], references: [id], onDelete: Cascade)
  documentId         String?
  document           AccountingDocument? @relation(fields: [documentId], references: [id], onDelete: Cascade)
  importedDocumentId String?
  importedDocument   ImportedDocument?   @relation(fields: [importedDocumentId], references: [id], onDelete: Cascade)
  catalogItemId      String?
  catalogItem        CatalogItem?        @relation(fields: [catalogItemId], references: [id], onDelete: Cascade)
  treasuryEntryId    String?
  treasuryEntry      TreasuryEntry?      @relation(fields: [treasuryEntryId], references: [id], onDelete: Cascade)
  budgetId           String?
  budget             TreasuryBudget?     @relation(fields: [budgetId], references: [id], onDelete: Cascade)
  relationId         String?
  relation           TreasuryRelation?   @relation(fields: [relationId], references: [id], onDelete: Cascade)
  libraryDocumentId  String?
  libraryDocument    LibraryDocument?    @relation(fields: [libraryDocumentId], references: [id], onDelete: Cascade)
  /// Message-ID header of the mail (without angle brackets).
  mailMessageId      String?
  /// Workspace the row belongs to (always given by the app; the default fails outside one).
  workspaceId        String              @default(dbgenerated("current_setting('ordo.workspace'::text)"))
  workspace          Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([routineId])
  @@index([eventId])
  @@index([scheduleId])
  @@index([timeEntryId])
  @@index([shoppingListId])
  @@index([shoppingProductId])
  @@index([shoppingItemId])
  @@index([sheetItemId])
  @@index([stockItemId])
  @@index([documentId])
  @@index([importedDocumentId])
  @@index([catalogItemId])
  @@index([treasuryEntryId])
  @@index([budgetId])
  @@index([relationId])
  @@index([libraryDocumentId])
  @@index([mailMessageId])
  @@index([workspaceId])
}

/// Saved task table view: filters, sorting, columns and grouping (JSON validated by @ordo/shared).
/// What a saved view lists.
enum ViewKind {
  TASKS
  ROUTINES
  SHOPPING_LISTS
  /// Any other table, named by its tableKey.
  TABLE
}

model TaskView {
  id          String    @id @default(cuid())
  label       String
  /// Tasks, routines or shopping lists (each kind with its own configuration and tabs).
  kind        ViewKind  @default(TASKS)
  /// Table of a view of kind TABLE (« time-log »…); null for the other kinds.
  tableKey    String?
  config      Json
  /// Project whose task tab shows the view; null for the home page.
  projectId   String?
  project     Project?  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  /// Opened first in its project (or on the home page); at most one per scope.
  isDefault   Boolean   @default(false)
  position    Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  /// Workspace the row belongs to (always given by the app; the default fails outside one).
  workspaceId String    @default(dbgenerated("current_setting('ordo.workspace'::text)"))
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
}

/// Project milestone, usable by the tasks of the project and its sub-projects.
model Milestone {
  id          String    @id @default(cuid())
  projectId   String
  project     Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  label       String
  /// Markdown.
  description String?
  dueDate     DateTime? @db.Date
  position    Int       @default(0)
  /// Archived: hidden by default and read only until restored.
  archivedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  tasks       Task[]
  /// Workspace the row belongs to (always given by the app; the default fails outside one).
  workspaceId String    @default(dbgenerated("current_setting('ordo.workspace'::text)"))
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([workspaceId])
}

/// Sprint of a project: a period the tasks of its project tree are planned in.
model Sprint {
  id                String    @id @default(cuid())
  projectId         String
  project           Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  label             String
  /// Markdown.
  goal              String?
  startDate         DateTime  @db.Date
  endDate           DateTime  @db.Date
  /// Iteration of a GitHub board the sprint mirrors.
  githubIterationId String?   @unique
  /// Title, first day and length of the iteration at the last sync ({ title, startDate, duration }), or { removed: true }
  /// once its iteration was deleted on GitHub (the sprint is then no longer sent).
  githubSnapshot    Json?
  /// Archived: hidden by default and read only until restored.
  archivedAt        DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  tasks             Task[]    @relation("TaskSprints")
  /// Workspace the row belongs to (always given by the app; the default fails outside one).
  workspaceId       String    @default(dbgenerated("current_setting('ordo.workspace'::text)"))
  workspace         Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([workspaceId])
}

/// GitHub access of the app: a personal access token (encrypted), single row.
model GithubConnection {
  id          String    @id @default(cuid())
  /// Encrypted token; empty once forgotten (« Déconnecter »): the row keeps the last login.
  token       String
  /// Login of the token's owner (the last one once the token is forgotten; replaced by the next token's).
  login       String
  updatedAt   DateTime  @updatedAt
  /// Workspace the row belongs to (always given by the app; the default fails outside one).
  workspaceId String    @unique @default(dbgenerated("current_setting('ordo.workspace'::text)"))
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

/// Project synchronized with a GitHub Projects (v2) board, both ways.
model GithubProjectLink {
  id                    String    @id @default(cuid())
  projectId             String    @unique
  project               Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  /// Node id, URL and title of the board.
  githubProjectId       String
  url                   String
  label                 String
  /// Fields of the board synchronized (null: not synchronized).
  statusFieldId         String?
  priorityFieldId       String?
  iterationFieldId      String?
  startFieldId          String?
  endFieldId            String?
  effortFieldId         String?
  deadlineFieldId       String?
  /// Number field receiving the tracked time of the tasks, in hours (Ordo → GitHub only).
  timeSpentFieldId      String?
  /// Task types: FIELD (single select field typeFieldId), ISSUE_TYPE (issue types of the organization), or null.
  typeSource            String?
  typeFieldId           String?
  /// Option of the board for each Ordo status / priority / type: { [ordoId]: optionId } (issue type id for ISSUE_TYPE).
  statusOptions         Json      @default("{}")
  priorityOptions       Json      @default("{}")
  typeOptions           Json      @default("{}")
  /// Assignees and tags synchronized with the assignees and labels of GitHub.
  syncAssignees         Boolean   @default(true)
  syncLabels            Boolean   @default(true)
  /// New Ordo tasks become issues of this repository, or draft issues without one.
  repositoryId          String?
  repositoryName        String?
  /// Ordo tasks created before the link are sent too.
  pushExisting          Boolean   @default(false)
  enabled               Boolean   @default(true)
  lastSyncAt            DateTime?
  lastSyncError         String?
  /// Iterations of the field paired with a sprint at the last sync (string ids): one without sprint since was
  /// deleted in Ordo, and is not made a sprint again.
  iterationIds          Json      @default("[]")
  /// Sprints written as iterations on GitHub (off: iterations are only read, as sprints, and paired).
  writeIterations       Boolean   @default(false)
  /// Iteration write sent but not checked yet ({ sent, before, changes }): the next sync checks the field first.
  iterationWritePending Json?
  /// Why GitHub refused the last iteration write (the field unchanged): tried again at each sync.
  iterationWriteRefusal String?
  /// Set when GitHub did not keep an iteration write as sent: iterations are no longer synchronized until resumed
  /// (« Reprendre »).
  iterationWriteError   String?
  /// Counts of the last sync (created, updated… on each side).
  lastSyncSummary       Json?
  createdAt             DateTime  @default(now())
  /// Workspace the row belongs to (always given by the app; the default fails outside one).
  workspaceId           String    @default(dbgenerated("current_setting('ordo.workspace'::text)"))
  workspace             Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
}

/// Dashboard of charts on the tasks: global (no project) or of a project tree.
model Dashboard {
  id          String           @id @default(cuid())
  projectId   String?
  project     Project?         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  label       String
  position    Int              @default(0)
  /// Archived: hidden by default and read only until restored.
  archivedAt  DateTime?
  createdAt   DateTime         @default(now())
  charts      DashboardChart[]
  /// Workspace the row belongs to (always given by the app; the default fails outside one).
  workspaceId String           @default(dbgenerated("current_setting('ordo.workspace'::text)"))
  workspace   Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([workspaceId])
}

/// Chart of a dashboard: type, axes, measure, series and filters (JSON, validated by the shared schema).
model DashboardChart {
  id          String    @id @default(cuid())
  dashboardId String
  dashboard   Dashboard @relation(fields: [dashboardId], references: [id], onDelete: Cascade)
  label       String
  config      Json
  /// Width in the dashboard grid: half or full.
  wide        Boolean   @default(false)
  position    Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  /// Workspace the row belongs to (always given by the app; the default fails outside one).
  workspaceId String    @default(dbgenerated("current_setting('ordo.workspace'::text)"))
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([dashboardId])
  @@index([workspaceId])
}

/// Folder of the document library (folders nest).
model DocumentFolder {
  id          String            @id @default(cuid())
  name        String
  parentId    String?
  parent      DocumentFolder?   @relation("DocumentFolderTree", fields: [parentId], references: [id], onDelete: Cascade)
  children    DocumentFolder[]  @relation("DocumentFolderTree")
  documents   LibraryDocument[]
  /// Order among the folders of its parent (then by name).
  position    Int               @default(0)
  createdAt   DateTime          @default(now())
  /// Workspace the row belongs to (always given by the app; the default fails outside one).
  workspaceId String            @default(dbgenerated("current_setting('ordo.workspace'::text)"))
  workspace   Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([parentId])
  @@index([workspaceId])
}

/// Document of the library (Kbis, logo, statutes, certificates…): a file, or a link to a cloud or a site.
model LibraryDocument {
  id              String              @id @default(cuid())
  /// Folder, or null at the root of the library.
  folderId        String?
  folder          DocumentFolder?     @relation(fields: [folderId], references: [id], onDelete: Cascade)
  kind            ProjectResourceKind
  title           String
  url             String?
  attachmentId    String?             @unique
  attachment      Attachment?         @relation(fields: [attachmentId], references: [id], onDelete: Cascade)
  note            String?
  /// Order among the documents of its folder (then by title).
  position        Int                 @default(0)
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  /// Treasury entries it supports.
  treasuryEntries TreasuryEntry[]     @relation("TreasuryEntryLibraryDocuments")
  treasuryLines   TreasuryEntryLine[] @relation("TreasuryLineLibraryDocuments")
  /// Tasks, routines and events it is linked to.
  tasks           Task[]              @relation("TaskLibraryDocuments")
  routines        Routine[]           @relation("RoutineLibraryDocuments")
  calendarEvents  CalendarEvent[]     @relation("EventLibraryDocuments")
  /// Comments (markdown).
  comments        Comment[]
  /// Workspace the row belongs to (always given by the app; the default fails outside one).
  workspaceId     String              @default(dbgenerated("current_setting('ordo.workspace'::text)"))
  workspace       Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([folderId])
  @@index([workspaceId])
}

/// File attached to a markdown text (description, comment…) and linked from it.
model Attachment {
  id                   String              @id @default(cuid())
  /// Original file name, used for the download.
  filename             String
  mimeType             String
  size                 Int
  data                 Bytes
  createdAt            DateTime            @default(now())
  /// Set for a file of a mail copied into a project.
  mailMessageId        String?
  mailMessage          MailMessage?        @relation(fields: [mailMessageId], references: [id], onDelete: Cascade)
  /// Content-ID of an inline image of that mail.
  contentId            String?
  /// Set for a file of a project.
  projectResource      ProjectResource?
  /// Set for the file of an imported document.
  importedDocument     ImportedDocument?
  /// Set for a file attached to an accounting document.
  accountingDocumentId String?
  accountingDocument   AccountingDocument? @relation("DocumentAttachments", fields: [accountingDocumentId], references: [id], onDelete: Cascade)
  /// Set for the signed copy of a quote.
  signedQuote          AccountingDocument? @relation("SignedQuote")
  /// Set for a document of the library.
  libraryDocument      LibraryDocument?
  /// Workspace the row belongs to (always given by the app; the default fails outside one).
  workspaceId          String              @default(dbgenerated("current_setting('ordo.workspace'::text)"))
  workspace            Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([mailMessageId])
  @@index([workspaceId])
}

/// Tracked time on a project, optionally spent on tasks (shared equally between them).
model TimeEntry {
  id            String              @id @default(cuid())
  /// Project the time is spent on, if any (a time has at least a project, a task, a routine or an event).
  /// A deleted project leaves its time without project; the API first deletes the time left with nothing attached.
  projectId     String?
  project       Project?            @relation(fields: [projectId], references: [id], onDelete: SetNull)
  /// Routines the time is spent on (several).
  routines      Routine[]
  /// What was done (plain text, several lines).
  description   String?
  startedAt     DateTime
  /// Null while the timer runs (several may run at once).
  endedAt       DateTime?
  /// Start of the current pause, while paused.
  pausedAt      DateTime?
  /// Paused time before the current pause, in seconds.
  pausedSeconds Int                 @default(0)
  /// Effective duration in seconds (pauses excluded), set once stopped.
  duration      Int?
  /// Invoice (draft or final) the time is billed on.
  documentId    String?
  document      AccountingDocument? @relation(fields: [documentId], references: [id], onDelete: SetNull)
  /// Calendar events (occurrences) the time was spent on (several): the calendar only shows the part
  /// of the time outside them.
  events        TimeEntryEvent[]
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  tasks         Task[]
  /// Comments (markdown).
  comments      Comment[]
  /// Workspace the row belongs to (always given by the app; the default fails outside one).
  workspaceId   String              @default(dbgenerated("current_setting('ordo.workspace'::text)"))
  workspace     Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([startedAt])
  @@index([endedAt])
  @@index([documentId])
  @@index([workspaceId])
}

/// Calendar event (and occurrence of a recurring one) a time is spent on.
model TimeEntryEvent {
  id             String        @id @default(cuid())
  timeEntryId    String
  timeEntry      TimeEntry     @relation(fields: [timeEntryId], references: [id], onDelete: Cascade)
  eventId        String
  event          CalendarEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  /// Occurrence of a recurring event (null for a one-off event).
  occurrenceDate DateTime?     @db.Date
  /// Workspace the row belongs to (always given by the app; the default fails outside one).
  workspaceId    String        @default(dbgenerated("current_setting('ordo.workspace'::text)"))
  workspace      Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([timeEntryId])
  @@index([eventId])
  @@index([workspaceId])
}

/// What triggers an alarm.
enum AlarmType {
  /// At the scheduled times.
  REMINDER
  /// At the scheduled times, only when no timer runs.
  NOT_TRACKING
  /// After every `minutes` of tracking on the running timer.
  TRACKING_DURATION
}

enum AlarmFrequency {
  ONCE
  DAILY
  WEEKLY
  MONTHLY
}

/// Alarm rung by the app while it is open. Schedules are in the user's local time.
model Alarm {
  id          String         @id @default(cuid())
  label       String
  note        String?
  type        AlarmType      @default(REMINDER)
  /// First day of the schedule (REMINDER, NOT_TRACKING).
  startDate   DateTime?      @db.Date
  /// Local time of day, HH:MM (REMINDER, NOT_TRACKING).
  time        String?
  frequency   AlarmFrequency @default(ONCE)
  /// Every n days / weeks / months.
  interval    Int            @default(1)
  /// Weekdays of a weekly schedule, 1 (Monday) to 7 (Sunday); empty: the start date's weekday.
  weekdays    Int[]
  /// Last day of the schedule, included.
  endDate     DateTime?      @db.Date
  /// Repetition in the common form (rule, end, « rien » exceptions; former pauses read as exceptions); none: frequency, interval, weekdays, endDate.
  recurrence  Json?
  /// Tracking time between two rings (TRACKING_DURATION).
  minutes     Int?
  /// A deleted project leaves its alarms without project.
  projectId   String?
  project     Project?       @relation(fields: [projectId], references: [id], onDelete: SetNull)
  taskId      String?
  task        Task?          @relation(fields: [taskId], references: [id], onDelete: Cascade)
  enabled     Boolean        @default(true)
  /// Last time it rang: occurrences up to then are done.
  lastFiredAt DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  /// Workspace the row belongs to (always given by the app; the default fails outside one).
  workspaceId String         @default(dbgenerated("current_setting('ordo.workspace'::text)"))
  workspace   Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
}

/// Mailbox read over IMAP and sent from over SMTP. Passwords are encrypted (MAIL_ENCRYPTION_KEY).
model MailAccount {
  id           String             @id @default(cuid())
  /// Label shown in the app ("Pro", "Perso"…).
  label        String
  email        String
  /// Sender name.
  displayName  String?
  imapHost     String
  imapPort     Int
  imapSecure   Boolean            @default(true)
  imapUser     String
  imapPassword String
  smtpHost     String
  smtpPort     Int
  smtpSecure   Boolean            @default(true)
  smtpUser     String
  smtpPassword String
  /// Saves sent mails in the Sent folder (off for servers doing it themselves, like Gmail).
  saveSent     Boolean            @default(true)
  /// HTML signature added to new mails.
  signature    String?
  position     Int                @default(0)
  /// Archived: hidden by default and read only until restored.
  archivedAt   DateTime?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  messages     MailMessage[]
  cursors      MailFolderCursor[]
  marks        MailMark[]
  scheduled    ScheduledMail[]
  /// Workspace the row belongs to (always given by the app; the default fails outside one).
  workspaceId  String             @default(dbgenerated("current_setting('ordo.workspace'::text)"))
  workspace    Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
}

/// Copy of a mail linked to a project (mails are otherwise read live from the server).
model MailMessage {
  id          String       @id @default(cuid())
  projectId   String
  project     Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  accountId   String?
  account     MailAccount? @relation(fields: [accountId], references: [id], onDelete: SetNull)
  /// Message-ID header, without angle brackets.
  messageId   String
  inReplyTo   String?
  references  String[]
  subject     String
  fromName    String?
  fromAddress String
  /// [{ name, address }]
  to          Json
  cc          Json
  date        DateTime
  /// Sanitized HTML body.
  html        String?
  text        String?
  /// Sent from Ordo (rather than received).
  sent        Boolean      @default(false)
  createdAt   DateTime     @default(now())
  attachments Attachment[]
  /// Workspace the row belongs to (always given by the app; the default fails outside one).
  workspaceId String       @default(dbgenerated("current_setting('ordo.workspace'::text)"))
  workspace   Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([projectId, messageId])
  @@index([messageId])
  @@index([workspaceId])
}

/// Last mail checked in a folder, to link the new messages of conversations already linked to a project.
/// Flag of mails, set by the user (label, color): an IMAP keyword on the mails, or a mark in Ordo when the server
/// takes no keywords.
model MailLabel {
  id          String    @id @default(cuid())
  label       String
  /// Image shown as its avatar (none: its initials on its color).
  iconId      String?
  icon        Icon?     @relation(fields: [iconId], references: [id], onDelete: SetNull)
  color       String
  position    Int       @default(0)
  /// Archived: hidden by default and read only until restored.
  archivedAt  DateTime?
  createdAt   DateTime  @default(now())
  /// Workspace the row belongs to (always given by the app; the default fails outside one).
  workspaceId String    @default(dbgenerated("current_setting('ordo.workspace'::text)"))
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, label])
  @@index([workspaceId])
}

/// Search folder: mails matching criteria across accounts and folders, kept in Ordo (not on the server).
model MailSearch {
  id          String    @id @default(cuid())
  label       String
  /// { accountIds, scope ('inbox' | 'all'), state ('all' | 'todo' | 'done'), labelIds, unread, text }
  criteria    Json
  position    Int       @default(0)
  createdAt   DateTime  @default(now())
  /// Workspace the row belongs to (always given by the app; the default fails outside one).
  workspaceId String    @default(dbgenerated("current_setting('ordo.workspace'::text)"))
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
}

/// Flags and "done" state of a mail kept in Ordo, for servers that take no IMAP keywords.
model MailMark {
  accountId   String
  account     MailAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  /// Message-ID of the mail, without angle brackets.
  messageId   String
  labelIds    String[]
  done        Boolean     @default(false)
  /// Workspace the row belongs to (always given by the app; the default fails outside one).
  workspaceId String      @default(dbgenerated("current_setting('ordo.workspace'::text)"))
  workspace   Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@id([accountId, messageId])
  @@index([workspaceId])
}

enum ScheduledMailStatus {
  PENDING
  SENDING
  SENT
  FAILED
}

/// Mail to send later: the message is built when it is scheduled (files included), sent at its time.
model ScheduledMail {
  id          String              @id @default(cuid())
  accountId   String
  account     MailAccount         @relation(fields: [accountId], references: [id], onDelete: Cascade)
  sendAt      DateTime
  subject     String
  to          String[]
  /// Message to send (without the Bcc header) and the copy to keep (sent folder, projects, back to drafts).
  raw         Bytes
  copy        Bytes
  recipients  String[]
  references  String[]
  /// Project the mail was written from.
  projectId   String?
  status      ScheduledMailStatus @default(PENDING)
  error       String?
  sentAt      DateTime?
  createdAt   DateTime            @default(now())
  /// Workspace the row belongs to (always given by the app; the default fails outside one).
  workspaceId String              @default(dbgenerated("current_setting('ordo.workspace'::text)"))
  workspace   Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([status, sendAt])
  @@index([workspaceId])
}

model MailFolderCursor {
  accountId   String
  account     MailAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  folder      String
  uidValidity BigInt
  lastUid     Int
  /// Workspace the row belongs to (always given by the app; the default fails outside one).
  workspaceId String      @default(dbgenerated("current_setting('ordo.workspace'::text)"))
  workspace   Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@id([accountId, folder])
  @@index([workspaceId])
}

/// Calendar of a workspace: every event belongs to one; it can be shown or hidden in the calendar view.
model Calendar {
  id            String                 @id @default(cuid())
  label         String
  /// Image shown as its avatar (none: its initials on its color).
  iconId        String?
  icon          Icon?                  @relation(fields: [iconId], references: [id], onDelete: SetNull)
  color         String
  position      Int                    @default(0)
  /// Archived: hidden by default and read only until restored.
  archivedAt    DateTime?
  createdAt     DateTime               @default(now())
  events        CalendarEvent[]
  /// Other workspaces showing it (read only).
  subscriptions CalendarSubscription[]
  /// Workspace the row belongs to (always given by the app; the default fails outside one).
  workspaceId   String                 @default(dbgenerated("current_setting('ordo.workspace'::text)"))
  workspace     Workspace              @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
}

/// Calendar of another workspace shown, read only, in the calendar view of this one.
model CalendarSubscription {
  id          String    @id @default(cuid())
  calendarId  String
  calendar    Calendar  @relation(fields: [calendarId], references: [id], onDelete: Cascade)
  position    Int       @default(0)
  createdAt   DateTime  @default(now())
  /// Workspace subscribing (the calendar belongs to another one).
  workspaceId String    @default(dbgenerated("current_setting('ordo.workspace'::text)"))
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, calendarId])
  @@index([calendarId])
}

/// Category of calendar events, in a tree.
model CalendarCategory {
  id          String             @id @default(cuid())
  label       String
  /// Image shown as its avatar (none: its initials on its color).
  iconId      String?
  icon        Icon?              @relation(fields: [iconId], references: [id], onDelete: SetNull)
  color       String
  parentId    String?
  parent      CalendarCategory?  @relation("CalendarCategoryTree", fields: [parentId], references: [id], onDelete: Cascade)
  children    CalendarCategory[] @relation("CalendarCategoryTree")
  position    Int                @default(0)
  /// Archived: hidden by default and read only until restored.
  archivedAt  DateTime?
  createdAt   DateTime           @default(now())
  events      CalendarEvent[]
  /// Workspace the row belongs to (always given by the app; the default fails outside one).
  workspaceId String             @default(dbgenerated("current_setting('ordo.workspace'::text)"))
  workspace   Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([parentId])
  @@index([workspaceId])
}

/// Calendar event, possibly recurring. Times are Paris times (no time zone of its own); all-day events have no times.
model CalendarEvent {
  id                   String                   @id @default(cuid())
  label                String
  /// Saved timers launched from it (the whole series).
  savedCountdowns      SavedCountdown[]         @relation("EventSavedCountdowns")
  /// Markdown.
  description          String?
  location             String?
  /// Point of the location, when chosen from the map or a search.
  locationLat          Float?
  locationLon          Float?
  /// [{ url, label }]
  links                Json                     @default("[]")
  allDay               Boolean                  @default(false)
  /// First day (of the first occurrence for a recurring event).
  startDate            DateTime                 @db.Date
  /// HH:MM, null for an all-day event.
  startTime            String?
  /// Last day, included.
  endDate              DateTime                 @db.Date
  endTime              String?
  /// Repetition (see the shared recurrence rule), null for a one-off event.
  recurrence           Json?
  /// Reminders, 10 at most: [{ before: minutes (24 hours at most), at: null }] before the start, or [{ before: null,
  /// at: "HH:MM" }] on the day of the start (Paris time).
  reminders            Json                     @default("[]")
  /// Travel time to the event and back from it, in minutes (timed events).
  travelBefore         Int                      @default(0)
  travelAfter          Int                      @default(0)
  projectId            String?
  project              Project?                 @relation(fields: [projectId], references: [id], onDelete: SetNull)
  calendarId           String
  /// Deleting a calendar deletes its events.
  calendar             Calendar                 @relation(fields: [calendarId], references: [id], onDelete: Cascade)
  contributors         Contributor[]
  /// Relations without contributor taking part (those with one are among the contributors).
  relations            TreasuryRelation[]
  /// « Bénéficiaires »: whom the event is for (« l’anniversaire est pour mon fils »), not those taking part.
  beneficiaries        Contributor[]            @relation("EventBeneficiaries")
  beneficiaryRelations TreasuryRelation[]       @relation("EventBeneficiaryRelations")
  categories           CalendarCategory[]
  exceptions           CalendarEventException[]
  /// Cancelled but kept in the calendar (struck through); can be restored.
  calledOff            Boolean                  @default(false)
  /// Postponement of another event (its occurrence `postponedFromDate` for a recurring one).
  postponedFromId      String?
  postponedFrom        CalendarEvent?           @relation("EventPostponement", fields: [postponedFromId], references: [id], onDelete: SetNull)
  postponedFromDate    DateTime?                @db.Date
  postponements        CalendarEvent[]          @relation("EventPostponement")
  /// Times tracked on the event (its occurrences).
  timeEntryLinks       TimeEntryEvent[]
  /// Tasks the event is about.
  tasks                Task[]                   @relation("CalendarEventTasks")
  /// Routines of a day the event is about (their occurrence of that day is done during it).
  routineLinks         CalendarEventRoutine[]
  /// Documents linked to it (its whole series): of the library, and of its project tree.
  libraryDocuments     LibraryDocument[]        @relation("EventLibraryDocuments")
  projectResources     ProjectResource[]        @relation("EventProjectResources")
  /// Archived: hidden by default and read only until restored.
  archivedAt           DateTime?
  createdAt            DateTime                 @default(now())
  updatedAt            DateTime                 @updatedAt
  /// Comments (markdown).
  comments             Comment[]
  /// Sheets each occurrence gets a checklist of.
  sheetLinks           SheetLink[]
  checklists           Checklist[]
  /// Workspace the row belongs to (always given by the app; the default fails outside one).
  workspaceId          String                   @default(dbgenerated("current_setting('ordo.workspace'::text)"))
  workspace            Workspace                @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([startDate])
  @@index([projectId])
  @@index([calendarId])
  @@index([postponedFromId])
  @@index([workspaceId])
}

/// Occurrence of a routine (its day) an event is about: done during the event, which does not keep its assignees from
/// it. Even for a repeated routine, only that day.
model CalendarEventRoutine {
  id          String        @id @default(cuid())
  eventId     String
  event       CalendarEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  routineId   String
  routine     Routine       @relation(fields: [routineId], references: [id], onDelete: Cascade)
  /// Day of the occurrence of the routine.
  date        DateTime      @db.Date
  /// Workspace the row belongs to (always given by the app; the default fails outside one).
  workspaceId String        @default(dbgenerated("current_setting('ordo.workspace'::text)"))
  workspace   Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([eventId, routineId, date])
  @@index([routineId])
  @@index([workspaceId])
}

/// One occurrence of a recurring event changed or cancelled on its own.
model CalendarEventException {
  id           String        @id @default(cuid())
  eventId      String
  event        CalendarEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  /// Date of the occurrence in the series.
  date         DateTime      @db.Date
  /// Deleted from the series (not shown).
  cancelled    Boolean       @default(false)
  /// Cancelled but kept in the calendar (struck through).
  calledOff    Boolean       @default(false)
  label        String?
  description  String?
  location     String?
  locationLat  Float?
  locationLon  Float?
  links        Json?
  allDay       Boolean?
  startDate    DateTime?     @db.Date
  startTime    String?
  endDate      DateTime?     @db.Date
  endTime      String?
  /// Travel times of the occurrence, in minutes; none: those of the series.
  travelBefore Int?
  travelAfter  Int?
  /// Workspace the row belongs to (always given by the app; the default fails outside one).
  workspaceId  String        @default(dbgenerated("current_setting('ordo.workspace'::text)"))
  workspace    Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([eventId, date])
  @@index([workspaceId])
}

/// Planned working hours: from a date (to another, or open-ended), every n weeks, time slots on weekdays;
/// paused periods (holidays…) have none.
/// Kind of time slots ("Travail", "Garde des enfants", "Sport"…), with its color in the calendar.
model ScheduleType {
  id            String                     @id @default(cuid())
  label         String
  /// Image shown as its avatar (none: its initials on its color).
  iconId        String?
  icon          Icon?                      @relation(fields: [iconId], references: [id], onDelete: SetNull)
  color         String
  /// Its slots in the week and the day: SLOT_BACKGROUND, DAY_BACKGROUND, SLOT_BORDER or NONE.
  dayDisplay    String                     @default("SLOT_BACKGROUND")
  /// A bar at the top of the week and the day on each day with slots.
  dayBar        Boolean                    @default(true)
  /// Its days in the month: BACKGROUND, BORDER or NONE.
  monthDisplay  String                     @default("BACKGROUND")
  /// A kind of éphémérides (holidays, school holidays, birthdays…), not of créneaux: its schedules are éphémérides.
  ephemeris     Boolean                    @default(false)
  /// « Indisponible » in its workspace: nothing is scheduled during its slots (its schedules take it).
  unavailable   Boolean                    @default(false)
  /// Éphémérides only: the kind is a context of the treasury (its éphémérides are its periods).
  budgetContext Boolean                    @default(false)
  /// Budget context only: a context in every workspace of the user, not only in its own.
  sharedContext Boolean                    @default(false)
  position      Int                        @default(0)
  /// Archived: hidden by default and read only until restored.
  archivedAt    DateTime?
  createdAt     DateTime                   @default(now())
  schedules     WorkSchedule[]
  /// Other workspaces showing its schedules.
  subscriptions WorkScheduleSubscription[]
  /// Treasury contexts it is (one per workspace where it is a context).
  contexts      TreasuryContext[]
  /// Workspace the row belongs to (always given by the app; the default fails outside one).
  workspaceId   String                     @default(dbgenerated("current_setting('ordo.workspace'::text)"))
  workspace     Workspace                  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, label])
}

/// Kind of schedules of another workspace (or its schedules without kind) shown, read only, in the calendar of
/// this one: every schedule of that kind, those added later too.
model WorkScheduleSubscription {
  id                String        @id @default(cuid())
  /// Workspace whose schedules of the kind are shown.
  sourceWorkspaceId String
  sourceWorkspace   Workspace     @relation("ScheduleSubscriptionSources", fields: [sourceWorkspaceId], references: [id], onDelete: Cascade)
  /// Kind of its schedules shown; none: its schedules without kind (working hours).
  typeId            String?
  type              ScheduleType? @relation(fields: [typeId], references: [id], onDelete: Cascade)
  /// Color and display in this workspace; none: those of the kind.
  color             String?
  dayDisplay        String?
  dayBar            Boolean?
  monthDisplay      String?
  /// « Indisponible » in this workspace: nothing of it is scheduled during these slots (whatever the source says).
  unavailable       Boolean       @default(false)
  createdAt         DateTime      @default(now())
  /// Workspace subscribing.
  workspaceId       String        @default(dbgenerated("current_setting('ordo.workspace'::text)"))
  workspace         Workspace     @relation("ScheduleSubscriptions", fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, sourceWorkspaceId, typeId])
  @@index([sourceWorkspaceId])
  @@index([typeId])
}

model WorkSchedule {
  id            String        @id @default(cuid())
  label         String
  /// Kind of time it plans ("Travail", "Garde des enfants"…); none: working hours (or, an éphéméride, no kind).
  typeId        String?
  type          ScheduleType? @relation(fields: [typeId], references: [id], onDelete: SetNull)
  /// An éphéméride (holidays, birthday…), not a créneau: that of its kind when it has one. Never in the free time nor
  /// the working hours.
  ephemeris     Boolean       @default(false)
  /// « Indisponible » in its workspace: nothing is scheduled during its slots; that of its kind when it has one.
  unavailable   Boolean       @default(false)
  startDate     DateTime      @db.Date
  endDate       DateTime?     @db.Date
  /// Former format (until cases): every n weeks, counted from the week of `startDate`.
  intervalWeeks Int           @default(1)
  /// Former format: [{ weekday, start, end, allDay }], read to convert a schedule saved before cases.
  slots         Json          @default("[]")
  /// Former format: [{ from, to, label }], pauses become exceptions without cases.
  pauses        Json          @default("[]")
  /// Cases: which days (every day, weekdays every n weeks, every n days, monthly, yearly) and which hours.
  cases         Json          @default("[]")
  /// Periods with cases of their own instead of the general ones (none: a pause), dates included.
  exceptions    Json          @default("[]")
  /// Reminders of an éphéméride, [{ before, at, days }] as those of the events; a créneau has none (kept
  /// without ringing when an éphéméride becomes one).
  reminders     Json          @default("[]")
  /// Archived: hidden by default and read only until restored.
  archivedAt    DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  /// Routines following it.
  routines      Routine[]
  /// Comments (markdown).
  comments      Comment[]
  /// Workspace the row belongs to (always given by the app; the default fails outside one).
  workspaceId   String        @default(dbgenerated("current_setting('ordo.workspace'::text)"))
  workspace     Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
}

/// The user's business, shown on the accounting documents (a single row).
model CompanyProfile {
  id                   String            @id @default(cuid())
  name                 String            @default("")
  contact              String?
  /// Legal form (SASU, EURL, EI, micro-entreprise…).
  legalForm            String?
  /// Share capital, as written ("1 000 €").
  capital              String?
  /// Registration (RCS Paris 123 456 789, RM…).
  registration         String?
  siren                String?
  siret                String?
  activityCode         String?
  vatNumber            String?
  /// Off: "TVA non applicable" (franchise), no VAT on the documents.
  vatApplicable        Boolean           @default(true)
  /// Mention printed when VAT does not apply.
  vatExemptionText     String            @default("TVA non applicable, art. 293 B du CGI")
  address              Json?
  email                String?
  phone                String?
  website              String?
  logoId               String?
  bankName             String?
  accountHolder        String?
  iban                 String?
  bic                  String?
  /// Defaults of new documents.
  paymentTerms         String            @default("À 30 jours")
  paymentDays          Int               @default(30)
  paymentMethods       String            @default("Virement bancaire")
  lateInterest         String            @default("Trois fois le taux d’intérêt légal")
  /// Other mentions printed on every document.
  otherMentions        String            @default("Pas d’escompte pour paiement anticipé.")
  /// Label of the client's internal reference ("Référence dossier", "Bon de commande"…).
  referenceLabel       String            @default("Référence dossier")
  quoteValidityDays    Int               @default(30)
  updatedAt            DateTime          @updatedAt
  /// Workspace the row belongs to (always given by the app; the default fails outside one).
  /// Treasury categories of the payments of invoices (money in) and of the refunds of credit notes (money out):
  /// the budgets their expected and actual movements count in.
  invoiceCategoryId    String?
  invoiceCategory      TreasuryCategory? @relation("InvoiceCategory", fields: [invoiceCategoryId], references: [id], onDelete: SetNull)
  creditNoteCategoryId String?
  creditNoteCategory   TreasuryCategory? @relation("CreditNoteCategory", fields: [creditNoteCategoryId], references: [id], onDelete: SetNull)
  workspaceId          String            @unique @default(dbgenerated("current_setting('ordo.workspace'::text)"))
  workspace            Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

enum AccountingDocumentType {
  QUOTE
  INVOICE
  DEPOSIT_INVOICE
  CREDIT_NOTE
}

/// Next number of a document type for a year (D/F/FA/A + YY + 5 digits).
model DocumentSequence {
  type        AccountingDocumentType
  year        Int
  nextNumber  Int                    @default(1)
  /// Workspace the row belongs to (always given by the app; the default fails outside one).
  workspaceId String                 @default(dbgenerated("current_setting('ordo.workspace'::text)"))
  workspace   Workspace              @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@id([workspaceId, type, year])
}

enum AccountingDocumentStatus {
  /// Editable, without number.
  DRAFT
  /// Numbered and final: it cannot be changed any more (corrected by a credit note).
  FINAL
  /// Model of a recurring invoice, never numbered.
  TEMPLATE
}

enum DiscountType {
  PERCENT
  AMOUNT
}

/// Quote, invoice, deposit invoice or credit note.
model AccountingDocument {
  id                  String                   @id @default(cuid())
  type                AccountingDocumentType
  status              AccountingDocumentStatus @default(DRAFT)
  /// Given when the document becomes final.
  year                Int?
  counter             Int?
  number              String?
  /// Date printed on the document (it may be set in the past or the future).
  issueDate           DateTime                 @db.Date
  /// Payment due date (invoices) or end of validity (quotes).
  dueDate             DateTime?                @db.Date
  /// Date or period of the service or delivery.
  serviceStart        DateTime?                @db.Date
  serviceEnd          DateTime?                @db.Date
  clientId            String
  client              Client                   @relation(fields: [clientId], references: [id], onDelete: Restrict)
  serviceId           String?
  service             ClientService?           @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  contactId           String?
  contact             ClientContact?           @relation(fields: [contactId], references: [id], onDelete: SetNull)
  projectId           String?
  project             Project?                 @relation(fields: [projectId], references: [id], onDelete: SetNull)
  /// Quote an invoice comes from, or invoice a credit note cancels.
  sourceId            String?
  source              AccountingDocument?      @relation("DocumentSource", fields: [sourceId], references: [id], onDelete: Restrict)
  derived             AccountingDocument[]     @relation("DocumentSource")
  /// Imported quote a deposit invoice was made from (when the quote was not made in Ordo).
  importedSourceId    String?
  importedSource      ImportedDocument?        @relation(fields: [importedSourceId], references: [id], onDelete: SetNull)
  /// Seller and buyer as printed, frozen when the document becomes final.
  seller              Json?
  buyer               Json?
  label               String?
  introduction        String?
  referenceLabel      String?
  referenceValue      String?
  conclusion          String?
  paymentTerms        String?
  paymentMethods      String?
  /// Quotes: deposit asked at order, percent of the total or amount.
  depositType         DiscountType?
  depositValue        Decimal?                 @db.Decimal(14, 4)
  lateInterest        String?
  /// Quotes: how the work will be invoiced ("Au mois, en fin de mois", "Tous les 5 du mois"…).
  billingSchedule     String?
  otherMentions       String?
  showBankDetails     Boolean                  @default(true)
  vatApplicable       Boolean                  @default(true)
  vatExemptionText    String?
  globalDiscountType  DiscountType?
  globalDiscountValue Decimal?                 @db.Decimal(14, 4)
  currency            String                   @default("EUR")
  /// Totals, computed on each save.
  totalNet            Decimal                  @default(0) @db.Decimal(14, 2)
  totalVat            Decimal                  @default(0) @db.Decimal(14, 2)
  totalGross          Decimal                  @default(0) @db.Decimal(14, 2)
  finalizedAt         DateTime?
  /// Archived: hidden by default and read only until restored.
  archivedAt          DateTime?
  createdAt           DateTime                 @default(now())
  updatedAt           DateTime                 @updatedAt
  lines               AccountingLine[]
  /// Deposit invoices: lines of the invoices deducting them.
  deductedBy          AccountingLine[]         @relation("DeductedDeposits")
  attachments         Attachment[]             @relation("DocumentAttachments")
  /// Tracking (configurable status, sending, acceptance, payments, reminders); final documents only.
  trackingStatusId    String?
  trackingStatus      DocumentStatus?          @relation(fields: [trackingStatusId], references: [id], onDelete: SetNull)
  /// Last time it was sent to the client (by mail from Ordo, or marked by hand).
  sentAt              DateTime?
  /// How it was sent: MAIL, CHORUS (Chorus Pro), POST, HAND or OTHER; none: not told.
  sentVia             String?
  /// Quotes: date of acceptance, and signed copy.
  acceptedAt          DateTime?                @db.Date
  signedAttachmentId  String?                  @unique
  signedAttachment    Attachment?              @relation("SignedQuote", fields: [signedAttachmentId], references: [id], onDelete: SetNull)
  allocations         TreasuryAllocation[]
  reminders           DocumentReminder[]
  /// Tracked time billed on it.
  timeEntries         TimeEntry[]
  /// Recurring invoice this document is the model of, or was created by.
  recurring           RecurringInvoice?        @relation("RecurringTemplate")
  recurringId         String?
  generatedBy         RecurringInvoice?        @relation("RecurringGenerated", fields: [recurringId], references: [id], onDelete: SetNull)
  /// Comments (markdown).
  comments            Comment[]
  /// Workspace the row belongs to (always given by the app; the default fails outside one).
  workspaceId         String                   @default(dbgenerated("current_setting('ordo.workspace'::text)"))
  workspace           Workspace                @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, number])
  @@index([clientId])
  @@index([projectId])
  @@index([sourceId])
  @@index([type, year])
}

enum AccountingLineKind {
  /// Product or service.
  ITEM
  /// Expense paid on behalf of the client, re-invoiced without VAT or margin.
  DISBURSEMENT
  /// Free text (section title, note).
  TEXT
  /// Amount already invoiced on the same quote, deducted.
  DEDUCTION
}

enum AccountingUnit {
  UNIT
  HOUR
  DAY
  MONTH
  FLAT
  DEPOSIT
}

model AccountingLine {
  id                 String              @id @default(cuid())
  documentId         String
  document           AccountingDocument  @relation(fields: [documentId], references: [id], onDelete: Cascade)
  position           Int
  kind               AccountingLineKind  @default(ITEM)
  label              String
  /// Markdown.
  description        String?
  quantity           Decimal             @default(1) @db.Decimal(14, 3)
  unit               AccountingUnit      @default(UNIT)
  unitPrice          Decimal             @default(0) @db.Decimal(14, 4)
  /// Percent (20, 10, 5.5…).
  vatRate            Decimal             @default(0) @db.Decimal(5, 2)
  discountType       DiscountType?
  discountValue      Decimal?            @db.Decimal(14, 4)
  /// Deductions: deposit invoice whose amount the line takes off.
  deductedDocumentId String?
  deductedDocument   AccountingDocument? @relation("DeductedDeposits", fields: [deductedDocumentId], references: [id], onDelete: SetNull)
  /// Workspace the row belongs to (always given by the app; the default fails outside one).
  workspaceId        String              @default(dbgenerated("current_setting('ordo.workspace'::text)"))
  workspace          Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([documentId])
  @@index([deductedDocumentId])
  @@index([workspaceId])
}

/// Invoice issued on a schedule from a model document.
model RecurringInvoice {
  id           String               @id @default(cuid())
  label        String
  templateId   String               @unique
  template     AccountingDocument   @relation("RecurringTemplate", fields: [templateId], references: [id], onDelete: Cascade)
  /// Repetition (shared recurrence rule), from `startDate`.
  recurrence   Json
  startDate    DateTime             @db.Date
  /// Next issue date, null when the schedule is over.
  nextDate     DateTime?            @db.Date
  /// Final invoices (numbered at once) rather than drafts to check.
  autoFinalize Boolean              @default(false)
  active       Boolean              @default(true)
  /// Archived: hidden by default and read only until restored.
  archivedAt   DateTime?
  createdAt    DateTime             @default(now())
  generated    AccountingDocument[] @relation("RecurringGenerated")
  /// Workspace the row belongs to (always given by the app; the default fails outside one).
  workspaceId  String               @default(dbgenerated("current_setting('ordo.workspace'::text)"))
  workspace    Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
}

/// Product or service of the catalogue: default label, description, unit, price and VAT of a line.
model CatalogItem {
  id          String             @id @default(cuid())
  /// Item or disbursement.
  kind        AccountingLineKind @default(ITEM)
  label       String
  /// Markdown.
  description String?
  unit        AccountingUnit     @default(UNIT)
  unitPrice   Decimal            @default(0) @db.Decimal(14, 4)
  /// Percent (20, 10, 5.5…).
  vatRate     Decimal            @default(20) @db.Decimal(5, 2)
  /// Archived: kept on past documents, not offered any more (hidden by default and read only until restored).
  archivedAt  DateTime?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  /// Comments (markdown).
  comments    Comment[]
  /// Workspace the row belongs to (always given by the app; the default fails outside one).
  workspaceId String             @default(dbgenerated("current_setting('ordo.workspace'::text)"))
  workspace   Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
}

enum ProjectResourceKind {
  FILE
  LINK
}

/// File or link of a project (mock-ups, repository, specifications…).
model ProjectResource {
  id              String              @id @default(cuid())
  projectId       String
  project         Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  kind            ProjectResourceKind
  label           String
  url             String?
  attachmentId    String?             @unique
  attachment      Attachment?         @relation(fields: [attachmentId], references: [id], onDelete: Cascade)
  note            String?
  position        Int                 @default(0)
  createdAt       DateTime            @default(now())
  /// Treasury entries it supports.
  treasuryEntries TreasuryEntry[]     @relation("TreasuryEntryProjectResources")
  treasuryLines   TreasuryEntryLine[] @relation("TreasuryLineProjectResources")
  /// Tasks, routines and events it is linked to.
  tasks           Task[]              @relation("TaskProjectResources")
  routines        Routine[]           @relation("RoutineProjectResources")
  calendarEvents  CalendarEvent[]     @relation("EventProjectResources")
  /// Workspace the row belongs to (always given by the app; the default fails outside one).
  workspaceId     String              @default(dbgenerated("current_setting('ordo.workspace'::text)"))
  workspace       Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([workspaceId])
}

/// Quote or invoice issued before Ordo (or elsewhere): its main information and its PDF, not its lines.
model ImportedDocument {
  id               String                 @id @default(cuid())
  type             AccountingDocumentType
  /// Number as issued.
  number           String
  issueDate        DateTime               @db.Date
  dueDate          DateTime?              @db.Date
  clientId         String?
  client           Client?                @relation(fields: [clientId], references: [id], onDelete: SetNull)
  /// Client name when it is not (or no longer) a client in Ordo.
  clientName       String?
  projectId        String?
  project          Project?               @relation(fields: [projectId], references: [id], onDelete: SetNull)
  label            String?
  totalNet         Decimal                @db.Decimal(14, 4)
  totalVat         Decimal                @default(0) @db.Decimal(14, 4)
  totalGross       Decimal                @db.Decimal(14, 4)
  currency         String                 @default("EUR")
  attachmentId     String?                @unique
  attachment       Attachment?            @relation(fields: [attachmentId], references: [id], onDelete: SetNull)
  note             String?
  /// Paid (or refunded) outside the treasury of Ordo: not expected any more.
  settled          Boolean                @default(true)
  /// When and how it was sent (set by hand), like the documents of Ordo.
  sentAt           DateTime?
  sentVia          String?
  /// Tracking status, set by hand (its payments are not followed by Ordo).
  trackingStatusId String?
  trackingStatus   DocumentStatus?        @relation(fields: [trackingStatusId], references: [id], onDelete: SetNull)
  /// Archived: hidden by default and read only until restored.
  archivedAt       DateTime?
  createdAt        DateTime               @default(now())
  allocations      TreasuryAllocation[]
  /// Deposit invoices made in Ordo from this imported quote.
  derived          AccountingDocument[]
  /// Comments (markdown).
  comments         Comment[]
  /// Workspace the row belongs to (always given by the app; the default fails outside one).
  workspaceId      String                 @default(dbgenerated("current_setting('ordo.workspace'::text)"))
  workspace        Workspace              @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, type, number])
  @@index([clientId])
  @@index([projectId])
}

/// Which documents a tracking status applies to.
enum DocumentStatusScope {
  QUOTE
  /// Invoices, deposit invoices and credit notes.
  INVOICE
}

/// Meaning of a tracking status, whatever its name: it drives the automatic changes.
enum DocumentStatusCategory {
  /// Final, not sent yet.
  TO_SEND
  /// Sent, waiting for an answer or a payment.
  SENT
  ACCEPTED
  REFUSED
  /// Paid (invoices), refunded or deducted (credit notes).
  PAID
  /// Invoices: a credit note is to be made on it (kept, paid or not, until one is final).
  CREDIT_DUE
}

/// Configurable tracking status of the final documents ("Envoyé", "En négociation", "Payée"…).
model DocumentStatus {
  id                String                 @id @default(cuid())
  scope             DocumentStatusScope
  label             String
  /// Image shown as its avatar (none: its initials on its color).
  iconId            String?
  icon              Icon?                  @relation(fields: [iconId], references: [id], onDelete: SetNull)
  /// Hex color, e.g. #228be6.
  color             String
  category          DocumentStatusCategory
  position          Int                    @default(0)
  /// Archived: hidden by default and read only until restored.
  archivedAt        DateTime?
  createdAt         DateTime               @default(now())
  documents         AccountingDocument[]
  /// Imported documents with this status.
  importedDocuments ImportedDocument[]
  /// Workspace the row belongs to (always given by the app; the default fails outside one).
  workspaceId       String                 @default(dbgenerated("current_setting('ordo.workspace'::text)"))
  workspace         Workspace              @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, scope, label])
}

/// Reminder of an unpaid invoice (mail sent from Ordo, call…).
model DocumentReminder {
  id          String             @id @default(cuid())
  documentId  String
  document    AccountingDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  date        DateTime           @default(now())
  /// "Mail", "Téléphone"… with an optional note.
  note        String?
  createdAt   DateTime           @default(now())
  /// Workspace the row belongs to (always given by the app; the default fails outside one).
  workspaceId String             @default(dbgenerated("current_setting('ordo.workspace'::text)"))
  workspace   Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([documentId])
  @@index([workspaceId])
}

/// Bank account (or cash box) of the treasury.
model TreasuryAccount {
  id             String          @id @default(cuid())
  label          String
  /// Image shown as its avatar (none: its initials on its color).
  iconId         String?
  icon           Icon?           @relation(fields: [iconId], references: [id], onDelete: SetNull)
  /// Color of the item (none: gray).
  color          String?
  /// Balance at the opening date (entries before it are not counted).
  openingBalance Decimal         @default(0) @db.Decimal(14, 4)
  openingDate    DateTime        @db.Date
  position       Int             @default(0)
  /// Archived: hidden by default and read only until restored.
  archivedAt     DateTime?
  /// Columns of its bank statements (CSV), as last mapped at an import.
  csvMapping     Json?
  createdAt      DateTime        @default(now())
  entries        TreasuryEntry[]
  /// Workspace the row belongs to (always given by the app; the default fails outside one).
  workspaceId    String          @default(dbgenerated("current_setting('ordo.workspace'::text)"))
  workspace      Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
}

/// How a line of a split entry gives its amount.
enum TreasuryLineMode {
  /// Amount, signed.
  AMOUNT
  /// Percentage of the entry amount, signed.
  PERCENT
}

/// Part of a treasury entry: for a member, in a category and a context. Its amount is signed whatever the
/// direction of the entry (a refund inside a purchase…).
model TreasuryEntryLine {
  id               String              @id @default(cuid())
  entryId          String
  entry            TreasuryEntry       @relation(fields: [entryId], references: [id], onDelete: Cascade)
  position         Int                 @default(0)
  label            String?
  mode             TreasuryLineMode    @default(AMOUNT)
  /// Signed amount (AMOUNT) or percentage of the entry amount (PERCENT).
  value            Decimal             @db.Decimal(14, 4)
  memberId         String?
  member           Contributor?        @relation(fields: [memberId], references: [id], onDelete: SetNull)
  /// Someone out of the team or household it is for (loan, gift…), instead of a member.
  relationId       String?
  relation         TreasuryRelation?   @relation(fields: [relationId], references: [id], onDelete: SetNull)
  /// Loan with the relation: money out is lent (or a debt repaid), money in is borrowed (or a loan repaid back).
  loan             Boolean             @default(false)
  /// Own day of the line (a purchase paid by a deferred debit card): budgets and charts count it on that day.
  date             DateTime?           @db.Date
  categoryId       String?
  category         TreasuryCategory?   @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  contextId        String?
  context          TreasuryContext?    @relation(fields: [contextId], references: [id], onDelete: SetNull)
  projectId        String?
  project          Project?            @relation(fields: [projectId], references: [id], onDelete: SetNull)
  /// Supporting documents: of the library, or of a project.
  libraryDocuments LibraryDocument[]   @relation("TreasuryLineLibraryDocuments")
  projectResources ProjectResource[]   @relation("TreasuryLineProjectResources")
  /// Linked lines of other entries, both ways (a link is stored once, from either side), and whole entries
  /// without lines: linked money in and out of the same period offset each other in the charts.
  links            TreasuryEntryLine[] @relation("TreasuryLineLinks")
  linkedBy         TreasuryEntryLine[] @relation("TreasuryLineLinks")
  linkedEntries    TreasuryEntry[]     @relation("TreasuryLineEntryLinks")
  /// Workspace the row belongs to (always given by the app; the default fails outside one).
  workspaceId      String              @default(dbgenerated("current_setting('ordo.workspace'::text)"))
  workspace        Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([entryId])
  @@index([memberId])
  @@index([relationId])
  @@index([categoryId])
  @@index([contextId])
  @@index([projectId])
  @@index([workspaceId])
}

/// Context of spending ("Vacances", "Rentrée"…), not in a tree: the same purchase does not mean the same in two
/// contexts. A line without context is everyday spending ("Quotidien"). It is a kind of éphémérides "Sert de contexte
/// au budget" (its label, color, image, position and archiving), its éphémérides its periods: one row per workspace
/// where it is a context (its own; every one when shared), which the lines and budgets of that workspace name.
model TreasuryContext {
  id             String              @id @default(cuid())
  scheduleTypeId String
  scheduleType   ScheduleType        @relation(fields: [scheduleTypeId], references: [id], onDelete: Cascade)
  createdAt      DateTime            @default(now())
  lines          TreasuryEntryLine[]
  budgets        TreasuryBudget[]
  /// Workspace the row belongs to (always given by the app; the default fails outside one).
  workspaceId    String              @default(dbgenerated("current_setting('ordo.workspace'::text)"))
  workspace      Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, scheduleTypeId])
  @@index([scheduleTypeId])
}

/// Person out of the team or household (friend, family, partner…) lines and budgets can be for: loan, gift…
/// Not a contributor, not a counterparty (organizations stay counterparties).
model TreasuryRelation {
  id                    String              @id @default(cuid())
  name                  String
  note                  String?
  /// Birth date: YYYY-MM-DD, or --MM-DD when the year is not known. Its birthday is a whole-day éphéméride
  /// derived at read time.
  birthDate             String?
  /// Reminders of its birthday: [{ before: null, at: "HH:MM", days }] (on the day or some days before).
  birthdayReminders     Json                @default("[]")
  /// [{ label, address }]: several email addresses.
  emails                Json                @default("[]")
  /// [{ label, number }]
  phones                Json                @default("[]")
  /// Contributor this person also is (on projects, tasks…), if any.
  contributorId         String?
  contributor           Contributor?        @relation(fields: [contributorId], references: [id], onDelete: SetNull)
  /// Archived: hidden by default and read only until restored.
  archivedAt            DateTime?
  createdAt             DateTime            @default(now())
  lines                 TreasuryEntryLine[]
  budgets               TreasuryBudget[]
  /// Events it takes part in.
  events                CalendarEvent[]
  /// Tasks, routines and events it is a beneficiary of.
  beneficiaryOfTasks    Task[]              @relation("TaskBeneficiaryRelations")
  beneficiaryOfRoutines Routine[]           @relation("RoutineBeneficiaryRelations")
  beneficiaryOfEvents   CalendarEvent[]     @relation("EventBeneficiaryRelations")
  /// Shopping products and items it is for.
  shoppingProducts      ShoppingProduct[]   @relation("ShoppingProductRelations")
  shoppingItems         ShoppingItem[]      @relation("ShoppingItemRelations")
  sheetItems            SheetItem[]         @relation("SheetItemRelations")
  stockItems            StockItem[]         @relation("StockItemRelations")
  /// Comments (markdown).
  comments              Comment[]
  /// Workspace the row belongs to (always given by the app; the default fails outside one).
  workspaceId           String              @default(dbgenerated("current_setting('ordo.workspace'::text)"))
  workspace             Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, name])
  @@unique([workspaceId, contributorId])
}

/// Budget of a month for a member (none: the app user), a context (none: everyday spending) and a category (it
/// covers its sub-categories that have none of their own); possibly repeated every n months.
model TreasuryBudget {
  id          String            @id @default(cuid())
  /// First day of its (first) month.
  month       DateTime          @db.Date
  memberId    String?
  member      Contributor?      @relation(fields: [memberId], references: [id], onDelete: SetNull)
  /// Someone out of the team or household it is for (loan, gift…), instead of a member.
  relationId  String?
  relation    TreasuryRelation? @relation(fields: [relationId], references: [id], onDelete: Cascade)
  contextId   String?
  context     TreasuryContext?  @relation(fields: [contextId], references: [id], onDelete: Cascade)
  categoryId  String
  category    TreasuryCategory  @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  /// Positive: money out (or in) allowed for the category, each month.
  amount      Decimal           @db.Decimal(14, 4)
  /// Repeated every n months (none: that month only), until a month included (none: no end).
  repeatEvery Int?
  repeatUntil DateTime?         @db.Date
  /// Archived: hidden by default and read only until restored.
  archivedAt  DateTime?
  createdAt   DateTime          @default(now())
  /// Comments (markdown).
  comments    Comment[]
  /// Workspace the row belongs to (always given by the app; the default fails outside one).
  workspaceId String            @default(dbgenerated("current_setting('ordo.workspace'::text)"))
  workspace   Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, month])
  @@index([memberId])
  @@index([relationId])
  @@index([contextId])
  @@index([categoryId])
}

enum TreasuryEntryStatus {
  /// On the bank statement.
  ACTUAL
  /// Expected (possibly repeated).
  FORECAST
}

/// Money in or out.
enum TreasuryDirection {
  IN
  OUT
}

/// Category of the treasury entries, for money in or out, possibly under a parent category of the same direction.
model TreasuryCategory {
  id                 String              @id @default(cuid())
  label              String
  /// Image shown as its avatar (none: its initials on its color).
  iconId             String?
  icon               Icon?               @relation(fields: [iconId], references: [id], onDelete: SetNull)
  color              String?
  direction          TreasuryDirection
  parentId           String?
  parent             TreasuryCategory?   @relation("TreasuryCategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children           TreasuryCategory[]  @relation("TreasuryCategoryTree")
  /// Manual order among siblings.
  position           Int                 @default(0)
  /// Archived: hidden by default and read only until restored.
  archivedAt         DateTime?
  createdAt          DateTime            @default(now())
  entries            TreasuryEntry[]
  lines              TreasuryEntryLine[]
  budgets            TreasuryBudget[]
  /// Invoicing settings giving it to the payments of invoices, or to the refunds of credit notes.
  invoiceProfiles    CompanyProfile[]    @relation("InvoiceCategory")
  creditNoteProfiles CompanyProfile[]    @relation("CreditNoteCategory")
  /// Workspace the row belongs to (always given by the app; the default fails outside one).
  workspaceId        String              @default(dbgenerated("current_setting('ordo.workspace'::text)"))
  workspace          Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([parentId])
  @@index([workspaceId])
}

/// Payment method (transfer, card, cheque…), usable for money in, out or both.
model TreasuryPaymentMethod {
  id          String          @id @default(cuid())
  label       String
  /// Image shown as its avatar (none: its initials on its color).
  iconId      String?
  icon        Icon?           @relation(fields: [iconId], references: [id], onDelete: SetNull)
  /// Color of the item (none: gray).
  color       String?
  /// Manual order among its siblings (then by label).
  position    Int             @default(0)
  incoming    Boolean         @default(true)
  outgoing    Boolean         @default(true)
  /// Archived: hidden by default and read only until restored.
  archivedAt  DateTime?
  createdAt   DateTime        @default(now())
  entries     TreasuryEntry[]
  /// Workspace the row belongs to (always given by the app; the default fails outside one).
  workspaceId String          @default(dbgenerated("current_setting('ordo.workspace'::text)"))
  workspace   Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
}

/// Payer or payee of entries that is not a client: supplier, administration, bank…
model TreasuryCounterparty {
  id          String          @id @default(cuid())
  name        String
  /// Image shown as its avatar (none: its initials on its color).
  iconId      String?
  icon        Icon?           @relation(fields: [iconId], references: [id], onDelete: SetNull)
  /// Color of the item (none: gray).
  color       String?
  /// Manual order among its siblings (then by name).
  position    Int             @default(0)
  note        String?
  /// Archived: hidden by default and read only until restored.
  archivedAt  DateTime?
  createdAt   DateTime        @default(now())
  entries     TreasuryEntry[]
  /// Workspace the row belongs to (always given by the app; the default fails outside one).
  workspaceId String          @default(dbgenerated("current_setting('ordo.workspace'::text)"))
  workspace   Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
}

/// Money in (positive) or out (negative) of an account, actual or expected.
model TreasuryEntry {
  id               String                 @id @default(cuid())
  accountId        String
  account          TreasuryAccount        @relation(fields: [accountId], references: [id], onDelete: Restrict)
  status           TreasuryEntryStatus    @default(ACTUAL)
  /// Execution date: the one the balance, the charts and the periods follow.
  date             DateTime               @db.Date
  /// Value date given by the bank, for information; the execution date when not given.
  valueDate        DateTime               @db.Date
  label            String
  /// Signed amount: positive for money in.
  amount           Decimal                @db.Decimal(14, 4)
  categoryId       String?
  category         TreasuryCategory?      @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  methodId         String?
  method           TreasuryPaymentMethod? @relation(fields: [methodId], references: [id], onDelete: SetNull)
  /// Payer or payee: a client, or another counterparty.
  clientId         String?
  client           Client?                @relation(fields: [clientId], references: [id], onDelete: SetNull)
  counterpartyId   String?
  counterparty     TreasuryCounterparty?  @relation(fields: [counterpartyId], references: [id], onDelete: SetNull)
  projectId        String?
  project          Project?               @relation(fields: [projectId], references: [id], onDelete: SetNull)
  note             String?
  /// Page about it on the internet (an online order…).
  url              String?
  /// Forecast only: repetition from `date` (shared recurrence rule); realized dates become exceptions.
  recurrence       Json?
  /// Archived: hidden by default and read only until restored.
  archivedAt       DateTime?
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt
  allocations      TreasuryAllocation[]
  /// Split of the amount (by member, category, context); what the lines leave is "not split".
  lines            TreasuryEntryLine[]
  /// Lines of other entries linked to this whole entry (it has no lines of its own).
  linkedByLines    TreasuryEntryLine[]    @relation("TreasuryLineEntryLinks")
  /// Linked entries, both ways (a link is stored once, from either side): linked money in and out of the same
  /// period offset each other in the charts of money in and out.
  links            TreasuryEntry[]        @relation("TreasuryEntryLinks")
  linkedBy         TreasuryEntry[]        @relation("TreasuryEntryLinks")
  /// Supporting documents: of the library, or of a project.
  libraryDocuments LibraryDocument[]      @relation("TreasuryEntryLibraryDocuments")
  projectResources ProjectResource[]      @relation("TreasuryEntryProjectResources")
  /// Shopping lists it pays (attaching one added its split).
  shoppingLists    ShoppingList[]
  /// Comments (markdown).
  comments         Comment[]
  /// Workspace the row belongs to (always given by the app; the default fails outside one).
  workspaceId      String                 @default(dbgenerated("current_setting('ordo.workspace'::text)"))
  workspace        Workspace              @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([accountId, date])
  @@index([status, date])
  @@index([categoryId])
  @@index([methodId])
  @@index([clientId])
  @@index([counterpartyId])
  @@index([workspaceId])
}

/// Part of an actual entry settling a document: payment of an invoice, refund of a credit note.
model TreasuryAllocation {
  id                 String              @id @default(cuid())
  entryId            String
  entry              TreasuryEntry       @relation(fields: [entryId], references: [id], onDelete: Cascade)
  documentId         String?
  document           AccountingDocument? @relation(fields: [documentId], references: [id], onDelete: Restrict)
  importedDocumentId String?
  importedDocument   ImportedDocument?   @relation(fields: [importedDocumentId], references: [id], onDelete: Cascade)
  /// Positive amount settled on the document.
  amount             Decimal             @db.Decimal(14, 4)
  /// Workspace the row belongs to (always given by the app; the default fails outside one).
  workspaceId        String              @default(dbgenerated("current_setting('ordo.workspace'::text)"))
  workspace          Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([entryId])
  @@index([documentId])
  @@index([importedDocumentId])
  @@index([workspaceId])
}

/// Saved place ("Maison", "Bureau"…): an address and its point, to locate events and compute travel times.
model Place {
  id          String    @id @default(cuid())
  label       String
  /// Image shown as its avatar (none: its initials on its color).
  iconId      String?
  icon        Icon?     @relation(fields: [iconId], references: [id], onDelete: SetNull)
  /// Color of the item (none: gray).
  color       String?
  /// Manual order among its siblings (then by label).
  position    Int       @default(0)
  address     String    @default("")
  /// Its point; none for a zone (a room of the house…): that of the place it is in.
  lat         Float?
  lon         Float?
  /// Place a zone is in (« Maison » for « Cuisine »); none for a place with its own address.
  parentId    String?
  parent      Place?    @relation("PlaceZones", fields: [parentId], references: [id], onDelete: Cascade)
  zones       Place[]   @relation("PlaceZones")
  /// Archived: hidden by default and read only until restored.
  archivedAt  DateTime?
  createdAt   DateTime  @default(now())
  /// Workspace the row belongs to (always given by the app; the default fails outside one).
  workspaceId String    @default(dbgenerated("current_setting('ordo.workspace'::text)"))
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  /// A label is unique among the zones of a place (those at the top are checked by the app: a null parent is never equal).
  @@unique([workspaceId, parentId, label])
}

/// Category of the shopping products, in a tree (as the treasury categories).
model ShoppingCategory {
  id             String             @id @default(cuid())
  label          String
  /// Image shown as its avatar (none: its initials on its color).
  iconId         String?
  icon           Icon?              @relation(fields: [iconId], references: [id], onDelete: SetNull)
  color          String?
  parentId       String?
  parent         ShoppingCategory?  @relation("ShoppingCategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children       ShoppingCategory[] @relation("ShoppingCategoryTree")
  /// Manual order among siblings.
  position       Int                @default(0)
  /// Base lists it is offered in (none: all; a sub-category without any takes those of its parent).
  baseLists      ShoppingBaseList[] @relation("ShoppingCategoryBaseLists")
  /// Archived: hidden by default and read only until restored.
  archivedAt     DateTime?
  createdAt      DateTime           @default(now())
  products       ShoppingProduct[]
  items          ShoppingItem[]
  sheetItems     SheetItem[]
  checklistItems ChecklistItem[]
  stockItems     StockItem[]
  /// Workspace the row belongs to (always given by the app; the default fails outside one).
  workspaceId    String             @default(dbgenerated("current_setting('ordo.workspace'::text)"))
  workspace      Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([parentId])
  @@index([workspaceId])
}

/// Store (or supplier) a product is bought at.
model ShoppingStore {
  id          String            @id @default(cuid())
  label       String
  /// Image shown as its avatar (none: its initials on its color).
  iconId      String?
  icon        Icon?             @relation(fields: [iconId], references: [id], onDelete: SetNull)
  color       String
  position    Int               @default(0)
  /// Archived: hidden by default and read only until restored.
  archivedAt  DateTime?
  createdAt   DateTime          @default(now())
  products    ShoppingProduct[]
  items       ShoppingItem[]
  sheetItems  SheetItem[]
  /// Workspace the row belongs to (always given by the app; the default fails outside one).
  workspaceId String            @default(dbgenerated("current_setting('ordo.workspace'::text)"))
  workspace   Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, label])
  @@index([workspaceId])
}

/// Storage mode of a perishable product (fresh, frozen…).
model ShoppingStorage {
  id          String            @id @default(cuid())
  label       String
  /// Image shown as its avatar (none: its initials on its color).
  iconId      String?
  icon        Icon?             @relation(fields: [iconId], references: [id], onDelete: SetNull)
  color       String
  position    Int               @default(0)
  /// Archived: hidden by default and read only until restored.
  archivedAt  DateTime?
  createdAt   DateTime          @default(now())
  products    ShoppingProduct[]
  items       ShoppingItem[]
  sheetItems  SheetItem[]
  /// Workspace the row belongs to (always given by the app; the default fails outside one).
  workspaceId String            @default(dbgenerated("current_setting('ordo.workspace'::text)"))
  workspace   Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, label])
  @@index([workspaceId])
}

/// Base list ("liste type"): products usually bought together (food, school supplies, children's clothes…).
/// Unit of quantity of the shopping products and items (« kg », « boîte »…), set per workspace; products and items
/// keep their unit as text (renaming a unit renames it there).
model ShoppingUnit {
  id          String    @id @default(cuid())
  label       String
  /// Image shown as its avatar (none: its initials on its color).
  iconId      String?
  icon        Icon?     @relation(fields: [iconId], references: [id], onDelete: SetNull)
  /// Unused (labels have one).
  color       String    @default("gray")
  position    Int       @default(0)
  /// Archived: hidden by default and read only until restored.
  archivedAt  DateTime?
  createdAt   DateTime  @default(now())
  /// Workspace the row belongs to (always given by the app; the default fails outside one).
  workspaceId String    @default(dbgenerated("current_setting('ordo.workspace'::text)"))
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, label])
  @@index([workspaceId])
}

model ShoppingBaseList {
  id          String             @id @default(cuid())
  label       String
  /// Image shown as its avatar (none: its initials on its color).
  iconId      String?
  icon        Icon?              @relation(fields: [iconId], references: [id], onDelete: SetNull)
  /// Color of the item (none: gray).
  color       String?
  position    Int                @default(0)
  /// Archived: hidden by default and read only until restored.
  archivedAt  DateTime?
  createdAt   DateTime           @default(now())
  products    ShoppingProduct[]
  categories  ShoppingCategory[] @relation("ShoppingCategoryBaseLists")
  /// Workspace the row belongs to (always given by the app; the default fails outside one).
  workspaceId String             @default(dbgenerated("current_setting('ordo.workspace'::text)"))
  workspace   Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
}

/// Product of a base list: what is usually bought, marked when missing.
model ShoppingProduct {
  id              String             @id @default(cuid())
  baseListId      String
  baseList        ShoppingBaseList   @relation(fields: [baseListId], references: [id], onDelete: Cascade)
  label           String
  categoryId      String?
  category        ShoppingCategory?  @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  storeId         String?
  store           ShoppingStore?     @relation(fields: [storeId], references: [id], onDelete: SetNull)
  /// Page of the product on the internet.
  url             String?
  note            String?
  /// Quantity usually bought, in its unit (2 kg, 3 boîtes…).
  quantity        Decimal?           @db.Decimal(12, 3)
  unit            String?
  /// Estimated price of one unit.
  unitPrice       Decimal?           @db.Decimal(14, 4)
  /// Perishable: kept in a storage mode, until a "best before" date.
  perishable      Boolean            @default(false)
  storageId       String?
  storage         ShoppingStorage?   @relation(fields: [storageId], references: [id], onDelete: SetNull)
  /// Expiry of the last purchase (the latest of its items), for information (the stock keeps the dates of its lots).
  expiresAt       DateTime?          @db.Date
  /// Missing: put on the next generated list.
  missing         Boolean            @default(false)
  /// Last time it was ticked as bought on a list, and its price then.
  lastPurchasedAt DateTime?
  lastPrice       Decimal?           @db.Decimal(14, 4)
  /// Members of the team or household and relations it is for (copied to the items of the lists).
  members         Contributor[]      @relation("ShoppingProductMembers")
  relations       TreasuryRelation[] @relation("ShoppingProductRelations")
  position        Int                @default(0)
  /// Archived: hidden by default and read only until restored.
  archivedAt      DateTime?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  items           ShoppingItem[]
  sheetItems      SheetItem[]
  checklistItems  ChecklistItem[]
  /// Followed in the stock (inventory).
  stockTracked    Boolean            @default(false)
  /// Used up (food…), unlike what lasts (a casserole): taken from the stock when a sheet or a checklist uses it.
  consumable      Boolean            @default(true)
  /// Added to the stock by itself once ticked as bought (else proposed), at its default place.
  autoStock       Boolean            @default(false)
  stockLocationId String?
  stockLocation   StockLocation?     @relation(fields: [stockLocationId], references: [id], onDelete: SetNull)
  stockItems      StockItem[]
  /// Comments (markdown).
  comments        Comment[]
  /// Workspace the row belongs to (always given by the app; the default fails outside one).
  workspaceId     String             @default(dbgenerated("current_setting('ordo.workspace'::text)"))
  workspace       Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([baseListId])
  @@index([categoryId])
  @@index([storeId])
  @@index([storageId])
  @@index([workspaceId])
}

/// Shopping list, possibly attached to a task (closed when the task is).
model ShoppingList {
  id              String             @id @default(cuid())
  label           String
  /// Ordered remotely (delivered, or to pick up): followed by its deliveries.
  remote          Boolean            @default(false)
  /// Where it is delivered (text, and its point when chosen from the address search).
  deliveryAddress String?
  deliveryLat     Float?
  deliveryLon     Float?
  deliveries      ShoppingDelivery[]
  /// Tasks the list is for (a list whose tasks are all closed is closed too).
  tasks           Task[]             @relation("ShoppingListTasks")
  /// Closed by hand.
  closedAt        DateTime?
  /// Treasury entry paying the list.
  entryId         String?
  entry           TreasuryEntry?     @relation(fields: [entryId], references: [id], onDelete: SetNull)
  /// Archived: hidden by default and read only until restored.
  archivedAt      DateTime?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  items           ShoppingItem[]
  /// Comments (markdown).
  comments        Comment[]
  /// Workspace the row belongs to (always given by the app; the default fails outside one).
  workspaceId     String             @default(dbgenerated("current_setting('ordo.workspace'::text)"))
  workspace       Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([entryId])
  @@index([workspaceId])
}

/// Item of a shopping list: a copy of a product of the base list, or an item of this list only.
model ShoppingItem {
  id             String             @id @default(cuid())
  listId         String
  list           ShoppingList       @relation(fields: [listId], references: [id], onDelete: Cascade)
  /// Product of the base list it comes from: ticking the item as bought clears its "missing".
  productId      String?
  product        ShoppingProduct?   @relation(fields: [productId], references: [id], onDelete: SetNull)
  label          String
  categoryId     String?
  category       ShoppingCategory?  @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  storeId        String?
  store          ShoppingStore?     @relation(fields: [storeId], references: [id], onDelete: SetNull)
  url            String?
  note           String?
  quantity       Decimal?           @db.Decimal(12, 3)
  unit           String?
  unitPrice      Decimal?           @db.Decimal(14, 4)
  perishable     Boolean            @default(false)
  storageId      String?
  storage        ShoppingStorage?   @relation(fields: [storageId], references: [id], onDelete: SetNull)
  /// "Best before" date of what was bought (the same product may be on a list several times, with other dates).
  expiresAt      DateTime?          @db.Date
  /// Ticked as bought.
  purchasedAt    DateTime?
  /// Not needed: bought if possible (the list is done without it).
  optional       Boolean            @default(false)
  /// Sheets it comes from, with their share of its quantity: [{ sheetId, label, quantity }] (none: added by hand).
  sheetSources   Json               @default("[]")
  /// Delivery of a remote order it comes with (none: not ordered, or not assigned yet).
  deliveryId     String?
  delivery       ShoppingDelivery?  @relation(fields: [deliveryId], references: [id], onDelete: SetNull)
  stockMovements StockMovement[]
  /// Members of the team or household and relations it is for: the split of a treasury entry paying the list.
  members        Contributor[]      @relation("ShoppingItemMembers")
  relations      TreasuryRelation[] @relation("ShoppingItemRelations")
  comments       Comment[]
  position       Int                @default(0)
  createdAt      DateTime           @default(now())
  /// Workspace the row belongs to (always given by the app; the default fails outside one).
  workspaceId    String             @default(dbgenerated("current_setting('ordo.workspace'::text)"))
  workspace      Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([listId])
  @@index([productId])
  @@index([storageId])
  @@index([workspaceId])
}

/// Place things are kept (Frigo, Congélateur, Cellier, Garage…), in a tree.
model StockLocation {
  id          String            @id @default(cuid())
  label       String
  /// Image shown as its avatar (none: its initials on its color).
  iconId      String?
  icon        Icon?             @relation(fields: [iconId], references: [id], onDelete: SetNull)
  color       String?
  parentId    String?
  parent      StockLocation?    @relation("StockLocationTree", fields: [parentId], references: [id], onDelete: SetNull)
  children    StockLocation[]   @relation("StockLocationTree")
  /// Manual order among siblings.
  position    Int               @default(0)
  /// Archived: hidden by default and read only until restored.
  archivedAt  DateTime?
  createdAt   DateTime          @default(now())
  products    ShoppingProduct[]
  items       StockItem[]
  counts      StockCount[]
  /// Workspace the row belongs to (always given by the app; the default fails outside one).
  workspaceId String            @default(dbgenerated("current_setting('ordo.workspace'::text)"))
  workspace   Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([parentId])
  @@index([workspaceId])
}

/// Item of the stock: a reference followed in stock, or an item of its own; its quantity is that of its lots.
model StockItem {
  id          String             @id @default(cuid())
  productId   String?
  product     ShoppingProduct?   @relation(fields: [productId], references: [id], onDelete: SetNull)
  /// Its own label, or the name of its reference (kept when the reference is deleted).
  label       String
  categoryId  String?
  category    ShoppingCategory?  @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  unit        String?
  locationId  String?
  location    StockLocation?     @relation(fields: [locationId], references: [id], onDelete: SetNull)
  /// Description (markdown).
  note        String?
  /// Kept until a date: lots of their own dates.
  perishable  Boolean            @default(false)
  /// Members of the team or household and relations it is for.
  members     Contributor[]      @relation("StockItemMembers")
  relations   TreasuryRelation[] @relation("StockItemRelations")
  position    Int                @default(0)
  /// Archived: hidden by default and read only until restored.
  archivedAt  DateTime?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  lots        StockLot[]
  movements   StockMovement[]
  /// Comments (markdown).
  comments    Comment[]
  /// Workspace the row belongs to (always given by the app; the default fails outside one).
  workspaceId String             @default(dbgenerated("current_setting('ordo.workspace'::text)"))
  workspace   Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([categoryId])
  @@index([locationId])
  @@index([workspaceId])
}

/// Lot of an item of the stock: a quantity, and its "best before" date (perishable items).
model StockLot {
  id          String          @id @default(cuid())
  itemId      String
  item        StockItem       @relation(fields: [itemId], references: [id], onDelete: Cascade)
  quantity    Decimal         @db.Decimal(12, 3)
  expiresAt   DateTime?       @db.Date
  createdAt   DateTime        @default(now())
  movements   StockMovement[]
  /// Workspace the row belongs to (always given by the app; the default fails outside one).
  workspaceId String          @default(dbgenerated("current_setting('ordo.workspace'::text)"))
  workspace   Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([itemId])
  @@index([workspaceId])
}

/// Why a quantity of the stock changed.
enum StockMovementKind {
  /// Bought (from a shopping list, or by hand).
  PURCHASE
  /// Used up (by hand, a sheet used, a checklist ticked).
  CONSUMPTION
  /// Counted at an inventory.
  COUNT
  /// Thrown away (past its date, broken…).
  LOSS
  /// Corrected by hand.
  CORRECTION
}

/// Change of a quantity of the stock, signed, with where it comes from.
model StockMovement {
  id              String            @id @default(cuid())
  itemId          String
  item            StockItem         @relation(fields: [itemId], references: [id], onDelete: Cascade)
  lotId           String?
  lot             StockLot?         @relation(fields: [lotId], references: [id], onDelete: SetNull)
  kind            StockMovementKind
  /// Signed: positive in, negative out.
  quantity        Decimal           @db.Decimal(12, 3)
  date            DateTime          @default(now())
  note            String?
  shoppingItemId  String?
  shoppingItem    ShoppingItem?     @relation(fields: [shoppingItemId], references: [id], onDelete: SetNull)
  sheetId         String?
  sheet           Sheet?            @relation(fields: [sheetId], references: [id], onDelete: SetNull)
  checklistItemId String?
  checklistItem   ChecklistItem?    @relation(fields: [checklistItemId], references: [id], onDelete: SetNull)
  countId         String?
  count           StockCount?       @relation(fields: [countId], references: [id], onDelete: SetNull)
  /// Workspace the row belongs to (always given by the app; the default fails outside one).
  workspaceId     String            @default(dbgenerated("current_setting('ordo.workspace'::text)"))
  workspace       Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([itemId])
  @@index([lotId])
  @@index([shoppingItemId])
  @@index([sheetId])
  @@index([checklistItemId])
  @@index([countId])
  @@index([workspaceId])
}

/// Inventory: the quantities counted on a day (of a place, or of everything).
model StockCount {
  id          String          @id @default(cuid())
  date        DateTime        @default(now())
  locationId  String?
  location    StockLocation?  @relation(fields: [locationId], references: [id], onDelete: SetNull)
  note        String?
  movements   StockMovement[]
  /// Workspace the row belongs to (always given by the app; the default fails outside one).
  workspaceId String          @default(dbgenerated("current_setting('ordo.workspace'::text)"))
  workspace   Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([locationId])
  @@index([workspaceId])
}

/// Delivery of a remote order: its tracking, where it arrives (to pick up, or delivered), when, received or not.
model ShoppingDelivery {
  id          String         @id @default(cuid())
  listId      String
  list        ShoppingList   @relation(fields: [listId], references: [id], onDelete: Cascade)
  label       String?
  /// Page of the tracking of the parcel.
  trackingUrl String?
  /// To pick up (relay point, click and collect) rather than delivered.
  pickup      Boolean        @default(false)
  /// Expected between these days (to pick up: from and until when).
  windowFrom  DateTime?      @db.Date
  windowTo    DateTime?      @db.Date
  /// Where, when other than the delivery place of the order (the relay point…).
  address     String?
  lat         Float?
  lon         Float?
  receivedAt  DateTime?
  position    Int            @default(0)
  items       ShoppingItem[]
  /// Workspace the row belongs to (always given by the app; the default fails outside one).
  workspaceId String         @default(dbgenerated("current_setting('ordo.workspace'::text)"))
  workspace   Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([listId])
  @@index([workspaceId])
}

/// Sheet: products (of the base lists) and other items used together, a recipe, the content of a suitcase…, added to
/// shopping lists (summed with the other sheets) or made a checklist of for a routine, an event or a task.
/// Category of the sheets (flat, set in the settings): « Recettes », « Valises »…
model SheetCategory {
  id          String    @id @default(cuid())
  label       String
  /// Image shown as its avatar (none: its initials on its color).
  iconId      String?
  icon        Icon?     @relation(fields: [iconId], references: [id], onDelete: SetNull)
  color       String
  position    Int       @default(0)
  /// Archived: hidden by default and read only until restored.
  archivedAt  DateTime?
  createdAt   DateTime  @default(now())
  sheets      Sheet[]   @relation("SheetCategories")
  /// Workspace the row belongs to (always given by the app; the default fails outside one).
  workspaceId String    @default(dbgenerated("current_setting('ordo.workspace'::text)"))
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, label])
  @@index([workspaceId])
}

model Sheet {
  id              String           @id @default(cuid())
  label           String
  note            String?
  /// Project it belongs to (shown in its tab); none: of the workspace.
  projectId       String?
  project         Project?         @relation(fields: [projectId], references: [id], onDelete: SetNull)
  position        Int              @default(0)
  /// Archived: hidden by default and read only until restored.
  archivedAt      DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  items           SheetItem[]
  links           SheetLink[]
  /// Categories it is filed in (flat, set in the settings).
  categories      SheetCategory[]  @relation("SheetCategories")
  /// Saved timers launched from it.
  savedCountdowns SavedCountdown[] @relation("SheetSavedCountdowns")
  stockMovements  StockMovement[]
  /// Workspace the row belongs to (always given by the app; the default fails outside one).
  workspaceId     String           @default(dbgenerated("current_setting('ordo.workspace'::text)"))
  workspace       Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([workspaceId])
}

/// Item of a sheet: a product of a base list (summed by product), or a label of its own (summed by label and unit).
model SheetItem {
  id          String             @id @default(cuid())
  sheetId     String
  sheet       Sheet              @relation(fields: [sheetId], references: [id], onDelete: Cascade)
  productId   String?
  product     ShoppingProduct?   @relation(fields: [productId], references: [id], onDelete: SetNull)
  /// Its own label, or the name of its product when it was chosen (kept when the product is deleted).
  label       String
  /// Category of the shopping products (the item of a shopping list made of it takes it).
  categoryId  String?
  category    ShoppingCategory?  @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  quantity    Decimal?           @db.Decimal(12, 3)
  unit        String?
  /// As the items of the shopping lists: store, link, conservation, whom it is for (the item of a shopping list made of
  /// it takes them).
  storeId     String?
  store       ShoppingStore?     @relation(fields: [storeId], references: [id], onDelete: SetNull)
  url         String?
  perishable  Boolean            @default(false)
  storageId   String?
  storage     ShoppingStorage?   @relation(fields: [storageId], references: [id], onDelete: SetNull)
  members     Contributor[]      @relation("SheetItemMembers")
  relations   TreasuryRelation[] @relation("SheetItemRelations")
  /// Not needed (bought if possible): the item of a shopping list made of it is optional too.
  optional    Boolean            @default(false)
  /// Description (markdown).
  note        String?
  /// Used up when the sheet is used (a recipe), unlike what comes back (a suitcase): taken from the stock.
  consumable  Boolean            @default(true)
  position    Int                @default(0)
  /// Comments (markdown).
  comments    Comment[]
  /// Workspace the row belongs to (always given by the app; the default fails outside one).
  workspaceId String             @default(dbgenerated("current_setting('ordo.workspace'::text)"))
  workspace   Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([sheetId])
  @@index([productId])
  @@index([categoryId])
  @@index([workspaceId])
}

/// Sheet of a routine, an event or a task (one of them), times a multiplier: their checklists are made of it.
model SheetLink {
  id          String         @id @default(cuid())
  sheetId     String
  sheet       Sheet          @relation(fields: [sheetId], references: [id], onDelete: Cascade)
  multiplier  Decimal        @default(1) @db.Decimal(8, 2)
  routineId   String?
  routine     Routine?       @relation(fields: [routineId], references: [id], onDelete: Cascade)
  eventId     String?
  event       CalendarEvent? @relation(fields: [eventId], references: [id], onDelete: Cascade)
  taskId      String?
  task        Task?          @relation(fields: [taskId], references: [id], onDelete: Cascade)
  position    Int            @default(0)
  /// Workspace the row belongs to (always given by the app; the default fails outside one).
  workspaceId String         @default(dbgenerated("current_setting('ordo.workspace'::text)"))
  workspace   Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([sheetId])
  @@index([routineId])
  @@index([eventId])
  @@index([taskId])
  @@index([workspaceId])
}

/// Checklist made of the sheets of a routine or an event (one per occurrence) or of a task, changed and ticked freely.
model Checklist {
  id             String          @id @default(cuid())
  routineId      String?
  routine        Routine?        @relation(fields: [routineId], references: [id], onDelete: Cascade)
  eventId        String?
  event          CalendarEvent?  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  taskId         String?
  task           Task?           @relation(fields: [taskId], references: [id], onDelete: Cascade)
  /// Occurrence of the routine or the event (none for a task).
  occurrenceDate DateTime?       @db.Date
  createdAt      DateTime        @default(now())
  items          ChecklistItem[]
  /// Workspace the row belongs to (always given by the app; the default fails outside one).
  workspaceId    String          @default(dbgenerated("current_setting('ordo.workspace'::text)"))
  workspace      Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([routineId, occurrenceDate])
  @@unique([eventId, occurrenceDate])
  @@index([taskId])
  @@index([workspaceId])
}

/// Item of a checklist: summed from its sheets (or added by hand), ticked when done.
model ChecklistItem {
  id             String            @id @default(cuid())
  listId         String
  list           Checklist         @relation(fields: [listId], references: [id], onDelete: Cascade)
  productId      String?
  product        ShoppingProduct?  @relation(fields: [productId], references: [id], onDelete: SetNull)
  label          String
  categoryId     String?
  category       ShoppingCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  quantity       Decimal?          @db.Decimal(12, 3)
  unit           String?
  /// Description (markdown).
  note           String?
  /// Sheets it comes from, with their share of its quantity: [{ sheetId, label, quantity }].
  sources        Json              @default("[]")
  /// Taken from the stock when ticked (given back when unticked).
  consumable     Boolean           @default(false)
  checkedAt      DateTime?
  stockMovements StockMovement[]
  position       Int               @default(0)
  /// Workspace the row belongs to (always given by the app; the default fails outside one).
  workspaceId    String            @default(dbgenerated("current_setting('ordo.workspace'::text)"))
  workspace      Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([listId])
  @@index([productId])
  @@index([categoryId])
  @@index([workspaceId])
}

/// Category of the routines, in a tree (as the shopping categories).
model RoutineCategory {
  id          String            @id @default(cuid())
  label       String
  /// Image shown as its avatar (none: its initials on its color).
  iconId      String?
  icon        Icon?             @relation(fields: [iconId], references: [id], onDelete: SetNull)
  color       String?
  parentId    String?
  parent      RoutineCategory?  @relation("RoutineCategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children    RoutineCategory[] @relation("RoutineCategoryTree")
  /// Manual order among siblings.
  position    Int               @default(0)
  /// Archived: hidden by default and read only until restored.
  archivedAt  DateTime?
  createdAt   DateTime          @default(now())
  routines    Routine[]         @relation("RoutineCategories")
  /// Workspace the row belongs to (always given by the app; the default fails outside one).
  workspaceId String            @default(dbgenerated("current_setting('ordo.workspace'::text)"))
  workspace   Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([parentId])
  @@index([workspaceId])
}

/// Task repeating on a calendar rule, simply ticked once done for its current occurrence.
model Routine {
  id                   String                 @id @default(cuid())
  label                String
  /// Plain text, several lines.
  description          String?
  /// Categories it is shown in (a sub-routine is shown under its parent).
  categories           RoutineCategory[]      @relation("RoutineCategories")
  /// Priority and type, from the lists of the tasks (shared by both); a deleted one is cleared.
  priorityId           String?
  priority             TaskPriority?          @relation(fields: [priorityId], references: [id], onDelete: SetNull)
  typeId               String?
  type                 TaskType?              @relation(fields: [typeId], references: [id], onDelete: SetNull)
  /// Saved timers launched from it.
  savedCountdowns      SavedCountdown[]       @relation("RoutineSavedCountdowns")
  /// Parent routine (null for a top-level one). Deleting a routine deletes its sub-routines or puts them one level up
  /// (chosen by the API).
  parentId             String?
  parent               Routine?               @relation("RoutineTree", fields: [parentId], references: [id], onDelete: SetNull)
  children             Routine[]              @relation("RoutineTree")
  /// Fields it takes from its parent, live: PROJECT, ASSIGNEES, BENEFICIARIES, SLOT_CONDITION, OPENS_ON,
  /// LOCATION, CATEGORIES, PRIORITY, START_DATE, RECURRENCE, CASES, MOMENTS, MOVES. A field not listed is its own value (emptied
  /// on purpose when it has none); always empty for a top-level routine. Its effective values: `effectiveRoutine`.
  inheritedFields      String[]               @default([])
  /// First occurrence: the rule repeats from it.
  startDate            DateTime               @db.Date
  /// Repetition (the shared recurrence rule of the events and tasks).
  recurrence           Json
  /// Time to spend on it, in minutes.
  estimate             Int?
  /// Time window to do it in ("HH:MM", Paris time), e.g. dropping the children at school between 8:20 and 8:30:
  /// from fromTime (null: from the start of the day) to dueTime at the latest (null: until the end of the day).
  fromTime             String?
  dueTime              String?
  /// Cases (days, as the calendar schedules, and times of the day, each ticked apart) instead of the repetition and
  /// the time window; empty: the repetition.
  cases                Json                   @default("[]")
  /// Exceptions: occurrences postponed or brought forward to another day, [{ from, to }] (YYYY-MM-DD).
  moves                Json                   @default("[]")
  /// Calendar schedule ("créneau") it follows instead of its own times and repetition: it occurs on the days of the
  /// schedule, before its start (START), during it (WHOLE) or after its end (END).
  scheduleId           String?
  schedule             WorkSchedule?          @relation(fields: [scheduleId], references: [id], onDelete: SetNull)
  scheduleAnchor       String?
  /// Former form: calendar schedules it followed (one or another), read into its condition.
  scheduleIds          String[]               @default([])
  /// Former form: calendar schedules it was done out of, read into its condition.
  excludedScheduleIds  String[]               @default([])
  /// Times of the day, following its rule: [{ fromTime, dueTime, optional }]; none: fromTime / dueTime.
  moments              Json                   @default("[]")
  /// On or out of calendar schedules, in groups (and / or), following its rule; none: any time (or, saved before
  /// it, scheduleIds / excludedScheduleIds).
  slotCondition        Json?
  /// Reminders, 10 at most: [{ before: minutes (24 hours at most), at: null }] before the first day of an occurrence
  /// (« Ouverture ») at the start of each time of the day (« dès »), or [{ before: null, at: "HH:MM" }] on that day.
  reminders            Json                   @default("[]")
  /// « Temps morts » [{ label, minutes, ringtone? }], 20 at most: waits a timer is launched for, from an occurrence
  ///.
  deadTimes            Json                   @default("[]")
  /// « Ouverture » of the occurrences of its rule: { mode: DAY, day, month } | { mode: WEEKDAY, position, weekday,
  /// month } | { mode: WEEK, week, weekday } | { mode: BEFORE, days }; null: from their first day.
  opensOn              Json?
  /// Where it is done: free text, and its point when chosen from the map or a search.
  location             String?
  locationLat          Float?
  locationLon          Float?
  /// [{ url, label }], as those of the events.
  links                Json                   @default("[]")
  /// Travel time to the place and back from it, in minutes.
  travelBefore         Int                    @default(0)
  travelAfter          Int                    @default(0)
  /// Project its tracked time goes to, if any.
  projectId            String?
  project              Project?               @relation(fields: [projectId], references: [id], onDelete: SetNull)
  /// Global manual order of every routine (as the tasks: not among siblings).
  position             Int                    @default(0)
  archivedAt           DateTime?
  /// Archived along with its parent routine: restoring the parent restores it.
  archivedByCascade    Boolean                @default(false)
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt
  assignees            Contributor[]          @relation("RoutineAssignees")
  /// « Bénéficiaires »: whom the routine is for (contributors, and relations out of the team or household).
  beneficiaries        Contributor[]          @relation("RoutineBeneficiaries")
  beneficiaryRelations TreasuryRelation[]     @relation("RoutineBeneficiaryRelations")
  /// Events its occurrence of a day is done during.
  eventLinks           CalendarEventRoutine[]
  /// Documents linked to it: of the library, and of its project tree (not inherited by its sub-routines).
  libraryDocuments     LibraryDocument[]      @relation("RoutineLibraryDocuments")
  projectResources     ProjectResource[]      @relation("RoutineProjectResources")
  /// Routines to do before this one ("étendre le linge" requires "laver le linge").
  requires             RoutineDependency[]    @relation("RoutineDependent")
  /// Routines requiring this one.
  requiredBy           RoutineDependency[]    @relation("RoutineRequired")
  /// Symmetric relations (« Relative à »), stored once with routineAId < routineBId.
  relationsA           RoutineRelation[]      @relation("RoutineRelationA")
  relationsB           RoutineRelation[]      @relation("RoutineRelationB")
  /// Occurrences ticked as done.
  checks               RoutineCheck[]
  timeEntries          TimeEntry[]
  /// Comments (markdown).
  comments             Comment[]
  /// Sheets each occurrence gets a checklist of.
  sheetLinks           SheetLink[]
  checklists           Checklist[]
  /// Workspace the row belongs to (always given by the app; the default fails outside one).
  workspaceId          String                 @default(dbgenerated("current_setting('ordo.workspace'::text)"))
  workspace            Workspace              @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([parentId])
  @@index([projectId])
  @@index([scheduleId])
  @@index([workspaceId])
}

/// "routine requires required": the required one comes first on each occurrence.
model RoutineDependency {
  routineId   String
  routine     Routine   @relation("RoutineDependent", fields: [routineId], references: [id], onDelete: Cascade)
  requiredId  String
  required    Routine   @relation("RoutineRequired", fields: [requiredId], references: [id], onDelete: Cascade)
  /// Workspace the row belongs to (always given by the app; the default fails outside one).
  workspaceId String    @default(dbgenerated("current_setting('ordo.workspace'::text)"))
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@id([routineId, requiredId])
  @@index([requiredId])
  @@index([workspaceId])
}

/// "related to", symmetric (« Relative à »).
model RoutineRelation {
  routineAId  String
  routineA    Routine   @relation("RoutineRelationA", fields: [routineAId], references: [id], onDelete: Cascade)
  routineBId  String
  routineB    Routine   @relation("RoutineRelationB", fields: [routineBId], references: [id], onDelete: Cascade)
  /// Workspace the row belongs to (always given by the app; the default fails outside one).
  workspaceId String    @default(dbgenerated("current_setting('ordo.workspace'::text)"))
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@id([routineAId, routineBId])
  @@index([routineBId])
  @@index([workspaceId])
}

/// Occurrence of a routine ticked as done.
model RoutineCheck {
  routineId   String
  routine     Routine   @relation(fields: [routineId], references: [id], onDelete: Cascade)
  /// Date of the occurrence.
  date        DateTime  @db.Date
  /// Time of the day ticked (its index in the case of that day; 0 without cases).
  slot        Int       @default(0)
  doneAt      DateTime  @default(now())
  /// Workspace the row belongs to (always given by the app; the default fails outside one).
  workspaceId String    @default(dbgenerated("current_setting('ordo.workspace'::text)"))
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@id([routineId, date, slot])
  @@index([workspaceId])
  /// The times of the day of a day (« Ma journée »): the ticks done within it.
  @@index([workspaceId, doneAt])
}
