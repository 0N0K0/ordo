generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

generator pothos {
  provider     = "prisma-pothos-types"
  clientOutput = "./prisma"
  output       = "../src/generated/pothos-types.ts"
}

datasource db {
  provider = "postgresql"
}

/// Separate space of the app (professional or personal): every row but the accounts belongs to one.
model Workspace {
  id                        String                     @id @default(cuid())
  name                      String
  kind                      WorkspaceKind              @default(PRO)
  /// Order in the switcher.
  position                  Int                        @default(0)
  /// Notifications this workspace still gives while another one is open.
  notifyElsewhere           NotificationSource[]       @default([])
  createdAt                 DateTime                   @default(now())
  updatedAt                 DateTime                   @updatedAt
  icons                     Icon[]
  clients                   Client[]
  clientServices            ClientService[]
  clientContacts            ClientContact[]
  projects                  Project[]
  projectCategories         ProjectCategory[]
  projectStatuses           ProjectStatus[]
  contributors              Contributor[]
  taskStatuses              TaskStatus[]
  taskPriorities            TaskPriority[]
  taskTypes                 TaskType[]
  taskTags                  TaskTag[]
  tasks                     Task[]
  taskStatusChanges         TaskStatusChange[]
  taskBlocks                TaskBlock[]
  taskRelations             TaskRelation[]
  taskComments              TaskComment[]
  taskViews                 TaskView[]
  milestones                Milestone[]
  sprints                   Sprint[]
  githubConnections         GithubConnection[]
  githubProjectLinks        GithubProjectLink[]
  dashboards                Dashboard[]
  dashboardCharts           DashboardChart[]
  documentFolders           DocumentFolder[]
  libraryDocuments          LibraryDocument[]
  attachments               Attachment[]
  timeEntries               TimeEntry[]
  alarms                    Alarm[]
  mailAccounts              MailAccount[]
  mailMessages              MailMessage[]
  mailLabels                MailLabel[]
  mailSearchs               MailSearch[]
  mailMarks                 MailMark[]
  scheduledMails            ScheduledMail[]
  mailFolderCursors         MailFolderCursor[]
  calendars                 Calendar[]
  calendarSubscriptions     CalendarSubscription[]
  calendarCategories        CalendarCategory[]
  treasuryEntryLines        TreasuryEntryLine[]
  treasuryContexts          TreasuryContext[]
  treasuryContextPeriods    TreasuryContextPeriod[]
  treasuryBudgets           TreasuryBudget[]
  treasuryRelations         TreasuryRelation[]
  scheduleTypes             ScheduleType[]
  workScheduleSubscriptions WorkScheduleSubscription[] @relation("ScheduleSubscriptions")
  /// Subscriptions of other workspaces to its schedules.
  scheduleSubscribers       WorkScheduleSubscription[] @relation("ScheduleSubscriptionSources")
  calendarEvents            CalendarEvent[]
  calendarEventExceptions   CalendarEventException[]
  workSchedules             WorkSchedule[]
  companyProfiles           CompanyProfile[]
  documentSequences         DocumentSequence[]
  accountingDocuments       AccountingDocument[]
  accountingLines           AccountingLine[]
  recurringInvoices         RecurringInvoice[]
  catalogItems              CatalogItem[]
  projectResources          ProjectResource[]
  importedDocuments         ImportedDocument[]
  documentStatuses          DocumentStatus[]
  documentReminders         DocumentReminder[]
  treasuryAccounts          TreasuryAccount[]
  treasuryCategories        TreasuryCategory[]
  treasuryPaymentMethods    TreasuryPaymentMethod[]
  treasuryCounterparties    TreasuryCounterparty[]
  treasuryEntries           TreasuryEntry[]
  treasuryAllocations       TreasuryAllocation[]
}

/// Kind of notification a workspace can give while another one is open.
enum NotificationSource {
  ALARMS
  CALENDAR
  MAILS
}

/// A personal workspace has no invoicing, no clients and no company.
enum WorkspaceKind {
  PRO
  PERSO
}

model User {
  id           String        @id @default(cuid())
  /// Lowercase, unique login name.
  username     String        @unique
  /// Lowercase, unique email address.
  email        String        @unique
  /// New email address awaiting confirmation.
  pendingEmail String?
  passwordHash String
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  sessions     Session[]
  authTokens   AuthToken[]
  /// Contributor profile of the user in each workspace ("Moi"): tasks can be assigned to them like to anyone else.
  contributors Contributor[]
}

model Session {
  id         String   @id @default(cuid())
  /// SHA-256 of the token stored in the session cookie.
  tokenHash  String   @unique
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userAgent  String?
  createdAt  DateTime @default(now())
  lastSeenAt DateTime @default(now())
  expiresAt  DateTime

  @@index([userId])
}

enum AuthTokenType {
  PASSWORD_RESET
  EMAIL_CHANGE
}

/// Single-use token sent by email.
model AuthToken {
  id        String        @id @default(cuid())
  /// SHA-256 of the token sent in the link.
  tokenHash String        @unique
  type      AuthTokenType
  userId    String
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Target address for an EMAIL_CHANGE token.
  email     String?
  expiresAt DateTime
  createdAt DateTime      @default(now())

  @@index([userId, type])
}

/// Uploaded image, stored apart so lists never load the bytes.
model Icon {
  id           String        @id @default(cuid())
  mimeType     String
  data         Bytes
  createdAt    DateTime      @default(now())
  clients      Client[]
  projects     Project[]
  contributors Contributor[]
  /// Workspace the row belongs to (always given by the app; the default fails outside one).
  workspaceId  String        @default(dbgenerated("current_setting('ordo.workspace'::text)"))
  workspace    Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
}

model Client {
  id         String    @id @default(cuid())
  name       String
  iconId     String?
  icon       Icon?     @relation(fields: [iconId], references: [id], onDelete: SetNull)
  /// Hex color, e.g. #228be6.
  color      String?
  /// Manual order among clients.
  position   Int       @default(0)
  favorite   Boolean   @default(false)
  archivedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  projects   Project[]

  /// Professional (company, association…) or individual.
  kind         ClientKind           @default(COMPANY)
  /// Individual: first and last name (the client name stays the displayed one).
  firstName    String?
  lastName     String?
  /// Postal address: { lines, postalCode, city, region, country (ISO 3166-1 alpha-2) }.
  address      Json?
  email        String?
  /// [{ label, number }]
  phones       Json                 @default("[]")
  website      String?
  vatNumber    String?
  siren        String?
  siret        String?
  /// Activity code (NAF in France, NACE in the EU, NOGA in Switzerland…).
  activityCode String?
  services     ClientService[]
  contacts     ClientContact[]
  documents    AccountingDocument[]
  imported     ImportedDocument[]
  treasury     TreasuryEntry[]
  /// Workspace the row belongs to (always given by the app; the default fails outside one).
  workspaceId  String               @default(dbgenerated("current_setting('ordo.workspace'::text)"))
  workspace    Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
}

enum ClientKind {
  COMPANY
  INDIVIDUAL
}

/// Department or branch of a client, with its own address and contacts.
model ClientService {
  id          String               @id @default(cuid())
  clientId    String
  client      Client               @relation(fields: [clientId], references: [id], onDelete: Cascade)
  name        String
  address     Json?
  email       String?
  phones      Json                 @default("[]")
  position    Int                  @default(0)
  createdAt   DateTime             @default(now())
  contacts    ClientContact[]
  documents   AccountingDocument[]
  /// Workspace the row belongs to (always given by the app; the default fails outside one).
  workspaceId String               @default(dbgenerated("current_setting('ordo.workspace'::text)"))
  workspace   Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([clientId])
  @@index([workspaceId])
}

/// Person at a client, possibly in one of its services.
model ClientContact {
  id          String               @id @default(cuid())
  clientId    String
  client      Client               @relation(fields: [clientId], references: [id], onDelete: Cascade)
  serviceId   String?
  service     ClientService?       @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  firstName   String
  lastName    String
  email       String?
  jobTitle    String?
  phones      Json                 @default("[]")
  createdAt   DateTime             @default(now())
  documents   AccountingDocument[]
  /// Workspace the row belongs to (always given by the app; the default fails outside one).
  workspaceId String               @default(dbgenerated("current_setting('ordo.workspace'::text)"))
  workspace   Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([clientId])
  @@index([workspaceId])
}

model Project {
  id                String            @id @default(cuid())
  title             String
  /// Client of the project tree, inherited by sub-projects.
  clientId          String?
  client            Client?           @relation(fields: [clientId], references: [id], onDelete: SetNull)
  /// Parent project (null for a root project). Deleting a project deletes its sub-projects.
  parentId          String?
  parent            Project?          @relation("ProjectTree", fields: [parentId], references: [id], onDelete: Cascade)
  children          Project[]         @relation("ProjectTree")
  iconId            String?
  icon              Icon?             @relation(fields: [iconId], references: [id], onDelete: SetNull)
  description       String?
  statusId          String?
  status            ProjectStatus?    @relation(fields: [statusId], references: [id], onDelete: SetNull)
  startDate         DateTime?         @db.Date
  endDate           DateTime?         @db.Date
  /// Hex color, e.g. #228be6.
  color             String?
  /// Manual order among siblings (same parent, or same client for root projects).
  position          Int               @default(0)
  favorite          Boolean           @default(false)
  archivedAt        DateTime?
  /// Archived along with its client or a parent project: restoring that ancestor restores it.
  archivedByCascade Boolean           @default(false)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  categories        ProjectCategory[]
  tasks             Task[]

  milestones    Milestone[]
  sprints       Sprint[]
  githubLink    GithubProjectLink?
  dashboards    Dashboard[]
  taskViews     TaskView[]
  /// Contributors attached to the project (and, through it, to its sub-projects).
  contributors  Contributor[]        @relation("ProjectContributors")
  timeEntries   TimeEntry[]
  alarms        Alarm[]
  mails         MailMessage[]
  events        CalendarEvent[]
  documents     AccountingDocument[]
  resources     ProjectResource[]
  imported      ImportedDocument[]
  treasury      TreasuryEntry[]
  /// Lines of split treasury entries attached to the project.
  treasuryLines TreasuryEntryLine[]
  /// Workspace the row belongs to (always given by the app; the default fails outside one).
  workspaceId   String               @default(dbgenerated("current_setting('ordo.workspace'::text)"))
  workspace     Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([clientId])
  @@index([parentId])
  @@index([workspaceId])
}

/// Category of projects (other kinds of categories get their own table).
model ProjectCategory {
  id          String    @id @default(cuid())
  name        String
  /// Hex color, e.g. #228be6.
  color       String
  createdAt   DateTime  @default(now())
  projects    Project[]
  /// Workspace the row belongs to (always given by the app; the default fails outside one).
  workspaceId String    @default(dbgenerated("current_setting('ordo.workspace'::text)"))
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, name])
}

/// Configurable project status (e.g. Prospect, In progress, Done).
model ProjectStatus {
  id          String    @id @default(cuid())
  name        String
  /// Hex color, e.g. #228be6.
  color       String
  /// Display order in lists and selects.
  position    Int       @default(0)
  createdAt   DateTime  @default(now())
  projects    Project[]
  /// Workspace the row belongs to (always given by the app; the default fails outside one).
  workspaceId String    @default(dbgenerated("current_setting('ordo.workspace'::text)"))
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, name])
}

/// Person who can be assigned to tasks.
model Contributor {
  id                String              @id @default(cuid())
  name              String
  /// Unique identifier used in @mentions.
  handle            String
  iconId            String?
  icon              Icon?               @relation(fields: [iconId], references: [id], onDelete: SetNull)
  createdAt         DateTime            @default(now())
  tasks             Task[]
  /// Projects the contributor is attached to; sub-projects inherit them.
  projects          Project[]           @relation("ProjectContributors")
  events            CalendarEvent[]
  /// Set when this contributor is the app user ("Moi").
  userId            String?
  user              User?               @relation(fields: [userId], references: [id], onDelete: SetNull)
  /// GitHub login: assignees are synchronized with the GitHub boards through it.
  githubLogin       String?
  /// Member of the team (professional workspace) or household (personal one): treasury entries are split
  /// between members. The app user ("Moi") always is one.
  teamMember        Boolean             @default(false)
  /// Lines of treasury entries that are theirs.
  treasuryLines     TreasuryEntryLine[]
  treasuryBudgets   TreasuryBudget[]
  /// Relation (out of the team or household) this contributor also is.
  treasuryRelations TreasuryRelation[]
  /// Workspace the row belongs to (always given by the app; the default fails outside one).
  workspaceId       String              @default(dbgenerated("current_setting('ordo.workspace'::text)"))
  workspace         Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, handle])
  @@unique([workspaceId, githubLogin])
  @@unique([workspaceId, userId])
}

/// Fixed meaning of a task status, whatever its name: drives "open", "overdue" and progress.
enum TaskStatusCategory {
  TODO
  IN_PROGRESS
  DONE
  CANCELLED
}

model TaskStatus {
  id          String             @id @default(cuid())
  name        String
  /// Hex color, e.g. #228be6.
  color       String
  category    TaskStatusCategory @default(TODO)
  position    Int                @default(0)
  createdAt   DateTime           @default(now())
  tasks       Task[]
  /// Workspace the row belongs to (always given by the app; the default fails outside one).
  workspaceId String             @default(dbgenerated("current_setting('ordo.workspace'::text)"))
  workspace   Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, name])
}

model TaskPriority {
  id          String    @id @default(cuid())
  name        String
  /// Hex color, e.g. #228be6.
  color       String
  position    Int       @default(0)
  createdAt   DateTime  @default(now())
  tasks       Task[]
  /// Workspace the row belongs to (always given by the app; the default fails outside one).
  workspaceId String    @default(dbgenerated("current_setting('ordo.workspace'::text)"))
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, name])
}

model TaskType {
  id          String    @id @default(cuid())
  name        String
  /// Hex color, e.g. #228be6.
  color       String
  position    Int       @default(0)
  createdAt   DateTime  @default(now())
  tasks       Task[]
  /// Workspace the row belongs to (always given by the app; the default fails outside one).
  workspaceId String    @default(dbgenerated("current_setting('ordo.workspace'::text)"))
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, name])
}

/// Tag of tasks (several per task), synchronized with the GitHub labels.
model TaskTag {
  id          String    @id @default(cuid())
  name        String
  /// Hex color, e.g. #228be6.
  color       String
  position    Int       @default(0)
  createdAt   DateTime  @default(now())
  tasks       Task[]    @relation("TaskTags")
  /// Workspace the row belongs to (always given by the app; the default fails outside one).
  workspaceId String    @default(dbgenerated("current_setting('ordo.workspace'::text)"))
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, name])
}

model Task {
  id                String             @id @default(cuid())
  /// Human-readable number (#12) within its project, given by the database (trigger "task_project_number"): the
  /// next of the project on creation, and of the target project on a transfer. Links use the id, never the number.
  number            Int                @default(0)
  title             String
  /// Markdown.
  description       String?
  projectId         String
  project           Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  statusId          String?
  status            TaskStatus?        @relation(fields: [statusId], references: [id], onDelete: SetNull)
  priorityId        String?
  priority          TaskPriority?      @relation(fields: [priorityId], references: [id], onDelete: SetNull)
  typeId            String?
  type              TaskType?          @relation(fields: [typeId], references: [id], onDelete: SetNull)
  milestoneId       String?
  milestone         Milestone?         @relation(fields: [milestoneId], references: [id], onDelete: SetNull)
  /// Item of the GitHub board the task is synchronized with (ProjectV2Item node id).
  githubItemId      String?            @unique
  /// Content of the item: issue or draft issue node id.
  githubContentId   String?
  /// ISSUE or DRAFT_ISSUE.
  githubContentType String?
  githubUrl         String?
  githubNumber      Int?
  /// Synchronized values at the last sync, for the three-way merge.
  githubSnapshot    Json?
  effort            Float?
  startDate         DateTime?          @db.Date
  endDate           DateTime?          @db.Date
  /// Latest acceptable date ("Date max"): an open task past it is overdue.
  deadline          DateTime?          @db.Date
  /// Parent task, possibly in another project of the same tree.
  parentId          String?
  parent            Task?              @relation("TaskTree", fields: [parentId], references: [id], onDelete: SetNull)
  children          Task[]             @relation("TaskTree")
  /// Global manual order.
  position          Int                @default(0)
  /// Closed (done) task: it no longer blocks, is never overdue and counts as done. Independent of the status.
  closedAt          DateTime?
  archivedAt        DateTime?
  /// Archived along with its parent task: restoring the parent restores it.
  archivedByCascade Boolean            @default(false)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  assignees         Contributor[]
  tags              TaskTag[]          @relation("TaskTags")
  /// Sprints of the project tree the task is planned in (it may run over several).
  sprints           Sprint[]           @relation("TaskSprints")
  /// Status changes (recorded by a database trigger).
  statusChanges     TaskStatusChange[]
  /// Tasks this task blocks.
  blocking          TaskBlock[]        @relation("Blocker")
  /// Tasks blocking this task.
  blockedBy         TaskBlock[]        @relation("Blocked")
  /// Symmetric relations, stored once with taskAId < taskBId.
  relationsA        TaskRelation[]     @relation("RelationA")
  relationsB        TaskRelation[]     @relation("RelationB")
  comments          TaskComment[]
  timeEntries       TimeEntry[]
  /// Calendar events about the task.
  calendarEvents    CalendarEvent[]    @relation("CalendarEventTasks")
  alarms            Alarm[]
  /// Repetition of a recurring task (set on the first task of the series).
  recurrence        Json?
  /// First task of the series this task is an occurrence of.
  seriesId          String?
  series            Task?              @relation("TaskSeries", fields: [seriesId], references: [id], onDelete: SetNull)
  occurrences       Task[]             @relation("TaskSeries")
  /// Date of the occurrence in its series (the first task: its own date).
  occurrenceDate    DateTime?          @db.Date
  /// Workspace the row belongs to (always given by the app; the default fails outside one).
  workspaceId       String             @default(dbgenerated("current_setting('ordo.workspace'::text)"))
  workspace         Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([projectId, number])
  @@index([projectId])
  @@index([parentId])
  @@index([milestoneId])
  @@index([deadline])
  @@index([closedAt])
  @@index([seriesId])
  @@index([workspaceId])
}

/// Status (and open / closed state) of a task from a moment: written by a database trigger on each change of
/// the task (and once with its first status), to know its status at the end of a past sprint.
model TaskStatusChange {
  id          String    @id @default(cuid())
  taskId      String
  task        Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)
  /// Status from then (kept even if the status is deleted later).
  statusId    String?
  closed      Boolean
  at          DateTime
  /// Workspace the row belongs to (always given by the app; the default fails outside one).
  workspaceId String    @default(dbgenerated("current_setting('ordo.workspace'::text)"))
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([taskId, at])
  @@index([workspaceId])
}

/// "blocker blocks blocked".
model TaskBlock {
  blockerId   String
  blocker     Task      @relation("Blocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blockedId   String
  blocked     Task      @relation("Blocked", fields: [blockedId], references: [id], onDelete: Cascade)
  /// Workspace the row belongs to (always given by the app; the default fails outside one).
  workspaceId String    @default(dbgenerated("current_setting('ordo.workspace'::text)"))
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@id([blockerId, blockedId])
  @@index([blockedId])
  @@index([workspaceId])
}

/// "related to", symmetric.
model TaskRelation {
  taskAId     String
  taskA       Task      @relation("RelationA", fields: [taskAId], references: [id], onDelete: Cascade)
  taskBId     String
  taskB       Task      @relation("RelationB", fields: [taskBId], references: [id], onDelete: Cascade)
  /// Workspace the row belongs to (always given by the app; the default fails outside one).
  workspaceId String    @default(dbgenerated("current_setting('ordo.workspace'::text)"))
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@id([taskAId, taskBId])
  @@index([taskBId])
  @@index([workspaceId])
}

model TaskComment {
  id              String    @id @default(cuid())
  taskId          String
  task            Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)
  /// Markdown.
  body            String
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  /// Comment of the GitHub issue it is synchronized with.
  githubCommentId String?   @unique
  /// Body at the last sync, for the three-way merge.
  githubBody      String?
  /// Author on GitHub, when someone else than the connected account wrote it there.
  githubAuthor    String?
  /// Workspace the row belongs to (always given by the app; the default fails outside one).
  workspaceId     String    @default(dbgenerated("current_setting('ordo.workspace'::text)"))
  workspace       Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([taskId])
  @@index([workspaceId])
}

/// Saved task table view: filters, sorting, columns and grouping (JSON validated by @ordo/shared).
model TaskView {
  id          String    @id @default(cuid())
  name        String
  config      Json
  /// Project whose task tab shows the view; null for the home page.
  projectId   String?
  project     Project?  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  /// Opened first in its project (or on the home page); at most one per scope.
  isDefault   Boolean   @default(false)
  position    Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  /// Workspace the row belongs to (always given by the app; the default fails outside one).
  workspaceId String    @default(dbgenerated("current_setting('ordo.workspace'::text)"))
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
}

/// Project milestone, usable by the tasks of the project and its sub-projects.
model Milestone {
  id          String    @id @default(cuid())
  projectId   String
  project     Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title       String
  /// Markdown.
  description String?
  dueDate     DateTime? @db.Date
  position    Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  tasks       Task[]
  /// Workspace the row belongs to (always given by the app; the default fails outside one).
  workspaceId String    @default(dbgenerated("current_setting('ordo.workspace'::text)"))
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([workspaceId])
}

/// Sprint of a project: a period the tasks of its project tree are planned in.
model Sprint {
  id                String    @id @default(cuid())
  projectId         String
  project           Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name              String
  /// Markdown.
  goal              String?
  startDate         DateTime  @db.Date
  endDate           DateTime  @db.Date
  /// Iteration of a GitHub board the sprint mirrors.
  githubIterationId String?   @unique
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  tasks             Task[]    @relation("TaskSprints")
  /// Workspace the row belongs to (always given by the app; the default fails outside one).
  workspaceId       String    @default(dbgenerated("current_setting('ordo.workspace'::text)"))
  workspace         Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([workspaceId])
}

/// GitHub access of the app: a personal access token (encrypted), single row.
model GithubConnection {
  id          String    @id @default(cuid())
  token       String
  login       String
  updatedAt   DateTime  @updatedAt
  /// Workspace the row belongs to (always given by the app; the default fails outside one).
  workspaceId String    @unique @default(dbgenerated("current_setting('ordo.workspace'::text)"))
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

/// Project synchronized with a GitHub Projects (v2) board, both ways.
model GithubProjectLink {
  id               String    @id @default(cuid())
  projectId        String    @unique
  project          Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  /// Node id, URL and title of the board.
  githubProjectId  String
  url              String
  title            String
  /// Fields of the board synchronized (null: not synchronized).
  statusFieldId    String?
  priorityFieldId  String?
  iterationFieldId String?
  startFieldId     String?
  endFieldId       String?
  effortFieldId    String?
  /// Option of the board for each Ordo status / priority: { [ordoId]: optionId }.
  statusOptions    Json      @default("{}")
  priorityOptions  Json      @default("{}")
  /// New Ordo tasks become issues of this repository, or draft issues without one.
  repositoryId     String?
  repositoryName   String?
  /// Ordo tasks created before the link are sent too.
  pushExisting     Boolean   @default(false)
  enabled          Boolean   @default(true)
  lastSyncAt       DateTime?
  lastSyncError    String?
  /// Counts of the last sync (created, updated… on each side).
  lastSyncSummary  Json?
  createdAt        DateTime  @default(now())
  /// Workspace the row belongs to (always given by the app; the default fails outside one).
  workspaceId      String    @default(dbgenerated("current_setting('ordo.workspace'::text)"))
  workspace        Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
}

/// Dashboard of charts on the tasks: global (no project) or of a project tree.
model Dashboard {
  id          String           @id @default(cuid())
  projectId   String?
  project     Project?         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name        String
  position    Int              @default(0)
  createdAt   DateTime         @default(now())
  charts      DashboardChart[]
  /// Workspace the row belongs to (always given by the app; the default fails outside one).
  workspaceId String           @default(dbgenerated("current_setting('ordo.workspace'::text)"))
  workspace   Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([workspaceId])
}

/// Chart of a dashboard: type, axes, measure, series and filters (JSON, validated by the shared schema).
model DashboardChart {
  id          String    @id @default(cuid())
  dashboardId String
  dashboard   Dashboard @relation(fields: [dashboardId], references: [id], onDelete: Cascade)
  title       String
  config      Json
  /// Width in the dashboard grid: half or full.
  wide        Boolean   @default(false)
  position    Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  /// Workspace the row belongs to (always given by the app; the default fails outside one).
  workspaceId String    @default(dbgenerated("current_setting('ordo.workspace'::text)"))
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([dashboardId])
  @@index([workspaceId])
}

/// Folder of the document library (folders nest).
model DocumentFolder {
  id          String            @id @default(cuid())
  name        String
  parentId    String?
  parent      DocumentFolder?   @relation("DocumentFolderTree", fields: [parentId], references: [id], onDelete: Cascade)
  children    DocumentFolder[]  @relation("DocumentFolderTree")
  documents   LibraryDocument[]
  createdAt   DateTime          @default(now())
  /// Workspace the row belongs to (always given by the app; the default fails outside one).
  workspaceId String            @default(dbgenerated("current_setting('ordo.workspace'::text)"))
  workspace   Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([parentId])
  @@index([workspaceId])
}

/// Document of the library (Kbis, logo, statutes, certificates…): a file, or a link to a cloud or a site.
model LibraryDocument {
  id              String              @id @default(cuid())
  /// Folder, or null at the root of the library.
  folderId        String?
  folder          DocumentFolder?     @relation(fields: [folderId], references: [id], onDelete: Cascade)
  kind            ProjectResourceKind
  title           String
  url             String?
  attachmentId    String?             @unique
  attachment      Attachment?         @relation(fields: [attachmentId], references: [id], onDelete: Cascade)
  note            String?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  /// Treasury entries it supports.
  treasuryEntries TreasuryEntry[]     @relation("TreasuryEntryLibraryDocuments")
  treasuryLines   TreasuryEntryLine[] @relation("TreasuryLineLibraryDocuments")
  /// Workspace the row belongs to (always given by the app; the default fails outside one).
  workspaceId     String              @default(dbgenerated("current_setting('ordo.workspace'::text)"))
  workspace       Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([folderId])
  @@index([workspaceId])
}

/// File attached to a markdown text (description, comment…) and linked from it.
model Attachment {
  id                   String              @id @default(cuid())
  /// Original file name, used for the download.
  name                 String
  mimeType             String
  size                 Int
  data                 Bytes
  createdAt            DateTime            @default(now())
  /// Set for a file of a mail copied into a project.
  mailMessageId        String?
  mailMessage          MailMessage?        @relation(fields: [mailMessageId], references: [id], onDelete: Cascade)
  /// Content-ID of an inline image of that mail.
  contentId            String?
  /// Set for a file of a project.
  projectResource      ProjectResource?
  /// Set for the file of an imported document.
  importedDocument     ImportedDocument?
  /// Set for a file attached to an accounting document.
  accountingDocumentId String?
  accountingDocument   AccountingDocument? @relation("DocumentAttachments", fields: [accountingDocumentId], references: [id], onDelete: Cascade)
  /// Set for the signed copy of a quote.
  signedQuote          AccountingDocument? @relation("SignedQuote")
  /// Set for a document of the library.
  libraryDocument      LibraryDocument?
  /// Workspace the row belongs to (always given by the app; the default fails outside one).
  workspaceId          String              @default(dbgenerated("current_setting('ordo.workspace'::text)"))
  workspace            Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([mailMessageId])
  @@index([workspaceId])
}

/// Tracked time on a project, optionally spent on tasks (shared equally between them).
model TimeEntry {
  id                     String              @id @default(cuid())
  projectId              String
  project                Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  /// What was done (plain text, several lines).
  description            String?
  startedAt              DateTime
  /// Null while the timer runs (a single entry runs at a time).
  endedAt                DateTime?
  /// Start of the current pause, while paused.
  pausedAt               DateTime?
  /// Paused time before the current pause, in seconds.
  pausedSeconds          Int                 @default(0)
  /// Effective duration in seconds (pauses excluded), set once stopped.
  duration               Int?
  /// Invoice (draft or final) the time is billed on.
  documentId             String?
  document               AccountingDocument? @relation(fields: [documentId], references: [id], onDelete: SetNull)
  /// Calendar event the time was spent on (its occurrence `calendarOccurrenceDate` for a recurring one): the
  /// calendar only shows the part of the time outside the event.
  calendarEventId        String?
  calendarEvent          CalendarEvent?      @relation(fields: [calendarEventId], references: [id], onDelete: SetNull)
  calendarOccurrenceDate DateTime?           @db.Date
  createdAt              DateTime            @default(now())
  updatedAt              DateTime            @updatedAt
  tasks                  Task[]
  /// Workspace the row belongs to (always given by the app; the default fails outside one).
  workspaceId            String              @default(dbgenerated("current_setting('ordo.workspace'::text)"))
  workspace              Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([calendarEventId])
  @@index([startedAt])
  @@index([endedAt])
  @@index([documentId])
  @@index([workspaceId])
}

/// What triggers an alarm.
enum AlarmType {
  /// At the scheduled times.
  REMINDER
  /// At the scheduled times, only when no timer runs.
  NOT_TRACKING
  /// After every `minutes` of tracking on the running timer.
  TRACKING_DURATION
}

enum AlarmFrequency {
  ONCE
  DAILY
  WEEKLY
  MONTHLY
}

/// Alarm rung by the app while it is open. Schedules are in the user's local time.
model Alarm {
  id          String         @id @default(cuid())
  title       String
  note        String?
  type        AlarmType      @default(REMINDER)
  /// First day of the schedule (REMINDER, NOT_TRACKING).
  startDate   DateTime?      @db.Date
  /// Local time of day, HH:MM (REMINDER, NOT_TRACKING).
  time        String?
  frequency   AlarmFrequency @default(ONCE)
  /// Every n days / weeks / months.
  interval    Int            @default(1)
  /// Weekdays of a weekly schedule, 1 (Monday) to 7 (Sunday); empty: the start date's weekday.
  weekdays    Int[]
  /// Last day of the schedule, included.
  endDate     DateTime?      @db.Date
  /// Tracking time between two rings (TRACKING_DURATION).
  minutes     Int?
  projectId   String?
  project     Project?       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  taskId      String?
  task        Task?          @relation(fields: [taskId], references: [id], onDelete: Cascade)
  enabled     Boolean        @default(true)
  /// Last time it rang: occurrences up to then are done.
  lastFiredAt DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  /// Workspace the row belongs to (always given by the app; the default fails outside one).
  workspaceId String         @default(dbgenerated("current_setting('ordo.workspace'::text)"))
  workspace   Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
}

/// Mailbox read over IMAP and sent from over SMTP. Passwords are encrypted (MAIL_ENCRYPTION_KEY).
model MailAccount {
  id           String             @id @default(cuid())
  /// Name shown in the app ("Pro", "Perso"…).
  name         String
  email        String
  /// Sender name.
  displayName  String?
  imapHost     String
  imapPort     Int
  imapSecure   Boolean            @default(true)
  imapUser     String
  imapPassword String
  smtpHost     String
  smtpPort     Int
  smtpSecure   Boolean            @default(true)
  smtpUser     String
  smtpPassword String
  /// Saves sent mails in the Sent folder (off for servers doing it themselves, like Gmail).
  saveSent     Boolean            @default(true)
  /// HTML signature added to new mails.
  signature    String?
  position     Int                @default(0)
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  messages     MailMessage[]
  cursors      MailFolderCursor[]
  marks        MailMark[]
  scheduled    ScheduledMail[]
  /// Workspace the row belongs to (always given by the app; the default fails outside one).
  workspaceId  String             @default(dbgenerated("current_setting('ordo.workspace'::text)"))
  workspace    Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
}

/// Copy of a mail linked to a project (mails are otherwise read live from the server).
model MailMessage {
  id          String       @id @default(cuid())
  projectId   String
  project     Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  accountId   String?
  account     MailAccount? @relation(fields: [accountId], references: [id], onDelete: SetNull)
  /// Message-ID header, without angle brackets.
  messageId   String
  inReplyTo   String?
  references  String[]
  subject     String
  fromName    String?
  fromAddress String
  /// [{ name, address }]
  to          Json
  cc          Json
  date        DateTime
  /// Sanitized HTML body.
  html        String?
  text        String?
  /// Sent from Ordo (rather than received).
  sent        Boolean      @default(false)
  createdAt   DateTime     @default(now())
  attachments Attachment[]
  /// Workspace the row belongs to (always given by the app; the default fails outside one).
  workspaceId String       @default(dbgenerated("current_setting('ordo.workspace'::text)"))
  workspace   Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([projectId, messageId])
  @@index([messageId])
  @@index([workspaceId])
}

/// Last mail checked in a folder, to link the new messages of conversations already linked to a project.
/// Flag of mails, set by the user (name, color): an IMAP keyword on the mails, or a mark in Ordo when the server
/// takes no keywords.
model MailLabel {
  id          String    @id @default(cuid())
  name        String
  color       String
  position    Int       @default(0)
  createdAt   DateTime  @default(now())
  /// Workspace the row belongs to (always given by the app; the default fails outside one).
  workspaceId String    @default(dbgenerated("current_setting('ordo.workspace'::text)"))
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
}

/// Search folder: mails matching criteria across accounts and folders, kept in Ordo (not on the server).
model MailSearch {
  id          String    @id @default(cuid())
  name        String
  /// { accountIds, scope ('inbox' | 'all'), state ('all' | 'todo' | 'done'), labelIds, unread, text }
  criteria    Json
  position    Int       @default(0)
  createdAt   DateTime  @default(now())
  /// Workspace the row belongs to (always given by the app; the default fails outside one).
  workspaceId String    @default(dbgenerated("current_setting('ordo.workspace'::text)"))
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
}

/// Flags and "done" state of a mail kept in Ordo, for servers that take no IMAP keywords.
model MailMark {
  accountId   String
  account     MailAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  /// Message-ID of the mail, without angle brackets.
  messageId   String
  labelIds    String[]
  done        Boolean     @default(false)
  /// Workspace the row belongs to (always given by the app; the default fails outside one).
  workspaceId String      @default(dbgenerated("current_setting('ordo.workspace'::text)"))
  workspace   Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@id([accountId, messageId])
  @@index([workspaceId])
}

enum ScheduledMailStatus {
  PENDING
  SENDING
  SENT
  FAILED
}

/// Mail to send later: the message is built when it is scheduled (files included), sent at its time.
model ScheduledMail {
  id          String              @id @default(cuid())
  accountId   String
  account     MailAccount         @relation(fields: [accountId], references: [id], onDelete: Cascade)
  sendAt      DateTime
  subject     String
  to          String[]
  /// Message to send (without the Bcc header) and the copy to keep (sent folder, projects, back to drafts).
  raw         Bytes
  copy        Bytes
  recipients  String[]
  references  String[]
  /// Project the mail was written from.
  projectId   String?
  status      ScheduledMailStatus @default(PENDING)
  error       String?
  sentAt      DateTime?
  createdAt   DateTime            @default(now())
  /// Workspace the row belongs to (always given by the app; the default fails outside one).
  workspaceId String              @default(dbgenerated("current_setting('ordo.workspace'::text)"))
  workspace   Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([status, sendAt])
  @@index([workspaceId])
}

model MailFolderCursor {
  accountId   String
  account     MailAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  folder      String
  uidValidity BigInt
  lastUid     Int
  /// Workspace the row belongs to (always given by the app; the default fails outside one).
  workspaceId String      @default(dbgenerated("current_setting('ordo.workspace'::text)"))
  workspace   Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@id([accountId, folder])
  @@index([workspaceId])
}

/// Calendar of a workspace: every event belongs to one; it can be shown or hidden in the calendar view.
model Calendar {
  id            String                 @id @default(cuid())
  name          String
  color         String
  position      Int                    @default(0)
  createdAt     DateTime               @default(now())
  events        CalendarEvent[]
  /// Other workspaces showing it (read only).
  subscriptions CalendarSubscription[]
  /// Workspace the row belongs to (always given by the app; the default fails outside one).
  workspaceId   String                 @default(dbgenerated("current_setting('ordo.workspace'::text)"))
  workspace     Workspace              @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
}

/// Calendar of another workspace shown, read only, in the calendar view of this one.
model CalendarSubscription {
  id          String    @id @default(cuid())
  calendarId  String
  calendar    Calendar  @relation(fields: [calendarId], references: [id], onDelete: Cascade)
  position    Int       @default(0)
  createdAt   DateTime  @default(now())
  /// Workspace subscribing (the calendar belongs to another one).
  workspaceId String    @default(dbgenerated("current_setting('ordo.workspace'::text)"))
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, calendarId])
  @@index([calendarId])
}

/// Category of calendar events, in a tree.
model CalendarCategory {
  id          String             @id @default(cuid())
  name        String
  color       String
  parentId    String?
  parent      CalendarCategory?  @relation("CalendarCategoryTree", fields: [parentId], references: [id], onDelete: Cascade)
  children    CalendarCategory[] @relation("CalendarCategoryTree")
  position    Int                @default(0)
  createdAt   DateTime           @default(now())
  events      CalendarEvent[]
  /// Workspace the row belongs to (always given by the app; the default fails outside one).
  workspaceId String             @default(dbgenerated("current_setting('ordo.workspace'::text)"))
  workspace   Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([parentId])
  @@index([workspaceId])
}

/// Calendar event, possibly recurring. Times are local to `timeZone`; all-day events have no times.
model CalendarEvent {
  id                String                   @id @default(cuid())
  title             String
  /// Markdown.
  description       String?
  location          String?
  /// [{ url, label }]
  links             Json                     @default("[]")
  allDay            Boolean                  @default(false)
  /// First day (of the first occurrence for a recurring event).
  startDate         DateTime                 @db.Date
  /// HH:MM, null for an all-day event.
  startTime         String?
  /// Last day, included.
  endDate           DateTime                 @db.Date
  endTime           String?
  /// IANA time zone of the times.
  timeZone          String
  /// Repetition (see the shared recurrence rule), null for a one-off event.
  recurrence        Json?
  /// Reminders, in minutes before the start.
  reminders         Int[]
  projectId         String?
  project           Project?                 @relation(fields: [projectId], references: [id], onDelete: SetNull)
  calendarId        String
  /// Deleting a calendar deletes its events.
  calendar          Calendar                 @relation(fields: [calendarId], references: [id], onDelete: Cascade)
  contributors      Contributor[]
  categories        CalendarCategory[]
  exceptions        CalendarEventException[]
  /// Cancelled but kept in the calendar (struck through); can be restored.
  calledOff         Boolean                  @default(false)
  /// Postponement of another event (its occurrence `postponedFromDate` for a recurring one).
  postponedFromId   String?
  postponedFrom     CalendarEvent?           @relation("EventPostponement", fields: [postponedFromId], references: [id], onDelete: SetNull)
  postponedFromDate DateTime?                @db.Date
  postponements     CalendarEvent[]          @relation("EventPostponement")
  /// Times tracked on the event.
  timeEntries       TimeEntry[]
  /// Tasks the event is about.
  tasks             Task[]                   @relation("CalendarEventTasks")
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt
  /// Workspace the row belongs to (always given by the app; the default fails outside one).
  workspaceId       String                   @default(dbgenerated("current_setting('ordo.workspace'::text)"))
  workspace         Workspace                @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([startDate])
  @@index([projectId])
  @@index([calendarId])
  @@index([postponedFromId])
  @@index([workspaceId])
}

/// One occurrence of a recurring event changed or cancelled on its own.
model CalendarEventException {
  id          String        @id @default(cuid())
  eventId     String
  event       CalendarEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  /// Date of the occurrence in the series.
  date        DateTime      @db.Date
  /// Deleted from the series (not shown).
  cancelled   Boolean       @default(false)
  /// Cancelled but kept in the calendar (struck through).
  calledOff   Boolean       @default(false)
  title       String?
  description String?
  location    String?
  links       Json?
  allDay      Boolean?
  startDate   DateTime?     @db.Date
  startTime   String?
  endDate     DateTime?     @db.Date
  endTime     String?
  /// Workspace the row belongs to (always given by the app; the default fails outside one).
  workspaceId String        @default(dbgenerated("current_setting('ordo.workspace'::text)"))
  workspace   Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([eventId, date])
  @@index([workspaceId])
}

/// Planned working hours: from a date (to another, or open-ended), every n weeks, time slots on weekdays;
/// paused periods (holidays…) have none.
/// Kind of time slots ("Travail", "Garde des enfants", "Sport"…), with its color in the calendar.
model ScheduleType {
  id            String                     @id @default(cuid())
  name          String
  color         String
  position      Int                        @default(0)
  createdAt     DateTime                   @default(now())
  schedules     WorkSchedule[]
  /// Other workspaces showing its schedules.
  subscriptions WorkScheduleSubscription[]
  /// Workspace the row belongs to (always given by the app; the default fails outside one).
  workspaceId   String                     @default(dbgenerated("current_setting('ordo.workspace'::text)"))
  workspace     Workspace                  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, name])
}

/// Kind of schedules of another workspace (or its schedules without kind) shown, read only, in the calendar of
/// this one: every schedule of that kind, those added later too.
model WorkScheduleSubscription {
  id                String        @id @default(cuid())
  /// Workspace whose schedules of the kind are shown.
  sourceWorkspaceId String
  sourceWorkspace   Workspace     @relation("ScheduleSubscriptionSources", fields: [sourceWorkspaceId], references: [id], onDelete: Cascade)
  /// Kind of its schedules shown; none: its schedules without kind (working hours).
  typeId            String?
  type              ScheduleType? @relation(fields: [typeId], references: [id], onDelete: Cascade)
  createdAt         DateTime      @default(now())
  /// Workspace subscribing.
  workspaceId       String        @default(dbgenerated("current_setting('ordo.workspace'::text)"))
  workspace         Workspace     @relation("ScheduleSubscriptions", fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, sourceWorkspaceId, typeId])
  @@index([sourceWorkspaceId])
  @@index([typeId])
}

model WorkSchedule {
  id            String        @id @default(cuid())
  name          String
  /// Kind of time it plans ("Travail", "Garde des enfants"…); none: working hours.
  typeId        String?
  type          ScheduleType? @relation(fields: [typeId], references: [id], onDelete: SetNull)
  startDate     DateTime      @db.Date
  endDate       DateTime?     @db.Date
  /// Every n weeks, counted from the week of `startDate`.
  intervalWeeks Int           @default(1)
  /// [{ weekday: 1 (Monday) to 7, start: "HH:MM", end: "HH:MM" }], local times.
  slots         Json          @default("[]")
  /// [{ from, to, label }], dates included.
  pauses        Json          @default("[]")
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  /// Workspace the row belongs to (always given by the app; the default fails outside one).
  workspaceId   String        @default(dbgenerated("current_setting('ordo.workspace'::text)"))
  workspace     Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
}

/// The user's business, shown on the accounting documents (a single row).
model CompanyProfile {
  id                String    @id @default(cuid())
  name              String    @default("")
  contact           String?
  /// Legal form (SASU, EURL, EI, micro-entreprise…).
  legalForm         String?
  /// Share capital, as written ("1 000 €").
  capital           String?
  /// Registration (RCS Paris 123 456 789, RM…).
  registration      String?
  siren             String?
  siret             String?
  activityCode      String?
  vatNumber         String?
  /// Off: "TVA non applicable" (franchise), no VAT on the documents.
  vatApplicable     Boolean   @default(true)
  /// Mention printed when VAT does not apply.
  vatExemptionText  String    @default("TVA non applicable, art. 293 B du CGI")
  address           Json?
  email             String?
  phone             String?
  website           String?
  logoId            String?
  bankName          String?
  accountHolder     String?
  iban              String?
  bic               String?
  /// Defaults of new documents.
  paymentTerms      String    @default("À 30 jours")
  paymentDays       Int       @default(30)
  paymentMethods    String    @default("Virement bancaire")
  lateInterest      String    @default("Trois fois le taux d’intérêt légal")
  /// Other mentions printed on every document.
  otherMentions     String    @default("Pas d’escompte pour paiement anticipé.")
  /// Label of the client's internal reference ("Référence dossier", "Bon de commande"…).
  referenceLabel    String    @default("Référence dossier")
  quoteValidityDays Int       @default(30)
  updatedAt         DateTime  @updatedAt
  /// Workspace the row belongs to (always given by the app; the default fails outside one).
  workspaceId       String    @unique @default(dbgenerated("current_setting('ordo.workspace'::text)"))
  workspace         Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

enum AccountingDocumentType {
  QUOTE
  INVOICE
  DEPOSIT_INVOICE
  CREDIT_NOTE
}

/// Next number of a document type for a year (D/F/FA/A + YY + 5 digits).
model DocumentSequence {
  type        AccountingDocumentType
  year        Int
  nextNumber  Int                    @default(1)
  /// Workspace the row belongs to (always given by the app; the default fails outside one).
  workspaceId String                 @default(dbgenerated("current_setting('ordo.workspace'::text)"))
  workspace   Workspace              @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@id([workspaceId, type, year])
}

enum AccountingDocumentStatus {
  /// Editable, without number.
  DRAFT
  /// Numbered and final: it cannot be changed any more (corrected by a credit note).
  FINAL
  /// Model of a recurring invoice, never numbered.
  TEMPLATE
}

enum DiscountType {
  PERCENT
  AMOUNT
}

/// Quote, invoice, deposit invoice or credit note.
model AccountingDocument {
  id                  String                   @id @default(cuid())
  type                AccountingDocumentType
  status              AccountingDocumentStatus @default(DRAFT)
  /// Given when the document becomes final.
  year                Int?
  counter             Int?
  number              String?
  /// Date printed on the document (it may be set in the past or the future).
  issueDate           DateTime                 @db.Date
  /// Payment due date (invoices) or end of validity (quotes).
  dueDate             DateTime?                @db.Date
  /// Date or period of the service or delivery.
  serviceStart        DateTime?                @db.Date
  serviceEnd          DateTime?                @db.Date
  clientId            String
  client              Client                   @relation(fields: [clientId], references: [id], onDelete: Restrict)
  serviceId           String?
  service             ClientService?           @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  contactId           String?
  contact             ClientContact?           @relation(fields: [contactId], references: [id], onDelete: SetNull)
  projectId           String?
  project             Project?                 @relation(fields: [projectId], references: [id], onDelete: SetNull)
  /// Quote an invoice comes from, or invoice a credit note cancels.
  sourceId            String?
  source              AccountingDocument?      @relation("DocumentSource", fields: [sourceId], references: [id], onDelete: Restrict)
  derived             AccountingDocument[]     @relation("DocumentSource")
  /// Imported quote a deposit invoice was made from (when the quote was not made in Ordo).
  importedSourceId    String?
  importedSource      ImportedDocument?        @relation(fields: [importedSourceId], references: [id], onDelete: SetNull)
  /// Seller and buyer as printed, frozen when the document becomes final.
  seller              Json?
  buyer               Json?
  title               String?
  introduction        String?
  referenceLabel      String?
  referenceValue      String?
  conclusion          String?
  paymentTerms        String?
  paymentMethods      String?
  /// Quotes: deposit asked at order, percent of the total or amount.
  depositType         DiscountType?
  depositValue        Decimal?                 @db.Decimal(14, 2)
  lateInterest        String?
  /// Quotes: how the work will be invoiced ("Au mois, en fin de mois", "Tous les 5 du mois"…).
  billingSchedule     String?
  otherMentions       String?
  showBankDetails     Boolean                  @default(true)
  vatApplicable       Boolean                  @default(true)
  vatExemptionText    String?
  globalDiscountType  DiscountType?
  globalDiscountValue Decimal?                 @db.Decimal(14, 2)
  currency            String                   @default("EUR")
  /// Totals, computed on each save.
  totalNet            Decimal                  @default(0) @db.Decimal(14, 2)
  totalVat            Decimal                  @default(0) @db.Decimal(14, 2)
  totalGross          Decimal                  @default(0) @db.Decimal(14, 2)
  finalizedAt         DateTime?
  createdAt           DateTime                 @default(now())
  updatedAt           DateTime                 @updatedAt
  lines               AccountingLine[]
  attachments         Attachment[]             @relation("DocumentAttachments")
  /// Tracking (configurable status, sending, acceptance, payments, reminders); final documents only.
  trackingStatusId    String?
  trackingStatus      DocumentStatus?          @relation(fields: [trackingStatusId], references: [id], onDelete: SetNull)
  /// Last time it was sent to the client (by mail from Ordo, or marked by hand).
  sentAt              DateTime?
  /// Quotes: date of acceptance, and signed copy.
  acceptedAt          DateTime?                @db.Date
  signedAttachmentId  String?                  @unique
  signedAttachment    Attachment?              @relation("SignedQuote", fields: [signedAttachmentId], references: [id], onDelete: SetNull)
  allocations         TreasuryAllocation[]
  reminders           DocumentReminder[]
  /// Tracked time billed on it.
  timeEntries         TimeEntry[]
  /// Recurring invoice this document is the model of, or was created by.
  recurring           RecurringInvoice?        @relation("RecurringTemplate")
  recurringId         String?
  generatedBy         RecurringInvoice?        @relation("RecurringGenerated", fields: [recurringId], references: [id], onDelete: SetNull)
  /// Workspace the row belongs to (always given by the app; the default fails outside one).
  workspaceId         String                   @default(dbgenerated("current_setting('ordo.workspace'::text)"))
  workspace           Workspace                @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, number])
  @@index([clientId])
  @@index([projectId])
  @@index([sourceId])
  @@index([type, year])
}

enum AccountingLineKind {
  /// Product or service.
  ITEM
  /// Expense paid on behalf of the client, re-invoiced without VAT or margin.
  DISBURSEMENT
  /// Free text (section title, note).
  TEXT
  /// Amount already invoiced on the same quote, deducted.
  DEDUCTION
}

enum AccountingUnit {
  UNIT
  HOUR
  DAY
  MONTH
  FLAT
  DEPOSIT
}

model AccountingLine {
  id            String             @id @default(cuid())
  documentId    String
  document      AccountingDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  position      Int
  kind          AccountingLineKind @default(ITEM)
  title         String
  /// Markdown.
  description   String?
  quantity      Decimal            @default(1) @db.Decimal(14, 3)
  unit          AccountingUnit     @default(UNIT)
  unitPrice     Decimal            @default(0) @db.Decimal(14, 2)
  /// Percent (20, 10, 5.5…).
  vatRate       Decimal            @default(0) @db.Decimal(5, 2)
  discountType  DiscountType?
  discountValue Decimal?           @db.Decimal(14, 2)
  /// Workspace the row belongs to (always given by the app; the default fails outside one).
  workspaceId   String             @default(dbgenerated("current_setting('ordo.workspace'::text)"))
  workspace     Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([documentId])
  @@index([workspaceId])
}

/// Invoice issued on a schedule from a model document.
model RecurringInvoice {
  id           String               @id @default(cuid())
  name         String
  templateId   String               @unique
  template     AccountingDocument   @relation("RecurringTemplate", fields: [templateId], references: [id], onDelete: Cascade)
  /// Repetition (shared recurrence rule), from `startDate`.
  recurrence   Json
  startDate    DateTime             @db.Date
  /// Next issue date, null when the schedule is over.
  nextDate     DateTime?            @db.Date
  /// Final invoices (numbered at once) rather than drafts to check.
  autoFinalize Boolean              @default(false)
  active       Boolean              @default(true)
  createdAt    DateTime             @default(now())
  generated    AccountingDocument[] @relation("RecurringGenerated")
  /// Workspace the row belongs to (always given by the app; the default fails outside one).
  workspaceId  String               @default(dbgenerated("current_setting('ordo.workspace'::text)"))
  workspace    Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
}

/// Product or service of the catalogue: default title, description, unit, price and VAT of a line.
model CatalogItem {
  id          String             @id @default(cuid())
  /// Item or disbursement.
  kind        AccountingLineKind @default(ITEM)
  title       String
  /// Markdown.
  description String?
  unit        AccountingUnit     @default(UNIT)
  unitPrice   Decimal            @default(0) @db.Decimal(14, 2)
  /// Percent (20, 10, 5.5…).
  vatRate     Decimal            @default(20) @db.Decimal(5, 2)
  /// Archived: kept on past documents, not offered any more.
  archived    Boolean            @default(false)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  /// Workspace the row belongs to (always given by the app; the default fails outside one).
  workspaceId String             @default(dbgenerated("current_setting('ordo.workspace'::text)"))
  workspace   Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
}

enum ProjectResourceKind {
  FILE
  LINK
}

/// File or link of a project (mock-ups, repository, specifications…).
model ProjectResource {
  id              String              @id @default(cuid())
  projectId       String
  project         Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  kind            ProjectResourceKind
  title           String
  url             String?
  attachmentId    String?             @unique
  attachment      Attachment?         @relation(fields: [attachmentId], references: [id], onDelete: Cascade)
  note            String?
  position        Int                 @default(0)
  createdAt       DateTime            @default(now())
  /// Treasury entries it supports.
  treasuryEntries TreasuryEntry[]     @relation("TreasuryEntryProjectResources")
  treasuryLines   TreasuryEntryLine[] @relation("TreasuryLineProjectResources")
  /// Workspace the row belongs to (always given by the app; the default fails outside one).
  workspaceId     String              @default(dbgenerated("current_setting('ordo.workspace'::text)"))
  workspace       Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([workspaceId])
}

/// Quote or invoice issued before Ordo (or elsewhere): its main information and its PDF, not its lines.
model ImportedDocument {
  id           String                 @id @default(cuid())
  type         AccountingDocumentType
  /// Number as issued.
  number       String
  issueDate    DateTime               @db.Date
  dueDate      DateTime?              @db.Date
  clientId     String?
  client       Client?                @relation(fields: [clientId], references: [id], onDelete: SetNull)
  /// Client name when it is not (or no longer) a client in Ordo.
  clientName   String?
  projectId    String?
  project      Project?               @relation(fields: [projectId], references: [id], onDelete: SetNull)
  title        String?
  totalNet     Decimal                @db.Decimal(14, 2)
  totalVat     Decimal                @default(0) @db.Decimal(14, 2)
  totalGross   Decimal                @db.Decimal(14, 2)
  currency     String                 @default("EUR")
  attachmentId String?                @unique
  attachment   Attachment?            @relation(fields: [attachmentId], references: [id], onDelete: SetNull)
  note         String?
  /// Paid (or refunded) outside the treasury of Ordo: not expected any more.
  settled      Boolean                @default(true)
  createdAt    DateTime               @default(now())
  allocations  TreasuryAllocation[]
  /// Deposit invoices made in Ordo from this imported quote.
  derived      AccountingDocument[]
  /// Workspace the row belongs to (always given by the app; the default fails outside one).
  workspaceId  String                 @default(dbgenerated("current_setting('ordo.workspace'::text)"))
  workspace    Workspace              @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, type, number])
  @@index([clientId])
  @@index([projectId])
}

/// Which documents a tracking status applies to.
enum DocumentStatusScope {
  QUOTE
  /// Invoices, deposit invoices and credit notes.
  INVOICE
}

/// Meaning of a tracking status, whatever its name: it drives the automatic changes.
enum DocumentStatusCategory {
  /// Final, not sent yet.
  TO_SEND
  /// Sent, waiting for an answer or a payment.
  SENT
  ACCEPTED
  REFUSED
  /// Paid (invoices), refunded or deducted (credit notes).
  PAID
}

/// Configurable tracking status of the final documents ("Envoyé", "En négociation", "Payée"…).
model DocumentStatus {
  id          String                 @id @default(cuid())
  scope       DocumentStatusScope
  name        String
  /// Hex color, e.g. #228be6.
  color       String
  category    DocumentStatusCategory
  position    Int                    @default(0)
  createdAt   DateTime               @default(now())
  documents   AccountingDocument[]
  /// Workspace the row belongs to (always given by the app; the default fails outside one).
  workspaceId String                 @default(dbgenerated("current_setting('ordo.workspace'::text)"))
  workspace   Workspace              @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, scope, name])
}

/// Reminder of an unpaid invoice (mail sent from Ordo, call…).
model DocumentReminder {
  id          String             @id @default(cuid())
  documentId  String
  document    AccountingDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  date        DateTime           @default(now())
  /// "Mail", "Téléphone"… with an optional note.
  note        String?
  createdAt   DateTime           @default(now())
  /// Workspace the row belongs to (always given by the app; the default fails outside one).
  workspaceId String             @default(dbgenerated("current_setting('ordo.workspace'::text)"))
  workspace   Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([documentId])
  @@index([workspaceId])
}

/// Bank account (or cash box) of the treasury.
model TreasuryAccount {
  id             String          @id @default(cuid())
  name           String
  /// Balance at the opening date (entries before it are not counted).
  openingBalance Decimal         @default(0) @db.Decimal(14, 2)
  openingDate    DateTime        @db.Date
  position       Int             @default(0)
  archived       Boolean         @default(false)
  /// Columns of its bank statements (CSV), as last mapped at an import.
  csvMapping     Json?
  createdAt      DateTime        @default(now())
  entries        TreasuryEntry[]
  /// Workspace the row belongs to (always given by the app; the default fails outside one).
  workspaceId    String          @default(dbgenerated("current_setting('ordo.workspace'::text)"))
  workspace      Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
}

/// How a line of a split entry gives its amount.
enum TreasuryLineMode {
  /// Amount, signed.
  AMOUNT
  /// Percentage of the entry amount, signed.
  PERCENT
}

/// Part of a treasury entry: for a member, in a category and a context. Its amount is signed whatever the
/// direction of the entry (a refund inside a purchase…).
model TreasuryEntryLine {
  id               String              @id @default(cuid())
  entryId          String
  entry            TreasuryEntry       @relation(fields: [entryId], references: [id], onDelete: Cascade)
  position         Int                 @default(0)
  label            String?
  mode             TreasuryLineMode    @default(AMOUNT)
  /// Signed amount (AMOUNT) or percentage of the entry amount (PERCENT).
  value            Decimal             @db.Decimal(14, 4)
  memberId         String?
  member           Contributor?        @relation(fields: [memberId], references: [id], onDelete: SetNull)
  /// Someone out of the team or household it is for (loan, gift…), instead of a member.
  relationId       String?
  relation         TreasuryRelation?   @relation(fields: [relationId], references: [id], onDelete: SetNull)
  /// Loan with the relation: money out is lent (or a debt repaid), money in is borrowed (or a loan repaid back).
  loan             Boolean             @default(false)
  /// Own day of the line (a purchase paid by a deferred debit card): budgets and charts count it on that day.
  date             DateTime?           @db.Date
  categoryId       String?
  category         TreasuryCategory?   @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  contextId        String?
  context          TreasuryContext?    @relation(fields: [contextId], references: [id], onDelete: SetNull)
  projectId        String?
  project          Project?            @relation(fields: [projectId], references: [id], onDelete: SetNull)
  /// Supporting documents: of the library, or of a project.
  libraryDocuments LibraryDocument[]   @relation("TreasuryLineLibraryDocuments")
  projectResources ProjectResource[]   @relation("TreasuryLineProjectResources")
  /// Linked lines of other entries, both ways (a link is stored once, from either side), and whole entries
  /// without lines: linked money in and out of the same period offset each other in the charts.
  links            TreasuryEntryLine[] @relation("TreasuryLineLinks")
  linkedBy         TreasuryEntryLine[] @relation("TreasuryLineLinks")
  linkedEntries    TreasuryEntry[]     @relation("TreasuryLineEntryLinks")
  /// Workspace the row belongs to (always given by the app; the default fails outside one).
  workspaceId      String              @default(dbgenerated("current_setting('ordo.workspace'::text)"))
  workspace        Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([entryId])
  @@index([memberId])
  @@index([relationId])
  @@index([categoryId])
  @@index([contextId])
  @@index([projectId])
  @@index([workspaceId])
}

/// Context of spending ("Vacances", "Rentrée"…), not in a tree: the same purchase does not mean the same in two
/// contexts. A line without context is everyday spending ("Quotidien").
model TreasuryContext {
  id          String                  @id @default(cuid())
  name        String
  color       String
  position    Int                     @default(0)
  createdAt   DateTime                @default(now())
  periods     TreasuryContextPeriod[]
  lines       TreasuryEntryLine[]
  budgets     TreasuryBudget[]
  /// Workspace the row belongs to (always given by the app; the default fails outside one).
  workspaceId String                  @default(dbgenerated("current_setting('ordo.workspace'::text)"))
  workspace   Workspace               @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, name])
}

/// Person out of the team or household (friend, family, partner…) lines and budgets can be for: loan, gift…
/// Not a contributor, not a counterparty (organizations stay counterparties).
model TreasuryRelation {
  id            String              @id @default(cuid())
  name          String
  note          String?
  /// Contributor this person also is (on projects, tasks…), if any.
  contributorId String?
  contributor   Contributor?        @relation(fields: [contributorId], references: [id], onDelete: SetNull)
  createdAt     DateTime            @default(now())
  lines         TreasuryEntryLine[]
  budgets       TreasuryBudget[]
  /// Workspace the row belongs to (always given by the app; the default fails outside one).
  workspaceId   String              @default(dbgenerated("current_setting('ordo.workspace'::text)"))
  workspace     Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, name])
  @@unique([workspaceId, contributorId])
}

/// Budget of a month for a member (none: the app user), a context (none: everyday spending) and a category (it
/// covers its sub-categories that have none of their own); possibly repeated every n months.
model TreasuryBudget {
  id          String            @id @default(cuid())
  /// First day of its (first) month.
  month       DateTime          @db.Date
  memberId    String?
  member      Contributor?      @relation(fields: [memberId], references: [id], onDelete: SetNull)
  /// Someone out of the team or household it is for (loan, gift…), instead of a member.
  relationId  String?
  relation    TreasuryRelation? @relation(fields: [relationId], references: [id], onDelete: Cascade)
  contextId   String?
  context     TreasuryContext?  @relation(fields: [contextId], references: [id], onDelete: Cascade)
  categoryId  String
  category    TreasuryCategory  @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  /// Positive: money out (or in) allowed for the category, each month.
  amount      Decimal           @db.Decimal(14, 2)
  /// Repeated every n months (none: that month only), until a month included (none: no end).
  repeatEvery Int?
  repeatUntil DateTime?         @db.Date
  createdAt   DateTime          @default(now())
  /// Workspace the row belongs to (always given by the app; the default fails outside one).
  workspaceId String            @default(dbgenerated("current_setting('ordo.workspace'::text)"))
  workspace   Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, month])
  @@index([memberId])
  @@index([relationId])
  @@index([contextId])
  @@index([categoryId])
}

/// Period a context is planned for: the lines of the entries dated in it get that context proposed.
model TreasuryContextPeriod {
  id          String          @id @default(cuid())
  contextId   String
  context     TreasuryContext @relation(fields: [contextId], references: [id], onDelete: Cascade)
  /// First and last days, included.
  startDate   DateTime        @db.Date
  endDate     DateTime        @db.Date
  note        String?
  createdAt   DateTime        @default(now())
  /// Workspace the row belongs to (always given by the app; the default fails outside one).
  workspaceId String          @default(dbgenerated("current_setting('ordo.workspace'::text)"))
  workspace   Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([contextId])
  @@index([workspaceId, startDate])
}

enum TreasuryEntryStatus {
  /// On the bank statement.
  ACTUAL
  /// Expected (possibly repeated).
  FORECAST
}

/// Money in or out.
enum TreasuryDirection {
  IN
  OUT
}

/// Category of the treasury entries, for money in or out, possibly under a parent category of the same direction.
model TreasuryCategory {
  id          String              @id @default(cuid())
  name        String
  direction   TreasuryDirection
  parentId    String?
  parent      TreasuryCategory?   @relation("TreasuryCategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children    TreasuryCategory[]  @relation("TreasuryCategoryTree")
  createdAt   DateTime            @default(now())
  entries     TreasuryEntry[]
  lines       TreasuryEntryLine[]
  budgets     TreasuryBudget[]
  /// Workspace the row belongs to (always given by the app; the default fails outside one).
  workspaceId String              @default(dbgenerated("current_setting('ordo.workspace'::text)"))
  workspace   Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([parentId])
  @@index([workspaceId])
}

/// Payment method (transfer, card, cheque…), usable for money in, out or both.
model TreasuryPaymentMethod {
  id          String          @id @default(cuid())
  name        String
  incoming    Boolean         @default(true)
  outgoing    Boolean         @default(true)
  createdAt   DateTime        @default(now())
  entries     TreasuryEntry[]
  /// Workspace the row belongs to (always given by the app; the default fails outside one).
  workspaceId String          @default(dbgenerated("current_setting('ordo.workspace'::text)"))
  workspace   Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
}

/// Payer or payee of entries that is not a client: supplier, administration, bank…
model TreasuryCounterparty {
  id          String          @id @default(cuid())
  name        String
  note        String?
  archived    Boolean         @default(false)
  createdAt   DateTime        @default(now())
  entries     TreasuryEntry[]
  /// Workspace the row belongs to (always given by the app; the default fails outside one).
  workspaceId String          @default(dbgenerated("current_setting('ordo.workspace'::text)"))
  workspace   Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
}

/// Money in (positive) or out (negative) of an account, actual or expected.
model TreasuryEntry {
  id               String                 @id @default(cuid())
  accountId        String
  account          TreasuryAccount        @relation(fields: [accountId], references: [id], onDelete: Restrict)
  status           TreasuryEntryStatus    @default(ACTUAL)
  /// Execution date: the one the balance, the charts and the periods follow.
  date             DateTime               @db.Date
  /// Value date given by the bank, for information; the execution date when not given.
  valueDate        DateTime               @db.Date
  label            String
  /// Signed amount: positive for money in.
  amount           Decimal                @db.Decimal(14, 2)
  categoryId       String?
  category         TreasuryCategory?      @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  methodId         String?
  method           TreasuryPaymentMethod? @relation(fields: [methodId], references: [id], onDelete: SetNull)
  /// Payer or payee: a client, or another counterparty.
  clientId         String?
  client           Client?                @relation(fields: [clientId], references: [id], onDelete: SetNull)
  counterpartyId   String?
  counterparty     TreasuryCounterparty?  @relation(fields: [counterpartyId], references: [id], onDelete: SetNull)
  projectId        String?
  project          Project?               @relation(fields: [projectId], references: [id], onDelete: SetNull)
  note             String?
  /// Forecast only: repetition from `date` (shared recurrence rule); realized dates become exceptions.
  recurrence       Json?
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt
  allocations      TreasuryAllocation[]
  /// Split of the amount (by member, category, context); what the lines leave is "not split".
  lines            TreasuryEntryLine[]
  /// Lines of other entries linked to this whole entry (it has no lines of its own).
  linkedByLines    TreasuryEntryLine[]    @relation("TreasuryLineEntryLinks")
  /// Linked entries, both ways (a link is stored once, from either side): linked money in and out of the same
  /// period offset each other in the charts of money in and out.
  links            TreasuryEntry[]        @relation("TreasuryEntryLinks")
  linkedBy         TreasuryEntry[]        @relation("TreasuryEntryLinks")
  /// Supporting documents: of the library, or of a project.
  libraryDocuments LibraryDocument[]      @relation("TreasuryEntryLibraryDocuments")
  projectResources ProjectResource[]      @relation("TreasuryEntryProjectResources")
  /// Workspace the row belongs to (always given by the app; the default fails outside one).
  workspaceId      String                 @default(dbgenerated("current_setting('ordo.workspace'::text)"))
  workspace        Workspace              @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([accountId, date])
  @@index([status, date])
  @@index([categoryId])
  @@index([methodId])
  @@index([clientId])
  @@index([counterpartyId])
  @@index([workspaceId])
}

/// Part of an actual entry settling a document: payment of an invoice, refund of a credit note.
model TreasuryAllocation {
  id                 String              @id @default(cuid())
  entryId            String
  entry              TreasuryEntry       @relation(fields: [entryId], references: [id], onDelete: Cascade)
  documentId         String?
  document           AccountingDocument? @relation(fields: [documentId], references: [id], onDelete: Restrict)
  importedDocumentId String?
  importedDocument   ImportedDocument?   @relation(fields: [importedDocumentId], references: [id], onDelete: Cascade)
  /// Positive amount settled on the document.
  amount             Decimal             @db.Decimal(14, 2)
  /// Workspace the row belongs to (always given by the app; the default fails outside one).
  workspaceId        String              @default(dbgenerated("current_setting('ordo.workspace'::text)"))
  workspace          Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([entryId])
  @@index([documentId])
  @@index([importedDocumentId])
  @@index([workspaceId])
}
