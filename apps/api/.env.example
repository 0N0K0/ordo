# development on your machine; production (the default) on a server
NODE_ENV="development"

DATABASE_URL="postgresql://ordo:ordo@localhost:5432/ordo"
PORT=3000

# Public URL of the front, used in links sent by email
APP_URL="http://localhost:5173"

# SMTP (dev: Mailpit from docker-compose, UI on http://localhost:8025)
SMTP_HOST="localhost"
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM="Ordo <no-reply@ordo.local>"

# Encrypts the passwords of the mail accounts (openssl rand -base64 32)
MAIL_ENCRYPTION_KEY=""

# Push notifications (lot 17c): VAPID keys made once by `npx web-push generate-vapid-keys`; empty: push off
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
# Contact of the push services (mailto: or https); empty: APP_URL
VAPID_SUBJECT=""
